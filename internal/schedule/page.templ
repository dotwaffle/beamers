package schedule

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/dotwaffle/beamers/internal/frontend"
)

templ Page(snapshot Snapshot) {
	<!doctype html>
	<html lang={ snapshot.Language } data-locale={ snapshot.Locale }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="stylesheet" href="/assets/frontend.css"/>
			<link rel="stylesheet" href="/assets/schedule.css"/>
			if snapshot.EventID > 0 {
				<link rel="stylesheet" href={ frontend.EventThemePath(snapshot.EventID) }/>
			}
			<script src={ frontend.HTMXPath } defer></script>
			<script src={ frontend.SSEPath } defer></script>
			<script src="/assets/schedule.js" defer></script>
			<title>{ snapshot.EventName } Schedule</title>
		</head>
		<body
			data-reduced-effects={ strconv.FormatBool(snapshot.ReducedEffects) }
			hx-ext="sse"
			sse-connect={ snapshot.EventsPath() }
			>
			@ScheduleNavigation(snapshot, snapshot.ViewPath())
			<main
				id="schedule"
				hx-get={ snapshot.ViewPath() }
				hx-trigger="sse:schedule"
				hx-target="this"
				hx-select="#schedule"
				hx-swap="outerHTML"
				hx-headers={ `{"Cache-Control":"no-cache"}` }
			>
				if snapshot.MySchedule {
					<h1 id="schedule-heading" tabindex="-1">My Schedule</h1>
				} else {
					<h1 id="schedule-heading" tabindex="-1">{ snapshot.EventName } Schedule</h1>
				}
				<p>Event timezone: { snapshot.Timezone }</p>
				if snapshot.ViewerLocal {
					<p>Attendee-local conversion: { snapshot.ViewerTimezone }. Program days remain grouped in Event time.</p>
				}
				<form method="get" action={ snapshot.ViewPath() }>
					<label>
						Program day
						<select id="schedule-day" name="day">
							<option value="">All days</option>
							for _, day := range snapshot.DayOptions {
								if day == snapshot.Filter.Day {
									<option value={ day } selected>{ day }</option>
								} else {
									<option value={ day }>{ day }</option>
								}
							}
						</select>
					</label>
					@StructuralFilter("Location", "location", snapshot.Locations)
					@StructuralFilter("Lane", "lane", snapshot.Lanes)
					@StructuralFilter("Track", "track", snapshot.Tracks)
					<label>
						Attendee timezone
						<input id="schedule-time-zone" name="time_zone" value={ snapshot.Filter.ViewerTimezone } placeholder="America/New_York"/>
					</label>
					<button id="schedule-apply" type="submit">Apply filters</button>
				</form>
				for _, day := range snapshot.Days {
					<section>
						<h2>Program day { day.Date }</h2>
						for _, session := range day.Sessions {
							if session.CalendarDateRollover {
								<p class="calendar-date-rollover">Local calendar date: { session.LocalDate }</p>
							}
							<article id={ fmt.Sprintf("schedule-session-card-%d", session.ID) }>
								<h3><a id={ fmt.Sprintf("schedule-session-%d", session.ID) } href={ session.PathWithTimezone(snapshot.ViewerTimezone) }>{ session.Title }</a></h3>
								@SessionDetails(session)
								@FavoriteControl(snapshot, session, snapshot.ViewPath())
							</article>
						}
					</section>
				}
				if snapshot.MySchedule && len(snapshot.Sessions) == 0 {
					<p>No Favorite Sessions yet.</p>
				}
				<p id="schedule-status" role="status" aria-live="polite" aria-atomic="true">Schedule updated.</p>
			</main>
		</body>
	</html>
}

templ SessionPage(snapshot Snapshot, session Session, presentationPath string) {
	<!doctype html>
	<html lang={ snapshot.Language } data-locale={ snapshot.Locale }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="stylesheet" href="/assets/frontend.css"/>
			<link rel="stylesheet" href="/assets/schedule.css"/>
			if snapshot.EventID > 0 {
				<link rel="stylesheet" href={ frontend.EventThemePath(snapshot.EventID) }/>
			}
			<script src={ frontend.HTMXPath } defer></script>
			<title>{ session.Title } · { snapshot.EventName } Schedule</title>
		</head>
		<body data-reduced-effects={ strconv.FormatBool(snapshot.ReducedEffects) }>
			@ScheduleNavigation(snapshot, session.PathWithTimezone(snapshot.ViewerTimezone))
			<main>
				<a href={ snapshot.SchedulePath() }>Schedule</a>
				<h1>{ session.Title }</h1>
				@SessionDetails(session)
				@SessionAttachments(session)
				if presentationPath != "" {
					<section aria-labelledby="presentation-participation">
						<h2 id="presentation-participation">Participation</h2>
						<p><a href={ templ.SafeURL(presentationPath + "-manage") }>Manage Presentation</a></p>
						<p><a href={ templ.SafeURL(presentationPath + "-upload") }>Upload Presentation File</a></p>
					</section>
				} else if snapshot.AccountName != "" && session.Type == "Presentation" {
					<section aria-labelledby="presentation-participation">
						<h2 id="presentation-participation">Participation</h2>
						<p>Presentation maintenance is unavailable.</p>
					</section>
				}
				@FavoriteControl(snapshot, session, session.PathWithTimezone(snapshot.ViewerTimezone))
			</main>
		</body>
	</html>
}

templ CompetitionsPage(snapshot Snapshot) {
	<!doctype html>
	<html lang={ snapshot.Language } data-locale={ snapshot.Locale }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="stylesheet" href="/assets/frontend.css"/>
			<link rel="stylesheet" href="/assets/schedule.css"/>
			<link rel="stylesheet" href={ frontend.EventThemePath(snapshot.EventID) }/>
			<title>{ snapshot.EventName } Competitions</title>
		</head>
		<body data-reduced-effects={ strconv.FormatBool(snapshot.ReducedEffects) }>
			@ScheduleNavigation(snapshot, "/events/" + snapshot.EventSlug + "/competitions")
			<main>
				<h1>{ snapshot.EventName } Competitions</h1>
				if len(snapshot.Sessions) == 0 {
					<p>No public Competitions are available yet.</p>
				} else {
					for _, session := range snapshot.Sessions {
						<article>
							<h2><a href={ session.CompetitionPath() }>{ session.Title }</a></h2>
							if session.PublicDetails != "" {
								<p>{ session.PublicDetails }</p>
							}
						</article>
					}
				}
			</main>
		</body>
	</html>
}

templ UnavailablePage(snapshot Snapshot, section string) {
	<!doctype html>
	<html lang={ snapshot.Language } data-locale={ snapshot.Locale }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="stylesheet" href="/assets/frontend.css"/>
			<link rel="stylesheet" href={ frontend.EventThemePath(snapshot.EventID) }/>
			<title>{ snapshot.EventName } { section }</title>
		</head>
		<body data-reduced-effects={ strconv.FormatBool(snapshot.ReducedEffects) }>
			@ScheduleNavigation(snapshot, "/events/" + snapshot.EventSlug + "/" + strings.ToLower(section))
			<main>
				<h1>{ snapshot.EventName } { section }</h1>
				<p>{ section } is unavailable.</p>
			</main>
		</body>
	</html>
}

templ ScheduleNavigation(snapshot Snapshot, returnTo string) {
	<nav aria-label="Schedule">
		<a href="/">Beamers</a>
		<a href={ snapshot.SchedulePath() }>Schedule</a>
		if snapshot.AccountName == "" {
			<a href={ SignInPath(returnTo) }>Sign in</a>
			<a href="/register">Register</a>
		} else {
			<a href="/my-schedule">My Schedule</a>
			<span>{ snapshot.AccountName }</span>
		}
		@frontend.EffectsLink(returnTo, snapshot.ReducedEffects)
	</nav>
}

templ FavoriteControl(snapshot Snapshot, session Session, returnTo string) {
	if snapshot.AccountName == "" {
		<p><a href={ SignInPath(session.PathWithTimezone(snapshot.ViewerTimezone)) }>Sign in to add to My Schedule</a></p>
	} else {
		<form
			method="post"
			action={ session.FavoritePath() }
			hx-post={ session.FavoritePath() }
			hx-target="this"
			hx-swap="outerHTML"
		>
			<input type="hidden" name="csrf_token" value={ snapshot.CSRFToken }/>
			<input type="hidden" name="return_to" value={ returnTo }/>
			if session.Favorite {
				<button type="submit" name="favorite" value="false">Remove from My Schedule</button>
			} else {
				<button type="submit" name="favorite" value="true">Add to My Schedule</button>
			}
		</form>
	}
}

templ StructuralFilter(label string, name string, options []FilterOption) {
	<label>
		{ label }
		<select id={ "schedule-" + name } name={ name }>
			<option value="">All</option>
			for _, option := range options {
				if option.Selected {
					<option value={ option.Value() } selected>{ option.Name }</option>
				} else {
					<option value={ option.Value() }>{ option.Name }</option>
				}
			}
		</select>
	</label>
}

templ SessionDetails(session Session) {
	if session.Speaker != "" {
		<p>Speaker: { session.Speaker }</p>
	}
	<p>{ session.PublicDetails }</p>
	<p>Status: { session.Lifecycle }</p>
	if session.Lifecycle == "Canceled" {
		if session.CancellationMessage != "" {
			<p>{ session.CancellationMessage }</p>
		} else {
			<p>Canceled.</p>
		}
	}
	@OperationalTime(session.Time)
	if session.Was != nil {
		if session.Time.ViewerLocal {
			<p>Was: { session.Was.Event } Event time / <time datetime={ session.Was.Datetime }>{ session.Was.Display }</time> attendee-local</p>
		} else {
			<p>Was: <time datetime={ session.Was.Datetime }>{ session.Was.Display }</time></p>
		}
	}
	for _, location := range session.Locations {
		<p>Location: { location }</p>
	}
	for _, lane := range session.Lanes {
		<p>Lane: { lane }</p>
	}
	for _, track := range session.Tracks {
		<p>Track: { track }</p>
	}
	if len(session.CompetitionEntries) > 0 {
		<h2>Entries</h2>
		for _, entry := range session.CompetitionEntries {
			<article class="competition-entry">
				<h3>{ entry.Name }</h3>
				if entry.ResultDisposition == "Disqualified" {
					<p><strong>Disqualified</strong></p>
					if entry.PublicDisqualificationMessage != "" {
						<p>{ entry.PublicDisqualificationMessage }</p>
					}
				}
				if entry.PublicDetails != "" {
					<p>{ entry.PublicDetails }</p>
				}
			</article>
		}
	}
}

templ OperationalTime(presentation TimePresentation) {
	if presentation.ViewerLocal {
		<p>Event Time ({ presentation.EventTimezoneLabel }): { presentation.Start.Label } { presentation.Start.Event } – { presentation.End.Label } { presentation.End.Event }</p>
		<p>Attendee-local time ({ presentation.TimezoneLabel }): { presentation.Start.Label } <time datetime={ presentation.Start.Datetime }>{ presentation.Start.Display }</time> – { presentation.End.Label } <time datetime={ presentation.End.Datetime }>{ presentation.End.Display }</time></p>
	} else {
		<p>{ presentation.Start.Label }: <time datetime={ presentation.Start.Datetime }>{ presentation.Start.Display }</time> – { presentation.End.Label }: <time datetime={ presentation.End.Datetime }>{ presentation.End.Display }</time> ({ presentation.TimezoneLabel })</p>
	}
}

templ CompetitionPage(
	snapshot Snapshot,
	session Session,
	entryAction string,
	entryPath string,
	votingAction string,
	votingPath string,
	votingStatus string,
) {
	<!doctype html>
	<html lang={ snapshot.Language } data-locale={ snapshot.Locale }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="stylesheet" href="/assets/frontend.css"/>
			<link rel="stylesheet" href="/assets/schedule.css"/>
			<link rel="stylesheet" href={ frontend.EventThemePath(snapshot.EventID) }/>
			<title>{ session.Title } · { snapshot.EventName }</title>
		</head>
		<body data-reduced-effects={ strconv.FormatBool(snapshot.ReducedEffects) }>
			@ScheduleNavigation(snapshot, session.CompetitionPath())
			<main>
				<a href={ "/events/" + snapshot.EventSlug + "/competitions" }>Competitions</a>
				<h1>{ session.Title }</h1>
				if session.PublicDetails != "" {
					<p>{ session.PublicDetails }</p>
				}
				if snapshot.AccountName != "" {
					<section aria-labelledby="competition-participation">
						<h2 id="competition-participation">Participation</h2>
						if entryAction != "" {
							<p><a href={ templ.SafeURL(entryPath) }>{ entryAction }</a></p>
						} else {
							<p>Entry submission is unavailable.</p>
						}
						if votingAction != "" {
							<p><a href={ templ.SafeURL(votingPath) }>{ votingAction }</a></p>
						}
						if votingStatus != "" {
							<p>{ votingStatus }</p>
						}
					</section>
				}
				<h2>Entries</h2>
				if len(session.CompetitionEntries) == 0 {
					<p>No public Entries are available yet.</p>
				}
				for _, entry := range session.CompetitionEntries {
					<article id={ fmt.Sprintf("entry-%d", entry.ID) } class="competition-entry">
						<h3>{ entry.Name }</h3>
						if entry.ResultDisposition == "Disqualified" {
							<p><strong>Disqualified</strong></p>
							if entry.PublicDisqualificationMessage != "" {
								<p>{ entry.PublicDisqualificationMessage }</p>
							}
						}
						if entry.PublicDetails != "" {
							<p>{ entry.PublicDetails }</p>
						}
						for _, attachment := range entry.Attachments {
							<p><a href={ attachment.Path() }>{ attachment.Name } ({ attachment.OriginalFilename })</a></p>
						}
					</article>
				}
				<h2>Results</h2>
				if session.ResultsPath == "" {
					<p>Results have not been published yet.</p>
				} else {
					<p><a href={ session.ResultsPath }>View Competition Results</a></p>
				}
			</main>
		</body>
	</html>
}

templ SessionAttachments(session Session) {
	if len(session.Attachments) > 0 {
		<h2>Attachments</h2>
		<ul>
			for _, attachment := range session.Attachments {
				<li>
					<a href={ attachment.Path() }>{ attachment.Name } ({ attachment.OriginalFilename })</a>
				</li>
			}
		</ul>
	}
}
