package frontend

import (
	"net/url"
	"strconv"
	"time"

	"github.com/dotwaffle/beamers/internal/events"
	"github.com/dotwaffle/beamers/internal/voting"
)

type VotingRedemptionPage struct {
	AccountName    string
	CSRFToken      string
	ReducedEffects bool
	Backstage      bool
	CommandID      string
	EventID        int
	Message        string
	Success        bool
	Errors         FormErrors
	OpenBallots    []voting.Window
}

type VotingKeyPage struct {
	AccountName    string
	CSRFToken      string
	ReducedEffects bool
	Navigation     BackstageNavigation
	CommandID      string
	Event          events.Event
	ExpiryValue    string
	Keys           []voting.Key
	Issued         []voting.IssuedKey
	Message        string
	Now            time.Time
}

type VotingBallotPage struct {
	AccountName    string
	CSRFToken      string
	ReducedEffects bool
	Backstage      bool
	CommandID      string
	Ballot         voting.Ballot
	Errors         FormErrors
	ErrorEntryID   int
	SubmittedValue int
	StreamID       string
	StreamPosition uint64
}

type CompetitionVotingPage struct {
	AccountName    string
	CSRFToken      string
	ReducedEffects bool
	Navigation     BackstageNavigation
	Producer       bool
	CommandID      string
	Window         voting.Window
	Participation  voting.Participation
	Message        string
}

templ VotingRedemption(page VotingRedemptionPage) {
	<!doctype html>
	<html lang="en">
		@Head("Redeem Voting Key · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, page.Backstage)
			<main id="main-content" tabindex="-1">
				<h1>Redeem Event Voting Key</h1>
				@ErrorSummary(page.Errors)
				if page.Message != "" {
					if page.Success {
						@SuccessFlash(page.Message)
					} else if len(page.Errors) == 0 {
						@ErrorFlash(page.Message)
					}
				}
				<form class="stack" method="post" action="/voting">
					<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
					<input type="hidden" name="command_id" value={ page.CommandID }/>
					<label>
						Event number
						<input
							id="voting-event"
							type="number"
							name="event_id"
							min="1"
							value={ votingEventID(page.EventID) }
							required
							{ page.Errors.Attributes("voting-event")... }
						/>
					</label>
					@FieldError(page.Errors, "voting-event")
					<label>
						Voting Key
						<input
							id="voting-key"
							name="voting_key"
							autocomplete="off"
							spellcheck="false"
							required
							{ page.Errors.Attributes("voting-key")... }
						/>
					</label>
					@FieldError(page.Errors, "voting-key")
					<button type="submit">Redeem Voting Key</button>
				</form>
				<section>
					<h2>Open Ballots</h2>
					if len(page.OpenBallots) == 0 {
						<p>No open Ballots.</p>
					} else {
						<ul>
							for _, window := range page.OpenBallots {
								<li>
									<a href={ votingBallotPath(window.EventID, window.SessionID) }>
										{ window.EventName }: { window.Title }
									</a>
								</li>
							}
						</ul>
					}
				</section>
			</main>
		</body>
	</html>
}

templ VotingBallot(page VotingBallotPage) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="stylesheet" href={ StylesheetPath }/>
			<script src={ HTMXPath } defer></script>
			<script src={ SSEPath } defer></script>
			<title>{ page.Ballot.Window.Title } Ballot · Beamers</title>
		</head>
		<body
			data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }
			hx-ext="sse"
			sse-connect={ votingBallotEventsPath(page) }
		>
			@ShellNavigation(Shell{
				AccountName: page.AccountName,
				CSRFToken: page.CSRFToken,
				ReducedEffects: page.ReducedEffects,
				Backstage: page.Backstage,
				MainID: "ballot",
			})
			@VotingBallotSnapshot(page)
		</body>
	</html>
}

templ VotingBallotSnapshot(page VotingBallotPage) {
	<main
		id="ballot"
		tabindex="-1"
		hx-get={ votingBallotPath(page.Ballot.Window.EventID, page.Ballot.Window.SessionID) }
		hx-trigger="sse:ballot"
		hx-target="this"
		hx-select="#ballot"
		hx-swap="outerHTML"
	>
		<h1>{ page.Ballot.Window.Title } Ballot</h1>
		<p>{ page.Ballot.Window.EventName }</p>
		@ErrorSummary(page.Errors)
		if page.Ballot.Window.State == "Closed" {
			<p role="status">Voting is closed. Your Ballot is read-only.</p>
		} else if len(page.Ballot.Entries) == 0 {
			<p role="status">No Entries have been presented yet.</p>
		}
		for _, entry := range page.Ballot.Entries {
			<section>
				<h2>{ entry.Name }</h2>
				if !entry.CanVote {
					<p>Self-Vote Policy contributes the neutral value when you participate.</p>
				} else if page.Ballot.Window.State == "Open" {
					<form method="post">
						<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
						<input type="hidden" name="command_id" value={ page.CommandID + "-" + strconv.Itoa(entry.ID) }/>
						<input type="hidden" name="event_id" value={ strconv.Itoa(page.Ballot.Window.EventID) }/>
						<input type="hidden" name="entry_id" value={ strconv.Itoa(entry.ID) }/>
						<input type="hidden" name="expected_revision" value={ strconv.Itoa(page.Ballot.Window.Revision) }/>
						<fieldset
							id={ "vote-" + strconv.Itoa(entry.ID) }
							{ page.Errors.Attributes("vote-" + strconv.Itoa(entry.ID))... }
						>
							<legend>Score from 1 through 5</legend>
							for value := 1; value <= 5; value++ {
								<label>
									<input
										type="radio"
										name="value"
										value={ strconv.Itoa(value) }
										checked?={ ballotValue(page, entry.ID, entry.Value) == value }
										required
									/>
									{ strconv.Itoa(value) }
								</label>
							}
						</fieldset>
						@FieldError(page.Errors, "vote-" + strconv.Itoa(entry.ID))
						<button type="submit">Save Vote</button>
					</form>
				} else if entry.Value > 0 {
					<p>Your score: { strconv.Itoa(entry.Value) }</p>
				} else {
					<p>No explicit score.</p>
				}
			</section>
		}
		<p id="ballot-status" role="status" aria-live="polite" aria-atomic="true">Ballot updated.</p>
	</main>
}

func ballotValue(page VotingBallotPage, entryID, fallback int) int {
	if page.ErrorEntryID == entryID {
		return page.SubmittedValue
	}
	return fallback
}

templ CompetitionVoting(page CompetitionVotingPage) {
	<!doctype html>
	<html lang="en">
		@Head("Competition Voting · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(page.Navigation)
				<main id="main-content" tabindex="-1">
					<h1>{ page.Window.Title } Voting</h1>
					if page.Message != "" {
						@ErrorFlash(page.Message)
					}
					<p>Window: { page.Window.State }. Method: { page.Window.Method }. Self-Vote Policy: { page.Window.SelfVotePolicy }.</p>
					<p>
						Eligible: { strconv.Itoa(page.Participation.Eligible) }.
						Participating: { strconv.Itoa(page.Participation.Participating) }.
						Complete: { strconv.Itoa(page.Participation.Complete) }.
						Votable Entries: { strconv.Itoa(page.Participation.Votable) }.
					</p>
					if page.Producer && page.Window.State == "Unopened" {
						<form class="stack" method="post">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<input type="hidden" name="command_id" value={ page.CommandID + "-configure" }/>
							<input type="hidden" name="action" value="configure"/>
							<input type="hidden" name="expected_revision" value={ strconv.Itoa(page.Window.Revision) }/>
							<label>
								<input type="checkbox" name="method_override" value="true"/>
								Override Event Voting Method
							</label>
							<label>Method
								<select name="voting_method"><option value="Range1To5">Range 1–5</option></select>
							</label>
							<label>
								<input type="checkbox" name="self_vote_override" value="true"/>
								Override Event Self-Vote Policy
							</label>
							<label>Self-Vote Policy
								<select name="self_vote_policy">
									<option value="Allowed" selected?={ page.Window.SelfVotePolicy == "Allowed" }>Allowed</option>
									<option value="Neutral" selected?={ page.Window.SelfVotePolicy == "Neutral" }>Neutral substitution</option>
								</select>
							</label>
							<button type="submit">Save Voting configuration</button>
						</form>
						<form method="post">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<input type="hidden" name="command_id" value={ page.CommandID + "-open" }/>
							<input type="hidden" name="action" value="open"/>
							<input type="hidden" name="expected_revision" value={ strconv.Itoa(page.Window.Revision) }/>
							<button type="submit">Open Voting Window</button>
						</form>
					} else if page.Producer && page.Window.State == "Open" {
						<form method="post">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<input type="hidden" name="command_id" value={ page.CommandID + "-close" }/>
							<input type="hidden" name="action" value="close"/>
							<input type="hidden" name="expected_revision" value={ strconv.Itoa(page.Window.Revision) }/>
							<button class="btn-destructive" type="submit">Close Voting Window</button>
						</form>
					}
				</main>
			</div>
		</body>
	</html>
}

templ VotingKeys(page VotingKeyPage) {
	<!doctype html>
	<html lang={ page.Event.EventLocale }>
		@Head("Voting Keys · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(page.Navigation)
				<main id="main-content" tabindex="-1">
					<h1>{ page.Event.Name } Voting Keys</h1>
					<p>Event #{ strconv.Itoa(page.Event.ID) }</p>
					if page.Message != "" {
						@ErrorFlash(page.Message)
					}
					<form class="stack" method="post">
						<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
						<input type="hidden" name="command_id" value={ page.CommandID }/>
						<input type="hidden" name="action" value="issue"/>
						<label>
							Number of keys
							<input type="number" name="count" min="1" max="100" value="10" required/>
						</label>
						<label>
							Expires at ({ page.Event.Timezone })
							<input type="datetime-local" name="expires_at" value={ page.ExpiryValue } required/>
						</label>
						<button type="submit">Issue printable keys</button>
					</form>
					if len(page.Issued) > 0 {
						<section aria-labelledby="issued-voting-keys">
							<h2 id="issued-voting-keys">New Voting Keys</h2>
							<p>Print or save these now. They will not be shown again.</p>
							<ol>
								for _, item := range page.Issued {
									<li><code data-voting-key>{ item.Token }</code></li>
								}
							</ol>
						</section>
					}
					<section>
						<h2>Key inventory</h2>
						if len(page.Keys) == 0 {
							<p>No Voting Keys issued.</p>
						} else {
							<div class="table-scroll">
							<table>
								<caption>Issued Voting Keys and their current status</caption>
								<thead>
									<tr>
										<th scope="col">Key</th>
										<th scope="col">Expires</th>
										<th scope="col">Status</th>
										<th scope="col">Action</th>
									</tr>
								</thead>
								<tbody>
									for _, item := range page.Keys {
										<tr>
											<td>#{ strconv.Itoa(item.ID) }</td>
											<td>@EventTime(item.ExpiresAt, page.Event.Timezone, page.Event.EventLocale)</td>
											<td>{ votingKeyStatus(item, page.Now) }</td>
											<td>
												if item.RevokedAt.IsZero() && item.RedeemedAt.IsZero() && item.ExpiresAt.After(page.Now) {
													<form method="post">
														<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
														<input type="hidden" name="command_id" value={ page.CommandID + "-revoke-" + strconv.Itoa(item.ID) }/>
														<input type="hidden" name="action" value="revoke"/>
														<input type="hidden" name="key_id" value={ strconv.Itoa(item.ID) }/>
														<button class="btn-destructive" type="submit">Revoke</button>
													</form>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
							</div>
						}
					</section>
				</main>
			</div>
		</body>
	</html>
}

func votingEventID(eventID int) string {
	if eventID <= 0 {
		return ""
	}
	return strconv.Itoa(eventID)
}

func votingKeyStatus(key voting.Key, now time.Time) string {
	switch {
	case !key.RedeemedAt.IsZero():
		return "Redeemed"
	case !key.RevokedAt.IsZero():
		return "Revoked"
	case !key.ExpiresAt.After(now):
		return "Expired"
	default:
		return "Available"
	}
}

func votingBallotPath(eventID, sessionID int) string {
	return "/voting/" + strconv.Itoa(sessionID) + "?event_id=" + strconv.Itoa(eventID)
}

func votingBallotEventsPath(page VotingBallotPage) string {
	values := url.Values{}
	values.Set("after", strconv.FormatUint(page.StreamPosition, 10))
	values.Set("event_id", strconv.Itoa(page.Ballot.Window.EventID))
	values.Set("stream_id", page.StreamID)
	return "/voting/" + strconv.Itoa(page.Ballot.Window.SessionID) + "/events?" + values.Encode()
}
