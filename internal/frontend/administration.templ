package frontend

import (
	"net/url"
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/dotwaffle/beamers/internal/activation"
	"github.com/dotwaffle/beamers/internal/auth"
	"github.com/dotwaffle/beamers/internal/events"
)

func commaSeparatedIDs(values []int) string {
	text := make([]string, len(values))
	for index, value := range values {
		text[index] = strconv.Itoa(value)
	}
	return strings.Join(text, ", ")
}

type AdministrationPage struct {
	AccountName    string
	CSRFToken      string
	ReducedEffects bool
	Navigation     BackstageNavigation
	Accounts       []auth.Account
	Events         []events.Event
	Grants         []events.Grant
	AccountCommandID string
	GrantCommandID string
	DisableCommandIDs map[int]string
	RecoveryCommandIDs map[int]string
	RecoveryToken  *auth.RecoveryToken
	SlugAliases []events.EventSlugAlias
	PruneAliasCommandIDs map[int]string
	AuditEntries   []auth.AuditEntry
	ActiveEvent    activation.ActiveEvent
	Preflight      *activation.Preflight
	ActivationCommandID string
	SubmittedAction string
	Form            url.Values
	Errors          FormErrors
}

func AdministrationFieldID(action string, targetID int, field string) string {
	prefix := "administration-" + strings.TrimPrefix(action, "create-")
	switch action {
	case "create-account":
		prefix = "administration-account"
	case "grant":
		prefix = "administration-grant"
	case "preflight":
		prefix = "administration-preflight"
	case "activate":
		prefix = "administration-activation"
	case "issue-recovery-token":
		prefix = "administration-recovery"
	case "prune-event-slug-alias":
		prefix = "administration-alias"
	}
	if targetID > 0 {
		prefix += "-" + strconv.Itoa(targetID)
	}
	return prefix + "-" + strings.ReplaceAll(field, "_", "-")
}

// administrationAccountRowID names an Accounts table row's identity cell, so
// the row's action buttons can reference it with aria-describedby: their
// visible names ("Disable Account", "Issue Recovery Token") do not otherwise
// say which Account they act on.
func administrationAccountRowID(accountID int) string {
	return "administration-account-row-" + strconv.Itoa(accountID)
}

func (page AdministrationPage) submitted(action string, targetID int) bool {
	if page.SubmittedAction != action {
		return false
	}
	if targetID == 0 {
		return true
	}
	field := "account_id"
	if action == "prune-event-slug-alias" {
		field = "alias_id"
	}
	return page.Form.Get(field) == strconv.Itoa(targetID)
}

func (page AdministrationPage) value(
	action string,
	targetID int,
	field, fallback string,
) string {
	if page.submitted(action, targetID) {
		if _, ok := page.Form[field]; ok {
			return page.Form.Get(field)
		}
	}
	return fallback
}

func (page AdministrationPage) selected(
	action string,
	targetID int,
	field, value, fallback string,
) bool {
	return page.value(action, targetID, field, fallback) == value
}

func (page AdministrationPage) checked(
	action string,
	targetID int,
	field, value string,
) bool {
	return page.submitted(action, targetID) && slices.Contains(page.Form[field], value)
}

templ Administration(page AdministrationPage) {
	<!doctype html>
	<html lang="en">
		@Head("Administration · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(page.Navigation)
				<main id="main-content" tabindex="-1">
					<h1>Accounts, Event Grants, and activation</h1>
					@ErrorSummary(page.Errors)
					if page.RecoveryToken != nil {
						<section class="success" role="status">
							<h2>Administrator Recovery Token</h2>
							<p>Give this token to the verified Account owner now. It will not be shown again.</p>
							<p><code data-recovery-token>{ page.RecoveryToken.Token }</code></p>
							<p>Expires { page.RecoveryToken.ExpiresAt.UTC().Format(time.RFC3339) }.</p>
						</section>
					}
					<section>
						<h2>Accounts</h2>
						if len(page.Accounts) == 0 {
							@EmptyState("No Accounts yet. Create one below.")
						} else {
							<div data-density="compact">
								<div class="table-scroll">
									<table>
										<caption>Accounts and their administrative actions</caption>
										<thead>
											<tr>
												<th scope="col">Account</th>
												<th scope="col">Disable</th>
												<th scope="col">Recovery Token</th>
											</tr>
										</thead>
										<tbody>
											for _, account := range page.Accounts {
												<tr>
													<th scope="row" id={ administrationAccountRowID(account.ID) }>
														#{ strconv.Itoa(account.ID) } <strong>{ "@" + account.Handle }</strong> — { account.Name }
														if account.Administrator {
															@Badge("crew", "Administrator")
														}
													</th>
													<td>
														<form method="post" action="/backstage/administration">
															<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
															<input type="hidden" name="action" value="disable-account"/>
															<input type="hidden" name="command_id" value={ page.DisableCommandIDs[account.ID] }/>
															<input type="hidden" name="account_id" value={ strconv.Itoa(account.ID) }/>
															<label>
																Reason
																<select
																	id={ AdministrationFieldID("disable-account", account.ID, "reason") }
																	name="reason"
																	{ page.Errors.Attributes(AdministrationFieldID("disable-account", account.ID, "reason"))... }
																>
																	<option value="crew_departed" selected?={ page.selected("disable-account", account.ID, "reason", "crew_departed", "crew_departed") }>Crew departed</option>
																	<option value="access_revoked" selected?={ page.selected("disable-account", account.ID, "reason", "access_revoked", "crew_departed") }>Access revoked</option>
																	<option value="account_compromised" selected?={ page.selected("disable-account", account.ID, "reason", "account_compromised", "crew_departed") }>Account compromised</option>
																	<option value="duplicate_account" selected?={ page.selected("disable-account", account.ID, "reason", "duplicate_account", "crew_departed") }>Duplicate Account</option>
																</select>
															</label>
															@FieldError(page.Errors, AdministrationFieldID("disable-account", account.ID, "reason"))
															<button class="btn-destructive" type="submit" aria-describedby={ administrationAccountRowID(account.ID) }>Disable Account</button>
														</form>
													</td>
													<td>
														<form method="post" action="/backstage/administration">
															<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
															<input type="hidden" name="action" value="issue-recovery-token"/>
															<input type="hidden" name="command_id" value={ page.RecoveryCommandIDs[account.ID] }/>
															<input type="hidden" name="account_id" value={ strconv.Itoa(account.ID) }/>
															<label>
																Offline verification
																<input
																	id={ AdministrationFieldID("issue-recovery-token", account.ID, "reason") }
																	name="reason"
																	value={ page.value("issue-recovery-token", account.ID, "reason", "") }
																	maxlength="1000"
																	required
																	{ page.Errors.Attributes(AdministrationFieldID("issue-recovery-token", account.ID, "reason"))... }
																/>
															</label>
															@FieldError(page.Errors, AdministrationFieldID("issue-recovery-token", account.ID, "reason"))
															<button class="btn-secondary" type="submit" aria-describedby={ administrationAccountRowID(account.ID) }>Issue Recovery Token</button>
														</form>
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</div>
						}
						<form class="stack" method="post" action="/backstage/administration">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<input type="hidden" name="action" value="create-account"/>
							<input type="hidden" name="command_id" value={ page.AccountCommandID }/>
							<label>
								Account Handle
								<input
									id={ AdministrationFieldID("create-account", 0, "account_handle") }
									name="account_handle"
									value={ page.value("create-account", 0, "account_handle", "") }
									autocomplete="off"
									required
									{ page.Errors.Attributes(AdministrationFieldID("create-account", 0, "account_handle"))... }
								/>
							</label>
							@FieldError(page.Errors, AdministrationFieldID("create-account", 0, "account_handle"))
							<label>
								Display Name
								<input
									id={ AdministrationFieldID("create-account", 0, "display_name") }
									name="display_name"
									value={ page.value("create-account", 0, "display_name", "") }
									autocomplete="name"
									required
									{ page.Errors.Attributes(AdministrationFieldID("create-account", 0, "display_name"))... }
								/>
							</label>
							@FieldError(page.Errors, AdministrationFieldID("create-account", 0, "display_name"))
							<label>
								Password
								<input
									id={ AdministrationFieldID("create-account", 0, "password") }
									type="password"
									name="password"
									minlength="12"
									required
									{ page.Errors.Attributes(AdministrationFieldID("create-account", 0, "password"))... }
								/>
							</label>
							@FieldError(page.Errors, AdministrationFieldID("create-account", 0, "password"))
							<button type="submit">Create Account</button>
						</form>
					</section>
					<section>
						<h2>Event Grants</h2>
						if len(page.Grants) == 0 {
							@EmptyState("No Event Grants yet. Grant one below.")
						} else {
							<div data-density="compact">
								<div class="table-scroll">
									<table>
										<caption>Event Grants by Account</caption>
										<thead>
											<tr>
												<th scope="col">Event</th>
												<th scope="col">Account</th>
												<th scope="col">Role</th>
												<th scope="col">Scope</th>
											</tr>
										</thead>
										<tbody>
											for _, grant := range page.Grants {
												<tr>
													<td data-numeric>#{ strconv.Itoa(grant.EventID) }</td>
													<td data-numeric>#{ strconv.Itoa(grant.AccountID) }</td>
													<td>{ grant.Role }</td>
													<td>
														if len(grant.LaneIDs) > 0 {
															<span>Lanes { commaSeparatedIDs(grant.LaneIDs) }</span>
														}
														if len(grant.DisplayGroupKeys) > 0 {
															<span> · Display groups { strings.Join(grant.DisplayGroupKeys, ", ") }</span>
														}
														if len(grant.Capabilities) > 0 {
															<span> · Capabilities { strings.Join(grant.Capabilities, ", ") }</span>
														}
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</div>
						}
						<form class="stack" method="post" action="/backstage/administration">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<input type="hidden" name="action" value="grant"/>
							<input type="hidden" name="command_id" value={ page.GrantCommandID }/>
							<label>
								Account
								<select
									id={ AdministrationFieldID("grant", 0, "account_id") }
									name="account_id"
									required
									{ page.Errors.Attributes(AdministrationFieldID("grant", 0, "account_id"))... }
								>
									for _, account := range page.Accounts {
										<option
											value={ strconv.Itoa(account.ID) }
											selected?={ page.selected("grant", 0, "account_id", strconv.Itoa(account.ID), "") }
										>{ "@" + account.Handle } — { account.Name }</option>
									}
								</select>
							</label>
							@FieldError(page.Errors, AdministrationFieldID("grant", 0, "account_id"))
							<label>
								Event
								<select
									id={ AdministrationFieldID("grant", 0, "event_id") }
									name="event_id"
									required
									{ page.Errors.Attributes(AdministrationFieldID("grant", 0, "event_id"))... }
								>
									for _, event := range page.Events {
										<option
											value={ strconv.Itoa(event.ID) }
											selected?={ page.selected("grant", 0, "event_id", strconv.Itoa(event.ID), "") }
										>{ event.Name }</option>
									}
								</select>
							</label>
							@FieldError(page.Errors, AdministrationFieldID("grant", 0, "event_id"))
							<label>
								Role
								<select
									id={ AdministrationFieldID("grant", 0, "role") }
									name="role"
									{ page.Errors.Attributes(AdministrationFieldID("grant", 0, "role"))... }
								>
									<option selected?={ page.selected("grant", 0, "role", "Producer", "Producer") }>Producer</option>
									<option selected?={ page.selected("grant", 0, "role", "Operator", "Producer") }>Operator</option>
									<option selected?={ page.selected("grant", 0, "role", "Observer", "Producer") }>Observer</option>
								</select>
							</label>
							@FieldError(page.Errors, AdministrationFieldID("grant", 0, "role"))
							<label>
								Lane IDs
								<input
									id={ AdministrationFieldID("grant", 0, "lane_ids") }
									name="lane_ids"
									value={ page.value("grant", 0, "lane_ids", "") }
									inputmode="numeric"
									placeholder="1, 2"
									{ page.Errors.Attributes(AdministrationFieldID("grant", 0, "lane_ids"))... }
								/>
							</label>
							@FieldError(page.Errors, AdministrationFieldID("grant", 0, "lane_ids"))
							<label>
								Display group keys
								<input
									id={ AdministrationFieldID("grant", 0, "display_group_keys") }
									name="display_group_keys"
									value={ page.value("grant", 0, "display_group_keys", "") }
									placeholder="stage, stream"
									{ page.Errors.Attributes(AdministrationFieldID("grant", 0, "display_group_keys"))... }
								/>
							</label>
							@FieldError(page.Errors, AdministrationFieldID("grant", 0, "display_group_keys"))
							<fieldset
								id={ AdministrationFieldID("grant", 0, "capabilities") }
								{ page.Errors.Attributes(AdministrationFieldID("grant", 0, "capabilities"))... }
							>
								<legend>Additional capabilities</legend>
								<label><input type="checkbox" name="capability" value="EmergencyAlert" checked?={ page.checked("grant", 0, "capability", "EmergencyAlert") }/> Emergency Alert</label>
								<label><input type="checkbox" name="capability" value="ViewResults" checked?={ page.checked("grant", 0, "capability", "ViewResults") }/> View Results</label>
								<label><input type="checkbox" name="capability" value="ManageResults" checked?={ page.checked("grant", 0, "capability", "ManageResults") }/> Manage Results</label>
							</fieldset>
							@FieldError(page.Errors, AdministrationFieldID("grant", 0, "capabilities"))
							<button type="submit">Grant Event access</button>
						</form>
					</section>
					<section>
						<h2>Events and activation</h2>
						if page.ActiveEvent.EventID == 0 {
							@EmptyState("No Active Event. Preflight and activate an Event below.")
						} else {
							<p>
								Active Event #{ strconv.Itoa(page.ActiveEvent.EventID) },
								generation { strconv.Itoa(page.ActiveEvent.Generation) } ·
								<a href={ operationsPath(page.ActiveEvent.EventID) }>Sessions and Displays</a>
							</p>
						}
						<ul>
							for _, event := range page.Events {
								<li>#{ strconv.Itoa(event.ID) } { event.Name }</li>
							}
						</ul>
						<form class="stack" method="post" action="/backstage/administration">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<input type="hidden" name="action" value="preflight"/>
							<label>
								Event
								<select
									id={ AdministrationFieldID("preflight", 0, "event_id") }
									name="event_id"
									required
									{ page.Errors.Attributes(AdministrationFieldID("preflight", 0, "event_id"))... }
								>
									for _, event := range page.Events {
										<option
											value={ strconv.Itoa(event.ID) }
											selected?={ page.selected("preflight", 0, "event_id", strconv.Itoa(event.ID), "") }
										>{ event.Name }</option>
									}
								</select>
							</label>
							@FieldError(page.Errors, AdministrationFieldID("preflight", 0, "event_id"))
							<button type="submit">Run Activation Preflight</button>
						</form>
						if page.Preflight != nil {
							<h3>Activation Preflight · Event #{ strconv.Itoa(page.Preflight.EventID) }</h3>
							<h4>Blockers</h4>
							if len(page.Preflight.Blockers) == 0 {
								<p>None.</p>
							} else {
								<ul>
									for _, finding := range page.Preflight.Blockers {
										<li role="alert"><code>{ finding.Code }</code>: { finding.Message }</li>
									}
								</ul>
							}
							<h4>Warnings</h4>
							if len(page.Preflight.Warnings) == 0 {
								<p>None.</p>
							} else {
								<ul>
									for _, finding := range page.Preflight.Warnings {
										<li><code>{ finding.Code }</code>: { finding.Message }</li>
									}
								</ul>
							}
							if len(page.Preflight.Blockers) == 0 {
								<form method="post" action="/backstage/administration">
									<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
									<input type="hidden" name="action" value="activate"/>
									<input type="hidden" name="event_id" value={ strconv.Itoa(page.Preflight.EventID) }/>
									<input type="hidden" name="event_revision" value={ strconv.Itoa(page.Preflight.Confirmation.EventRevision) }/>
									<input type="hidden" name="published_revision" value={ strconv.Itoa(page.Preflight.Confirmation.PublishedRevision) }/>
									<input type="hidden" name="activation_generation" value={ strconv.Itoa(page.Preflight.Confirmation.ActivationGeneration) }/>
									<input type="hidden" name="fingerprint" value={ page.Preflight.Confirmation.Fingerprint }/>
									<input type="hidden" name="command_id" value={ page.ActivationCommandID }/>
									<button
										id={ AdministrationFieldID("activate", page.Preflight.EventID, "confirmation") }
										class="btn-commit"
										type="submit"
										{ page.Errors.Attributes(AdministrationFieldID("activate", page.Preflight.EventID, "confirmation"))... }
									>Activate Event</button>
									@FieldError(page.Errors, AdministrationFieldID("activate", page.Preflight.EventID, "confirmation"))
								</form>
							}
						}
					</section>
					<section>
						<h2>Event Slug Aliases</h2>
						if len(page.SlugAliases) == 0 {
							@EmptyState("No retained Event Slug Aliases.")
						}
						if len(page.SlugAliases) > 0 {
							<ul>
								for _, alias := range page.SlugAliases {
									<li>
										<code>{ alias.Slug }</code>
										redirects to
										<a href={ templ.SafeURL("/events/" + alias.CurrentSlug) }>
											/events/{ alias.CurrentSlug }
										</a>
										<span>Event: { alias.EventName }.</span>
										<form method="post" action="/backstage/administration">
											<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
											<input type="hidden" name="action" value="prune-event-slug-alias"/>
											<input type="hidden" name="command_id" value={ page.PruneAliasCommandIDs[alias.ID] }/>
											<input type="hidden" name="alias_id" value={ strconv.Itoa(alias.ID) }/>
											<label>
												<input
													id={ AdministrationFieldID("prune-event-slug-alias", alias.ID, "confirmed") }
													type="checkbox"
													name="confirmed"
													value="true"
													required
													{ page.Errors.Attributes(AdministrationFieldID("prune-event-slug-alias", alias.ID, "confirmed"))... }
												/>
												Prune this alias. Its slug becomes reusable; stale links may break or retarget.
											</label>
											@FieldError(page.Errors, AdministrationFieldID("prune-event-slug-alias", alias.ID, "confirmed"))
											<button class="btn-destructive" type="submit">Prune Event Slug Alias</button>
										</form>
									</li>
								}
							</ul>
						}
					</section>
					<section>
						<h2>Audit Entries</h2>
						<div class="table-scroll">
						<table>
							<caption>Installation audit history</caption>
							<thead>
								<tr>
									<th scope="col">Time</th>
									<th scope="col">Actor</th>
									<th scope="col">Action</th>
									<th scope="col">Target</th>
									<th scope="col">Outcome</th>
									<th scope="col">Reason</th>
									<th scope="col">Note</th>
								</tr>
							</thead>
							<tbody>
								for _, entry := range page.AuditEntries {
									<tr>
										<td><time datetime={ entry.ServerTime.Format(time.RFC3339) }>{ entry.ServerTime.UTC().Format(time.RFC3339) }</time></td>
										<td>{ entry.ActorName }</td>
										<td>{ entry.Action }</td>
										<td>{ entry.TargetType } #{ entry.TargetID }</td>
										<td>{ entry.Outcome }</td>
										<td>{ entry.Reason }</td>
										<td>{ entry.Note }</td>
									</tr>
								}
							</tbody>
						</table>
						</div>
					</section>
				</main>
			</div>
		</body>
	</html>
}
