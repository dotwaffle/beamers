package frontend

import (
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/dotwaffle/beamers/internal/attachments"
	"github.com/dotwaffle/beamers/internal/competition"
	"github.com/dotwaffle/beamers/internal/events"
	"github.com/dotwaffle/beamers/internal/programcontrol"
	"github.com/dotwaffle/beamers/internal/store"
)

type CompetitionEntriesPage struct {
	AccountID      int
	AccountName    string
	Producer       bool
	CSRFToken     string
	ReducedEffects bool
	Navigation    BackstageNavigation
	CommandID     string
	Event         events.Event
	State         competition.State
	Preflight     competition.Preflight
	Attachments   attachments.CrewState
	Program       programcontrol.State
	SubmissionAccounts []competition.SubmissionAccount
	SubmittedAction string
	Form            url.Values
	Errors          FormErrors
}

func WorkflowFieldID(action string, targetID, versionID, windowID int, field string) string {
	result := action
	for _, id := range []int{targetID, versionID, windowID} {
		if id > 0 {
			result += "-" + strconv.Itoa(id)
		}
	}
	return result + "-" + strings.ReplaceAll(field, "_", "-")
}

func workflowMatches(
	form url.Values,
	submittedAction,
	action string,
	entryID, versionID, windowID int,
) bool {
	if submittedAction != action {
		return false
	}
	for field, id := range map[string]int{
		"entry_id": entryID, "version_id": versionID, "window_id": windowID,
	} {
		if _, present := form[field]; id > 0 && present && form.Get(field) != strconv.Itoa(id) {
			return false
		}
	}
	return true
}

func workflowValue(
	form url.Values,
	submittedAction, action string,
	entryID, versionID, windowID int,
	field, fallback string,
) string {
	if workflowMatches(form, submittedAction, action, entryID, versionID, windowID) {
		if _, ok := form[field]; ok {
			return form.Get(field)
		}
	}
	return fallback
}

func (page CompetitionEntriesPage) matches(
	action string,
	entryID, versionID, windowID int,
) bool {
	return workflowMatches(
		page.Form, page.SubmittedAction, action, entryID, versionID, windowID,
	)
}

func (page CompetitionEntriesPage) value(
	action string,
	entryID, versionID, windowID int,
	field, fallback string,
) string {
	return workflowValue(
		page.Form, page.SubmittedAction, action, entryID, versionID, windowID,
		field, fallback,
	)
}

func (page CompetitionEntriesPage) checked(
	action string,
	entryID, versionID, windowID int,
	field string,
	fallback bool,
) bool {
	if page.matches(action, entryID, versionID, windowID) {
		return page.Form.Get(field) == "true"
	}
	return fallback
}

func entriesTime(value time.Time, timezone string) string {
	location, err := time.LoadLocation(timezone)
	if err != nil {
		location = time.UTC
	}
	return value.In(location).Format("2006-01-02 15:04 MST")
}

templ EventTime(value time.Time, timezone, locale string) {
	<time
		data-event-time
		datetime={ value.UTC().Format(time.RFC3339) }
		data-timezone={ timezone }
		data-locale={ locale }
	>{ entriesTime(value, timezone) }</time>
}

func entryAttachmentVersions(values []attachments.Version, entryID int) []attachments.Version {
	result := make([]attachments.Version, 0)
	for _, value := range values {
		if value.OwnerID == entryID {
			result = append(result, value)
		}
	}
	return result
}

func entryReopenWindows(values []store.ReopenWindow, entryID int) []store.ReopenWindow {
	result := make([]store.ReopenWindow, 0)
	for _, value := range values {
		if value.TargetID == entryID {
			result = append(result, value)
		}
	}
	return result
}

func reopenWindowHistory(values []store.ReopenWindow, now time.Time) []store.ReopenWindow {
	result := make([]store.ReopenWindow, 0)
	for _, window := range values {
		if !window.ClosedAt.IsZero() || !window.ExpiresAt.After(now) {
			result = append(result, window)
		}
	}
	return result
}

// ReopenWindows renders owner-scoped active controls and retained history.
templ ReopenWindows(
	owner, timezone, locale, csrfToken, commandID string,
	windows []store.ReopenWindow,
	producer bool,
	now time.Time,
	form url.Values,
	submittedAction string,
	errors FormErrors,
) {
	<h4>Reopen Windows</h4>
	for _, window := range windows {
		if window.ClosedAt.IsZero() && window.ExpiresAt.After(now) {
			<p>
				<strong>Active Reopen Window:</strong>
				{ owner } — open until
				@EventTime(window.ExpiresAt, timezone, locale)
				: { window.Reason }
			</p>
			if producer {
				<form method="post">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="action" value="extend-reopen-window"/>
					<input type="hidden" name="command_id" value={ commandID }/>
					<input type="hidden" name="entry_id" value={ strconv.Itoa(window.TargetID) }/>
					<input type="hidden" name="window_id" value={ strconv.Itoa(window.ID) }/>
					<input type="hidden" name="expected_revision" value={ strconv.Itoa(window.Revision) }/>
					<label for={ WorkflowFieldID("extend-reopen-window", window.TargetID, 0, window.ID, "expires_at") }>
						Extend until ({ timezone })
					</label>
					<input
						id={ WorkflowFieldID("extend-reopen-window", window.TargetID, 0, window.ID, "expires_at") }
						type="datetime-local"
						name="expires_at"
						value={ workflowValue(form, submittedAction, "extend-reopen-window", window.TargetID, 0, window.ID, "expires_at", "") }
						required
						{ errors.Attributes(WorkflowFieldID("extend-reopen-window", window.TargetID, 0, window.ID, "expires_at"))... }
					/>
					@FieldError(errors, WorkflowFieldID("extend-reopen-window", window.TargetID, 0, window.ID, "expires_at"))
					<button type="submit">Extend Reopen Window</button>
				</form>
				<form method="post">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="action" value="close-reopen-window"/>
					<input type="hidden" name="command_id" value={ commandID }/>
					<input type="hidden" name="entry_id" value={ strconv.Itoa(window.TargetID) }/>
					<input type="hidden" name="window_id" value={ strconv.Itoa(window.ID) }/>
					<input type="hidden" name="expected_revision" value={ strconv.Itoa(window.Revision) }/>
					<label for={ WorkflowFieldID("close-reopen-window", window.TargetID, 0, window.ID, "confirm_close") }>
						<input
							id={ WorkflowFieldID("close-reopen-window", window.TargetID, 0, window.ID, "confirm_close") }
							type="checkbox"
							name="confirm_close"
							value="true"
							required
							{ errors.Attributes(WorkflowFieldID("close-reopen-window", window.TargetID, 0, window.ID, "confirm_close"))... }
						/>
						Confirm early closure
					</label>
					@FieldError(errors, WorkflowFieldID("close-reopen-window", window.TargetID, 0, window.ID, "confirm_close"))
					<button type="submit">Close Reopen Window early</button>
				</form>
			}
		}
	}
	if history := reopenWindowHistory(windows, now); len(history) > 0 {
		<details>
			<summary>Reopen Window history</summary>
			for _, window := range history {
				<p>
					if window.ClosedAt.IsZero() {
						Expired
						@EventTime(window.ExpiresAt, timezone, locale)
					} else {
						Closed
						@EventTime(window.ClosedAt, timezone, locale)
					}
					: { window.Reason }
				</p>
			}
		</details>
	}
}

func entryUploadPath(eventID, sessionID int) string {
	return "/backstage/events/" + strconv.Itoa(eventID) +
		"/competitions/" + strconv.Itoa(sessionID) + "/entries/upload"
}

func entryVersionPath(eventID, versionID int) string {
	return "/crew/events/" + strconv.Itoa(eventID) +
		"/attachment-versions/" + strconv.Itoa(versionID)
}

templ workflowInput(
	page CompetitionEntriesPage,
	action string,
	entryID, versionID, windowID int,
	field, label, inputType, fallback string,
	required bool,
) {
	<label for={ WorkflowFieldID(action, entryID, versionID, windowID, field) }>{ label }</label>
	<input
		id={ WorkflowFieldID(action, entryID, versionID, windowID, field) }
		type={ inputType }
		name={ field }
		value={ page.value(action, entryID, versionID, windowID, field, fallback) }
		required?={ required }
		{ page.Errors.Attributes(WorkflowFieldID(action, entryID, versionID, windowID, field))... }
	/>
	@FieldError(page.Errors, WorkflowFieldID(action, entryID, versionID, windowID, field))
}

templ workflowTextarea(
	page CompetitionEntriesPage,
	action string,
	entryID int,
	field, label, fallback string,
) {
	<label for={ WorkflowFieldID(action, entryID, 0, 0, field) }>{ label }</label>
	<textarea
		id={ WorkflowFieldID(action, entryID, 0, 0, field) }
		name={ field }
		{ page.Errors.Attributes(WorkflowFieldID(action, entryID, 0, 0, field))... }
	>{ page.value(action, entryID, 0, 0, field, fallback) }</textarea>
	@FieldError(page.Errors, WorkflowFieldID(action, entryID, 0, 0, field))
}

templ workflowSelect(
	page CompetitionEntriesPage,
	action string,
	entryID, versionID int,
	field, label string,
	options []string,
	fallback string,
) {
	<label for={ WorkflowFieldID(action, entryID, versionID, 0, field) }>{ label }</label>
	<select
		id={ WorkflowFieldID(action, entryID, versionID, 0, field) }
		name={ field }
		{ page.Errors.Attributes(WorkflowFieldID(action, entryID, versionID, 0, field))... }
	>
		for _, option := range options {
			<option value={ option } selected?={ page.value(action, entryID, versionID, 0, field, fallback) == option }>
				{ option }
			</option>
		}
	</select>
	@FieldError(page.Errors, WorkflowFieldID(action, entryID, versionID, 0, field))
}

templ CompetitionEntries(page CompetitionEntriesPage) {
	<!doctype html>
	<html lang={ page.Event.EventLocale } data-locale={ page.Event.EventLocale }>
		@Head("Competition Entries and Attachments · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(page.Navigation)
				<main id="main-content" tabindex="-1">
					<h1>Competition Entries and Attachments</h1>
					<p><a href={ "/backstage/events/" + strconv.Itoa(page.Event.ID) + "/competitions/" + strconv.Itoa(page.State.SessionID) + "/voting" }>Competition Voting</a></p>
					<p><strong>Submission Deadline:</strong> @EventTime(page.State.SubmissionDeadline, page.Event.Timezone, page.Event.EventLocale)</p>
					<p><strong>Submission Eligibility:</strong> { string(page.State.EffectiveSubmissionEligibility) }</p>
					<p>Forecast Time is managed independently in Program Control.</p>
					@ErrorSummary(page.Errors)
					<section aria-labelledby="start-preflight">
						<h2 id="start-preflight">Start preflight</h2>
						if len(page.Preflight.Blockers) == 0 {
							<p>Ready to start.</p>
						} else {
							for _, blocker := range page.Preflight.Blockers {
								<p class="error" role="alert">
									if blocker.EntryID > 0 {
										Entry #{ strconv.Itoa(blocker.EntryID) }:
									}
									{ blocker.Code }: { blocker.Message }
								</p>
							}
						}
						if page.Producer {
							<form method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="configure-readiness"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								<input type="hidden" name="expected_readiness_revision" value={ strconv.Itoa(page.State.ReadinessRevision) }/>
								<label for={ WorkflowFieldID("configure-readiness", 0, 0, 0, "require_entry_review") }>
									<input
										id={ WorkflowFieldID("configure-readiness", 0, 0, 0, "require_entry_review") }
										type="checkbox"
										name="require_entry_review"
										value="true"
										checked?={ page.checked("configure-readiness", 0, 0, 0, "require_entry_review", page.State.RequireEntryReview) }
										{ page.Errors.Attributes(WorkflowFieldID("configure-readiness", 0, 0, 0, "require_entry_review"))... }
									/>
									Require current Entry review
								</label>
								@FieldError(page.Errors, WorkflowFieldID("configure-readiness", 0, 0, 0, "require_entry_review"))
								<label for={ WorkflowFieldID("configure-readiness", 0, 0, 0, "file_delivery_required") }>
									<input
										id={ WorkflowFieldID("configure-readiness", 0, 0, 0, "file_delivery_required") }
										type="checkbox"
										name="file_delivery_required"
										value="true"
										checked?={ page.checked("configure-readiness", 0, 0, 0, "file_delivery_required", page.State.FileDeliveryRequired) }
										{ page.Errors.Attributes(WorkflowFieldID("configure-readiness", 0, 0, 0, "file_delivery_required"))... }
									/>
									File Delivery Required
								</label>
								@FieldError(page.Errors, WorkflowFieldID("configure-readiness", 0, 0, 0, "file_delivery_required"))
								<button type="submit">Configure readiness</button>
							</form>
						}
					</section>
					if page.Producer {
						<section>
							<h2>Submission Eligibility</h2>
							<form method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="configure-submission-eligibility"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								<input type="hidden" name="expected_submission_eligibility_revision" value={ strconv.Itoa(page.State.SubmissionEligibilityRevision) }/>
								<label for={ WorkflowFieldID("configure-submission-eligibility", 0, 0, 0, "override") }>
									<input
										id={ WorkflowFieldID("configure-submission-eligibility", 0, 0, 0, "override") }
										type="checkbox"
										name="override"
										value="true"
										checked?={ page.checked("configure-submission-eligibility", 0, 0, 0, "override", page.State.SubmissionEligibilityOverride != "") }
									/>
									Override Event policy
								</label>
								@workflowSelect(page, "configure-submission-eligibility", 0, 0, "submission_eligibility", "Eligibility", []string{"AllAccounts", "VotingEligibleAccounts"}, string(page.State.EffectiveSubmissionEligibility))
								<button type="submit">Configure Submission Eligibility</button>
							</form>
						</section>
					}
					<section>
						<h2>Entry order</h2>
						<p>
							Policy: { string(page.State.EntryOrder.Policy) }.
							Canonical order:
							if len(page.State.EntryOrder.EntryIDs) == 0 {
								{ "none" }
							} else {
								for index, id := range page.State.EntryOrder.EntryIDs {
									if index > 0 {
										{ ", " }
									}
									{ strconv.Itoa(id) }
								}
							}
						</p>
						if page.Producer {
							<form method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="configure-order"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								<input type="hidden" name="expected_order_revision" value={ strconv.Itoa(page.State.EntryOrder.Revision) }/>
								@workflowSelect(page, "configure-order", 0, 0, "order_policy", "Order policy", []string{"SubmissionOrder", "ManualOrder", "DeterministicShuffle"}, string(page.State.EntryOrder.Policy))
								@workflowInput(page, "configure-order", 0, 0, 0, "order_seed", "Shuffle seed", "number", strconv.FormatInt(page.State.EntryOrder.Seed, 10), false)
								@workflowInput(page, "configure-order", 0, 0, 0, "manual_entry_ids", "Manual Entry IDs, comma-separated", "text", "", false)
								<button type="submit">Configure Entry order</button>
							</form>
						}
					</section>
					<section>
						<h2>Program Control</h2>
						if page.Program.Owner == nil {
							<p>No Control Owner.</p>
							<form method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="claim-control"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								<input type="hidden" name="expected_control_revision" value={ strconv.Itoa(page.Program.ControlRevision) }/>
								<button type="submit">Claim Control to defer Entries</button>
							</form>
						} else {
							<p>Control Owner: { page.Program.Owner.Name }</p>
						}
						<p>
							Current: { page.Program.Channel.Current.Title };
							Next: { page.Program.Channel.Next.Title };
							Program revision { strconv.Itoa(page.Program.Channel.Revision) }
						</p>
					</section>
					<section>
						<h2>Attachment Release Policy</h2>
						<p>Event default: { string(page.Attachments.EventRelease.Policy) }</p>
						if page.Attachments.CompetitionRelease.Override {
							<p>Competition override: { string(page.Attachments.CompetitionRelease.Policy) }</p>
						} else {
							<p>Competition override: none</p>
						}
						if page.Producer {
							<form method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="competition-release-policy"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								<input type="hidden" name="expected_revision" value={ strconv.Itoa(page.Attachments.CompetitionRelease.Revision) }/>
								<label for={ WorkflowFieldID("competition-release-policy", 0, 0, 0, "override") }>
									<input
										id={ WorkflowFieldID("competition-release-policy", 0, 0, 0, "override") }
										type="checkbox"
										name="override"
										value="true"
										checked?={ page.checked("competition-release-policy", 0, 0, 0, "override", page.Attachments.CompetitionRelease.Override) }
										{ page.Errors.Attributes(WorkflowFieldID("competition-release-policy", 0, 0, 0, "override"))... }
									/>
									Override Event policy
								</label>
								@FieldError(page.Errors, WorkflowFieldID("competition-release-policy", 0, 0, 0, "override"))
								@workflowSelect(page, "competition-release-policy", 0, 0, "release_policy", "Release Policy", []string{"OnLive", "OnEnded", "OnEventReleaseCue"}, string(page.Attachments.CompetitionRelease.Policy))
								<button type="submit">Configure release policy</button>
							</form>
						}
					</section>
					if page.Producer {
						<section>
							<h2>Create Entry</h2>
							<form class="stack" method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="create-entry"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								@workflowInput(page, "create-entry", 0, 0, 0, "entry_name", "Entry name", "text", "", true)
								@workflowTextarea(page, "create-entry", 0, "public_details", "Public details", "")
								@workflowTextarea(page, "create-entry", 0, "crew_notes", "Crew notes", "")
								<button type="submit">Create Entry</button>
							</form>
						</section>
					}
					<section>
						<h2>Entries</h2>
						if len(page.State.Entries) == 0 {
							<p>No Entries yet.</p>
						}
						for _, entry := range page.State.Entries {
							<article>
								<h3>{ entry.Name }</h3>
								<p>{ entry.PublicDetails }</p>
								<p><strong>Crew notes:</strong> { entry.CrewNotes }</p>
								<p>
									Disposition: { string(entry.Disposition) };
									revision { strconv.Itoa(entry.Revision) };
									review current: { strconv.FormatBool(entry.ReviewCurrent) }
								</p>
								if entry.SubmitterAccountID == 0 {
									<p><strong>Submitter:</strong> Crew Managed</p>
								} else {
									<p><strong>Submitter Account:</strong> #{ strconv.Itoa(entry.SubmitterAccountID) }</p>
								}
								<p>
									Presentation: { entry.PresentationStatus };
									Result: { entry.ResultDisposition };
									Entry Release Hold: { strconv.FormatBool(entry.ReleaseHold) }
								</p>
								if entry.TechnicalFailureReason != "" {
									<p><strong>Technical Failure:</strong> { entry.TechnicalFailureReason }</p>
								}
								if page.Producer {
									if entry.SubmitterAccountID == 0 {
										<form method="post">
											<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
											<input type="hidden" name="action" value="assign-submitter"/>
											<input type="hidden" name="command_id" value={ page.CommandID }/>
											<input type="hidden" name="entry_id" value={ strconv.Itoa(entry.ID) }/>
											<input type="hidden" name="expected_revision" value={ strconv.Itoa(entry.Revision) }/>
											<label for={ WorkflowFieldID("assign-submitter", entry.ID, 0, 0, "account_id") }>Submitter Account</label>
											<select
												id={ WorkflowFieldID("assign-submitter", entry.ID, 0, 0, "account_id") }
												name="account_id"
												required
												{ page.Errors.Attributes(WorkflowFieldID("assign-submitter", entry.ID, 0, 0, "account_id"))... }
											>
													for _, account := range page.SubmissionAccounts {
														<option
															value={ strconv.Itoa(account.ID) }
															selected?={ page.value("assign-submitter", entry.ID, 0, 0, "account_id", "") == strconv.Itoa(account.ID) }
														>{ "@" + account.Handle + " — " + account.Name }</option>
													}
											</select>
											@FieldError(page.Errors, WorkflowFieldID("assign-submitter", entry.ID, 0, 0, "account_id"))
											<button type="submit">Assign Submitter Account</button>
										</form>
									}
									<form class="stack" method="post">
										<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
										<input type="hidden" name="action" value="update-entry"/>
										<input type="hidden" name="command_id" value={ page.CommandID }/>
										<input type="hidden" name="entry_id" value={ strconv.Itoa(entry.ID) }/>
										<input type="hidden" name="expected_revision" value={ strconv.Itoa(entry.Revision) }/>
										@workflowInput(page, "update-entry", entry.ID, 0, 0, "entry_name", "Entry name", "text", entry.Name, true)
										@workflowTextarea(page, "update-entry", entry.ID, "public_details", "Public details", entry.PublicDetails)
										@workflowTextarea(page, "update-entry", entry.ID, "crew_notes", "Crew notes", entry.CrewNotes)
										<button type="submit">Update Entry</button>
									</form>
									<form method="post">
										<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
										<input type="hidden" name="action" value="review-entry"/>
										<input type="hidden" name="command_id" value={ page.CommandID }/>
										<input type="hidden" name="entry_id" value={ strconv.Itoa(entry.ID) }/>
										<input type="hidden" name="expected_revision" value={ strconv.Itoa(entry.Revision) }/>
										<button type="submit">Review Entry</button>
									</form>
									<form method="post">
										<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
										<input type="hidden" name="action" value="change-disposition"/>
										<input type="hidden" name="command_id" value={ page.CommandID }/>
										<input type="hidden" name="entry_id" value={ strconv.Itoa(entry.ID) }/>
										<input type="hidden" name="expected_revision" value={ strconv.Itoa(entry.Revision) }/>
										@workflowSelect(page, "change-disposition", entry.ID, 0, "disposition", "Disposition", []string{"Pending", "Included", "Rejected"}, string(entry.Disposition))
										<label for={ WorkflowFieldID("change-disposition", entry.ID, 0, 0, "confirmed_live_override") }>
											<input
												id={ WorkflowFieldID("change-disposition", entry.ID, 0, 0, "confirmed_live_override") }
												type="checkbox"
												name="confirmed_live_override"
												value="true"
												{ page.Errors.Attributes(WorkflowFieldID("change-disposition", entry.ID, 0, 0, "confirmed_live_override"))... }
											/>
											Confirm live disposition override
										</label>
										@FieldError(page.Errors, WorkflowFieldID("change-disposition", entry.ID, 0, 0, "confirmed_live_override"))
										<button type="submit">Change disposition</button>
									</form>
								}
								<form method="post">
									<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
									<input type="hidden" name="action" value="record-technical-failure"/>
									<input type="hidden" name="command_id" value={ page.CommandID }/>
									<input type="hidden" name="entry_id" value={ strconv.Itoa(entry.ID) }/>
									<input type="hidden" name="expected_revision" value={ strconv.Itoa(entry.Revision) }/>
									@workflowInput(page, "record-technical-failure", entry.ID, 0, 0, "crew_reason", "Technical Failure Crew Reason", "text", "", true)
									<button type="submit">Record Technical Failure</button>
								</form>
								if page.Producer {
									<form method="post">
										<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
										<input type="hidden" name="action" value="resolve-entry"/>
										<input type="hidden" name="command_id" value={ page.CommandID }/>
										<input type="hidden" name="entry_id" value={ strconv.Itoa(entry.ID) }/>
										<input type="hidden" name="expected_revision" value={ strconv.Itoa(entry.Revision) }/>
										@workflowSelect(page, "resolve-entry", entry.ID, 0, "result_disposition", "Final resolution", []string{"Eligible", "Disqualified", "Withheld"}, "Eligible")
										@workflowInput(page, "resolve-entry", entry.ID, 0, 0, "crew_reason", "Crew Reason", "text", "", true)
										@workflowInput(page, "resolve-entry", entry.ID, 0, 0, "public_disqualification_message", "Public disqualification message", "text", "", false)
										<button type="submit">Resolve Entry</button>
									</form>
									<form method="post">
										<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
										<input type="hidden" name="action" value="entry-release-hold"/>
										<input type="hidden" name="command_id" value={ page.CommandID }/>
										<input type="hidden" name="entry_id" value={ strconv.Itoa(entry.ID) }/>
										<input type="hidden" name="expected_revision" value={ strconv.Itoa(entry.Revision) }/>
										<label for={ WorkflowFieldID("entry-release-hold", entry.ID, 0, 0, "hold") }>
											<input
												id={ WorkflowFieldID("entry-release-hold", entry.ID, 0, 0, "hold") }
												type="checkbox"
												name="hold"
												value="true"
												checked?={ page.checked("entry-release-hold", entry.ID, 0, 0, "hold", entry.ReleaseHold) }
												{ page.Errors.Attributes(WorkflowFieldID("entry-release-hold", entry.ID, 0, 0, "hold"))... }
											/>
											Entry Release Hold
										</label>
										@FieldError(page.Errors, WorkflowFieldID("entry-release-hold", entry.ID, 0, 0, "hold"))
										@workflowInput(page, "entry-release-hold", entry.ID, 0, 0, "crew_reason", "Crew Reason", "text", "", true)
										<button type="submit">Set Entry Release Hold</button>
									</form>
								}
								if page.Program.Owner != nil && page.Program.Owner.AccountID == page.AccountID {
									<form method="post">
										<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
										<input type="hidden" name="action" value="defer-entry"/>
										<input type="hidden" name="command_id" value={ page.CommandID }/>
										<input type="hidden" name="entry_id" value={ strconv.Itoa(entry.ID) }/>
										<input type="hidden" name="expected_revision" value={ strconv.Itoa(entry.Revision) }/>
										<input type="hidden" name="expected_program_revision" value={ strconv.Itoa(page.Program.Channel.Revision) }/>
										<input type="hidden" name="expected_control_revision" value={ strconv.Itoa(page.Program.ControlRevision) }/>
										<button type="submit">Defer Entry</button>
									</form>
								}
								if page.Producer {
									<form class="stack" method="post" enctype="multipart/form-data" action={ templ.SafeURL(entryUploadPath(page.State.EventID, page.State.SessionID)) }>
										<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
										<input type="hidden" name="command_id" value={ page.CommandID }/>
										<input type="hidden" name="entry_id" value={ strconv.Itoa(entry.ID) }/>
										@workflowInput(page, "upload-entry", entry.ID, 0, 0, "name", "Attachment name", "text", "", true)
										<label for={ WorkflowFieldID("upload-entry", entry.ID, 0, 0, "file") }>File</label>
										<input
											id={ WorkflowFieldID("upload-entry", entry.ID, 0, 0, "file") }
											type="file"
											name="file"
											required
											{ page.Errors.Attributes(WorkflowFieldID("upload-entry", entry.ID, 0, 0, "file"))... }
										/>
										@FieldError(page.Errors, WorkflowFieldID("upload-entry", entry.ID, 0, 0, "file"))
										<label for={ WorkflowFieldID("upload-entry", entry.ID, 0, 0, "crew_only") }>
											<input
												id={ WorkflowFieldID("upload-entry", entry.ID, 0, 0, "crew_only") }
												type="checkbox"
												name="crew_only"
												value="true"
												checked?={ page.checked("upload-entry", entry.ID, 0, 0, "crew_only", false) }
											/>
											Crew Only Release Eligibility
										</label>
										<button type="submit">Upload immutable Version</button>
									</form>
								}
								<h4>Attachment Versions</h4>
								if len(entryAttachmentVersions(page.Attachments.Versions, entry.ID)) == 0 {
									<p>No Attachment Versions.</p>
								}
								for _, version := range entryAttachmentVersions(page.Attachments.Versions, entry.ID) {
									<section>
										<h5>{ version.Name } — Version { strconv.Itoa(version.Version) }</h5>
										<p>
											<a href={ templ.SafeURL(entryVersionPath(page.State.EventID, version.ID)) }>
												{ version.OriginalFilename }
											</a>
										</p>
										<p>SHA-256: { version.SHA256 }</p>
										<p>
											Final: { strconv.FormatBool(version.Final) };
											Primary: { strconv.FormatBool(version.Primary) };
											Release Eligibility: { string(version.ReleaseEligibility) };
											Release Hold: { strconv.FormatBool(version.ReleaseHold) }
										</p>
										if page.Producer {
											<form method="post">
												<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
												<input type="hidden" name="action" value="attachment-readiness"/>
												<input type="hidden" name="command_id" value={ page.CommandID }/>
												<input type="hidden" name="entry_id" value={ strconv.Itoa(entry.ID) }/>
												<input type="hidden" name="version_id" value={ strconv.Itoa(version.ID) }/>
												<input type="hidden" name="expected_revision" value={ strconv.Itoa(version.ReadinessRevision) }/>
												<label for={ WorkflowFieldID("attachment-readiness", entry.ID, version.ID, 0, "final") }>
													<input
														id={ WorkflowFieldID("attachment-readiness", entry.ID, version.ID, 0, "final") }
														type="checkbox"
														name="final"
														value="true"
														checked?={ page.checked("attachment-readiness", entry.ID, version.ID, 0, "final", version.Final) }
														{ page.Errors.Attributes(WorkflowFieldID("attachment-readiness", entry.ID, version.ID, 0, "final"))... }
													/>
													Final Version
												</label>
												@FieldError(page.Errors, WorkflowFieldID("attachment-readiness", entry.ID, version.ID, 0, "final"))
												<label for={ WorkflowFieldID("attachment-readiness", entry.ID, version.ID, 0, "primary") }>
													<input
														id={ WorkflowFieldID("attachment-readiness", entry.ID, version.ID, 0, "primary") }
														type="checkbox"
														name="primary"
														value="true"
														checked?={ page.checked("attachment-readiness", entry.ID, version.ID, 0, "primary", version.Primary) }
														{ page.Errors.Attributes(WorkflowFieldID("attachment-readiness", entry.ID, version.ID, 0, "primary"))... }
													/>
													Primary Attachment
												</label>
												@FieldError(page.Errors, WorkflowFieldID("attachment-readiness", entry.ID, version.ID, 0, "primary"))
												<button type="submit">Set Final and Primary</button>
											</form>
											<form method="post">
												<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
												<input type="hidden" name="action" value="version-release-hold"/>
												<input type="hidden" name="command_id" value={ page.CommandID }/>
												<input type="hidden" name="version_id" value={ strconv.Itoa(version.ID) }/>
												<input type="hidden" name="expected_revision" value={ strconv.Itoa(version.ReleaseRevision) }/>
												<label for={ WorkflowFieldID("version-release-hold", 0, version.ID, 0, "hold") }>
													<input
														id={ WorkflowFieldID("version-release-hold", 0, version.ID, 0, "hold") }
														type="checkbox"
														name="hold"
														value="true"
														checked?={ page.checked("version-release-hold", 0, version.ID, 0, "hold", version.ReleaseHold) }
														{ page.Errors.Attributes(WorkflowFieldID("version-release-hold", 0, version.ID, 0, "hold"))... }
													/>
													Release Hold
												</label>
												@FieldError(page.Errors, WorkflowFieldID("version-release-hold", 0, version.ID, 0, "hold"))
												<button type="submit">Set Version Release Hold</button>
											</form>
										}
									</section>
								}
								@ReopenWindows(
									entry.Name,
									page.Event.Timezone,
									page.Event.EventLocale,
									page.CSRFToken,
									page.CommandID,
									entryReopenWindows(page.Attachments.ReopenWindows, entry.ID),
									page.Producer,
									time.Now(),
									page.Form,
									page.SubmittedAction,
									page.Errors,
								)
								if page.Producer {
									<form method="post">
										<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
										<input type="hidden" name="action" value="create-reopen-window"/>
										<input type="hidden" name="command_id" value={ page.CommandID }/>
										<input type="hidden" name="entry_id" value={ strconv.Itoa(entry.ID) }/>
										@workflowInput(page, "create-reopen-window", entry.ID, 0, 0, "reason", "Reopen reason", "text", "", true)
										@workflowInput(page, "create-reopen-window", entry.ID, 0, 0, "expires_at", "Expires at (" + page.Event.Timezone + ")", "datetime-local", "", true)
										<button type="submit">Create bounded Reopen Window</button>
									</form>
								}
							</article>
						}
					</section>
				</main>
			</div>
			<script src={ EventTimePath } defer></script>
		</body>
	</html>
}
