package frontend

import (
	"fmt"
	"net/url"
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/dotwaffle/beamers/internal/events"
	"github.com/dotwaffle/beamers/internal/rundown"
)

type PlanningPage struct {
	AccountName      string
	CSRFToken       string
	ReducedEffects  bool
	Navigation      BackstageNavigation
	Event           events.Event
	Rundown         rundown.CrewRundown
	Draft           rundown.DraftRundown
	SessionBases    map[int]string
	CurrentPreview  rundown.PublishPreview
	PublishPreview  *rundown.PublishPreview
	CSVPreview      *rundown.CSVImportPreview
	ICalendarPreview *rundown.ICalendarImportPreview
	CSVData         string
	CSVMappings     string
	ICalendarData   string
	ICalendarChoices string
	CommandID       string
	SubmittedAction string
	Form            url.Values
	Errors          FormErrors
}

type BackstageSessionsPage struct {
	AccountName    string
	CSRFToken      string
	ReducedEffects bool
	Navigation     BackstageNavigation
	Event          events.Event
	Role           string
	Sessions       []rundown.CrewSession
	Manage         map[int]bool
	Producer       bool
}

type NewEventPage struct {
	AccountName    string
	CSRFToken     string
	ReducedEffects bool
	Navigation    BackstageNavigation
	CommandID     string
	GrantCommandID string
	GrantSelfDefault bool
	Error         string
}

func planningPresets(values []int) string {
	parts := make([]string, 0, len(values))
	for _, value := range values {
		parts = append(parts, strconv.Itoa(value))
	}
	return strings.Join(parts, ",")
}

func planningDateTime(value time.Time, timezone string) string {
	if value.IsZero() {
		return ""
	}
	location, err := time.LoadLocation(timezone)
	if err != nil {
		return value.UTC().Format("2006-01-02T15:04")
	}
	return value.In(location).Format("2006-01-02T15:04")
}

func planningZone(value time.Time, timezone string) string {
	if value.IsZero() {
		return ""
	}
	location, err := time.LoadLocation(timezone)
	if err != nil {
		return ""
	}
	local := value.In(location)
	zone, offset := local.Zone()
	sign := "+"
	if offset < 0 {
		sign = "-"
		offset = -offset
	}
	return zone + " UTC" + sign + strconv.Itoa(offset/3600) + ":" + fmt.Sprintf("%02d", offset%3600/60)
}

func planningContains(values []int, wanted int) bool {
	for _, value := range values {
		if value == wanted {
			return true
		}
	}
	return false
}

func PlanningFieldID(target string, id int, field string) string {
	prefix := target
	if id > 0 {
		prefix += "-" + strconv.Itoa(id)
	}
	return prefix + "-" + strings.ReplaceAll(field, "_", "-")
}

func (page PlanningPage) draftSubmitted(target string, id int) bool {
	if page.SubmittedAction != "draft" {
		return false
	}
	if target == "draft" {
		return page.Form.Get("location_id") == "" &&
			page.Form.Get("lane_id") == "" &&
			page.Form.Get("track_id") == "" &&
			page.Form.Get("session_id") == ""
	}
	return page.Form.Get(target+"_id") == strconv.Itoa(id)
}

func (page PlanningPage) draftValue(target string, id int, field, fallback string) string {
	if page.draftSubmitted(target, id) {
		if _, ok := page.Form[field]; ok {
			return page.Form.Get(field)
		}
	}
	return fallback
}

func (page PlanningPage) draftChecked(
	target string,
	id int,
	field, value string,
	fallback bool,
) bool {
	if page.draftSubmitted(target, id) {
		return slices.Contains(page.Form[field], value)
	}
	return fallback
}

templ planningDraftInput(
	page PlanningPage,
	field, label, inputType, fallback string,
	required bool,
) {
	<label for={ PlanningFieldID("draft", 0, field) }>{ label }</label>
	<input
		id={ PlanningFieldID("draft", 0, field) }
		type={ inputType }
		name={ field }
		value={ page.draftValue("draft", 0, field, fallback) }
		required?={ required }
		{ page.Errors.Attributes(PlanningFieldID("draft", 0, field))... }
	/>
	@FieldError(page.Errors, PlanningFieldID("draft", 0, field))
}

templ planningDraftTextarea(page PlanningPage, field, label string) {
	<label for={ PlanningFieldID("draft", 0, field) }>{ label }</label>
	<textarea
		id={ PlanningFieldID("draft", 0, field) }
		name={ field }
		{ page.Errors.Attributes(PlanningFieldID("draft", 0, field))... }
	>{ page.draftValue("draft", 0, field, "") }</textarea>
	@FieldError(page.Errors, PlanningFieldID("draft", 0, field))
}

templ planningDraftSelect(
	page PlanningPage,
	field, label string,
	options []string,
	fallback string,
) {
	<label for={ PlanningFieldID("draft", 0, field) }>{ label }</label>
	<select
		id={ PlanningFieldID("draft", 0, field) }
		name={ field }
		{ page.Errors.Attributes(PlanningFieldID("draft", 0, field))... }
	>
		for _, option := range options {
			<option value={ option } selected?={ page.draftValue("draft", 0, field, fallback) == option }>
				if option == "" {
					Unambiguous
				} else {
					{ option }
				}
			</option>
		}
	</select>
	@FieldError(page.Errors, PlanningFieldID("draft", 0, field))
}

templ planningEditInput(
	page PlanningPage,
	target string,
	id int,
	field, label, inputType, fallback string,
	required bool,
) {
	<label for={ PlanningFieldID(target, id, field) }>{ label }</label>
	<input
		id={ PlanningFieldID(target, id, field) }
		type={ inputType }
		name={ field }
		value={ page.draftValue(target, id, field, fallback) }
		required?={ required }
		{ page.Errors.Attributes(PlanningFieldID(target, id, field))... }
	/>
	@FieldError(page.Errors, PlanningFieldID(target, id, field))
}

templ planningEditTextarea(
	page PlanningPage,
	target string,
	id int,
	field, label, fallback string,
) {
	<label for={ PlanningFieldID(target, id, field) }>{ label }</label>
	<textarea
		id={ PlanningFieldID(target, id, field) }
		name={ field }
		{ page.Errors.Attributes(PlanningFieldID(target, id, field))... }
	>{ page.draftValue(target, id, field, fallback) }</textarea>
	@FieldError(page.Errors, PlanningFieldID(target, id, field))
}

templ planningEditSelect(
	page PlanningPage,
	target string,
	id int,
	field, label string,
	options []string,
	fallback string,
) {
	<label for={ PlanningFieldID(target, id, field) }>{ label }</label>
	<select
		id={ PlanningFieldID(target, id, field) }
		name={ field }
		{ page.Errors.Attributes(PlanningFieldID(target, id, field))... }
	>
		for _, option := range options {
			<option value={ option } selected?={ page.draftValue(target, id, field, fallback) == option }>
				if option == "" {
					Unchanged or unambiguous
				} else {
					{ humanizeIdentifier(option) }
				}
			</option>
		}
	</select>
	@FieldError(page.Errors, PlanningFieldID(target, id, field))
}

templ Planning(page PlanningPage) {
	<!doctype html>
		<html lang={ page.Event.EventLocale } data-locale={ page.Event.EventLocale }>
		@Head("Plan and publish · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(page.Navigation)
				<main id="main-content" tabindex="-1">
					<h1>Plan and publish</h1>
					<div class="tiles">
						@Metric("Draft revision", strconv.Itoa(page.CurrentPreview.DraftRevision))
						@Metric("Published revision", strconv.Itoa(page.CurrentPreview.PublishedRevision))
					</div>
					@ErrorSummary(page.Errors)
					<section>
						<h2>Published Rundown</h2>
						<ul>
							for _, location := range page.Rundown.Locations {
								<li>Location #{ strconv.Itoa(location.ID) }: { location.Name }</li>
							}
							for _, lane := range page.Rundown.Lanes {
								<li>Lane #{ strconv.Itoa(lane.ID) }: { lane.Name }</li>
							}
							for _, track := range page.Rundown.Tracks {
								<li>Track #{ strconv.Itoa(track.ID) }: { track.Name }</li>
							}
							for _, session := range page.Rundown.Sessions {
								<li>Session #{ strconv.Itoa(session.ID) }: { session.Title }</li>
							}
						</ul>
					</section>
					<section id="submissions">
						<h2>Submissions and Attachments</h2>
						<ul>
							for _, session := range page.Rundown.Sessions {
								if session.Type == rundown.SessionCompetition {
									<li>
										<a href={ templ.SafeURL(
											"/backstage/events/" + strconv.Itoa(page.Event.ID) +
											"/competitions/" + strconv.Itoa(session.ID) + "/entries",
										) }>
											Manage { session.Title }
										</a>
										— Submission Deadline
										@EventTime(session.SubmissionDeadline, page.Event.Timezone, page.Event.EventLocale)
									</li>
								}
								if session.Type == rundown.SessionPresentation {
									<li>
										<a href={ templ.SafeURL(
											"/backstage/events/" + strconv.Itoa(page.Event.ID) +
											"/presentations/" + strconv.Itoa(session.ID) + "/submission",
										) }>
											Manage { session.Title }
										</a>
										— Presentation Submitter and Attachments
									</li>
								}
							}
						</ul>
					</section>
					<details open?={ page.SubmittedAction == "draft" }>
						<summary>Edit Draft structure</summary>
						<p>Create related structure together, or reference current Draft IDs.</p>
						<form class="stack" method="post">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<input type="hidden" name="action" value="draft"/>
							<input type="hidden" name="command_id" value={ page.CommandID }/>
							<input type="hidden" name="expected_draft_revision" value={ strconv.Itoa(page.CurrentPreview.DraftRevision) }/>
							<fieldset>
								<legend>Location</legend>
								<label for="draft-location-name">Name</label>
								<input
									id="draft-location-name"
									name="location_name"
									value={ page.draftValue("draft", 0, "location_name", "") }
									{ page.Errors.Attributes("draft-location-name")... }
								/>
								@FieldError(page.Errors, "draft-location-name")
							</fieldset>
							<fieldset>
								<legend>Lane</legend>
								<label for="draft-lane-name">Name</label>
								<input
									id="draft-lane-name"
									name="lane_name"
									value={ page.draftValue("draft", 0, "lane_name", "") }
									{ page.Errors.Attributes("draft-lane-name")... }
								/>
								@FieldError(page.Errors, "draft-lane-name")
								<label for="draft-lane-location-id">Current Draft Location ID</label>
								<input
									id="draft-lane-location-id"
									type="number"
									min="1"
									name="lane_location_id"
									value={ page.draftValue("draft", 0, "lane_location_id", "") }
									{ page.Errors.Attributes("draft-lane-location-id")... }
								/>
								@FieldError(page.Errors, "draft-lane-location-id")
							</fieldset>
							<fieldset>
								<legend>Track</legend>
								<label for="draft-track-name">Name</label>
								<input
									id="draft-track-name"
									name="track_name"
									value={ page.draftValue("draft", 0, "track_name", "") }
									{ page.Errors.Attributes("draft-track-name")... }
								/>
								@FieldError(page.Errors, "draft-track-name")
							</fieldset>
							<fieldset>
								<legend>Session</legend>
								@planningDraftInput(page, "session_title", "Title", "text", "", false)
								@planningDraftInput(page, "session_speaker", "Speaker", "text", "", false)
								@planningDraftSelect(page, "session_type", "Type", []string{
									"Presentation", "Competition", "Break", "Activity",
									"Ceremony", "Performance", "Hold",
								}, "Presentation")
								@planningDraftSelect(page, "audience_visibility", "Audience visibility", []string{"Public", "CrewOnly"}, "Public")
								@planningDraftTextarea(page, "public_details", "Public details")
								@planningDraftTextarea(page, "crew_notes", "Crew notes")
								@planningDraftInput(page, "planned_start", "Planned start", "datetime-local", "", false)
								@planningDraftSelect(page, "planned_start_occurrence", "Planned start occurrence", []string{"", "Earlier", "Later"}, "")
								@planningDraftInput(page, "planned_end", "Planned end", "datetime-local", "", false)
								@planningDraftSelect(page, "planned_end_occurrence", "Planned end occurrence", []string{"", "Earlier", "Later"}, "")
								@planningDraftSelect(page, "timing_policy", "Timing policy", []string{"FixedEnd", "FixedDuration", "ManualEnd"}, "FixedEnd")
								@planningDraftInput(page, "minimum_duration", "Minimum duration", "text", "15m", false)
								@planningDraftSelect(page, "start_boundary", "Start boundary", []string{"Soft", "Hard"}, "Soft")
								@planningDraftSelect(page, "end_boundary", "End boundary", []string{"Soft", "Hard"}, "Soft")
								@planningDraftInput(page, "session_lane_id", "Current Draft Lane ID", "number", "", false)
								@planningDraftInput(page, "session_location_id", "Current Draft Location ID", "number", "", false)
								@planningDraftInput(page, "session_track_id", "Current Draft Track ID", "number", "", false)
								@planningDraftInput(page, "upload_deadline", "Presentation upload deadline", "datetime-local", "", false)
								@planningDraftSelect(page, "upload_deadline_occurrence", "Upload deadline occurrence", []string{"", "Earlier", "Later"}, "")
								@planningDraftInput(page, "submission_deadline", "Competition submission deadline", "datetime-local", "", false)
								@planningDraftSelect(page, "submission_deadline_occurrence", "Submission deadline occurrence", []string{"", "Earlier", "Later"}, "")
								@planningDraftSelect(page, "session_entry_default_disposition", "New Entry disposition", []string{"Pending", "Included", "Rejected"}, "Pending")
							</fieldset>
							<button type="submit">Apply Draft edit</button>
						</form>
					</details>
					<section>
						<h2>Materialized Draft</h2>
						for _, location := range page.Draft.Locations {
							<form class="stack" method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="draft"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								<input type="hidden" name="expected_draft_revision" value={ strconv.Itoa(page.Draft.DraftRevision) }/>
								<input type="hidden" name="location_id" value={ strconv.Itoa(location.ID) }/>
								<input type="hidden" name="base_location_name" value={ location.Name }/>
								<label for={ PlanningFieldID("location", location.ID, "location_name") }>
									Location #{ strconv.Itoa(location.ID) } name
								</label>
								<input
									id={ PlanningFieldID("location", location.ID, "location_name") }
									name="location_name"
									value={ page.draftValue("location", location.ID, "location_name", location.Name) }
									required
									{ page.Errors.Attributes(PlanningFieldID("location", location.ID, "location_name"))... }
								/>
								@FieldError(page.Errors, PlanningFieldID("location", location.ID, "location_name"))
								<button type="submit">Update Location</button>
							</form>
						}
						for _, lane := range page.Draft.Lanes {
							<form class="stack" method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="draft"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								<input type="hidden" name="expected_draft_revision" value={ strconv.Itoa(page.Draft.DraftRevision) }/>
								<input type="hidden" name="lane_id" value={ strconv.Itoa(lane.ID) }/>
								<input type="hidden" name="base_lane_name" value={ lane.Name }/>
								<input type="hidden" name="base_lane_location_id" value={ strconv.Itoa(lane.LocationID) }/>
								<label for={ PlanningFieldID("lane", lane.ID, "lane_name") }>
									Lane #{ strconv.Itoa(lane.ID) } name
								</label>
								<input
									id={ PlanningFieldID("lane", lane.ID, "lane_name") }
									name="lane_name"
									value={ page.draftValue("lane", lane.ID, "lane_name", lane.Name) }
									required
									{ page.Errors.Attributes(PlanningFieldID("lane", lane.ID, "lane_name"))... }
								/>
								@FieldError(page.Errors, PlanningFieldID("lane", lane.ID, "lane_name"))
								<label for={ PlanningFieldID("lane", lane.ID, "lane_location_id") }>Location ID</label>
								<input
									id={ PlanningFieldID("lane", lane.ID, "lane_location_id") }
									type="number"
									min="1"
									name="lane_location_id"
									value={ page.draftValue("lane", lane.ID, "lane_location_id", strconv.Itoa(lane.LocationID)) }
									required
									{ page.Errors.Attributes(PlanningFieldID("lane", lane.ID, "lane_location_id"))... }
								/>
								@FieldError(page.Errors, PlanningFieldID("lane", lane.ID, "lane_location_id"))
								<button type="submit">Update Lane</button>
							</form>
						}
						for _, track := range page.Draft.Tracks {
							<form class="stack" method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="draft"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								<input type="hidden" name="expected_draft_revision" value={ strconv.Itoa(page.Draft.DraftRevision) }/>
								<input type="hidden" name="track_id" value={ strconv.Itoa(track.ID) }/>
								<input type="hidden" name="base_track_name" value={ track.Name }/>
								<label for={ PlanningFieldID("track", track.ID, "track_name") }>
									Track #{ strconv.Itoa(track.ID) } name
								</label>
								<input
									id={ PlanningFieldID("track", track.ID, "track_name") }
									name="track_name"
									value={ page.draftValue("track", track.ID, "track_name", track.Name) }
									required
									{ page.Errors.Attributes(PlanningFieldID("track", track.ID, "track_name"))... }
								/>
								@FieldError(page.Errors, PlanningFieldID("track", track.ID, "track_name"))
								<button type="submit">Update Track</button>
							</form>
						}
						for _, session := range page.Draft.Sessions {
							<form class="stack" method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="draft"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								<input type="hidden" name="expected_draft_revision" value={ strconv.Itoa(page.Draft.DraftRevision) }/>
								<input type="hidden" name="session_id" value={ strconv.Itoa(session.ID) }/>
								<input type="hidden" name="base_session" value={ page.SessionBases[session.ID] }/>
								@planningEditInput(page, "session", session.ID, "session_title", "Session #" + strconv.Itoa(session.ID) + " title", "text", session.Title, true)
								@planningEditInput(page, "session", session.ID, "session_speaker", "Speaker", "text", session.Speaker, false)
								@planningEditSelect(page, "session", session.ID, "session_type", "Type", []string{
									"Presentation", "Competition", "Break", "Activity",
									"Ceremony", "Performance", "Hold",
								}, string(session.Type))
								@planningEditSelect(page, "session", session.ID, "audience_visibility", "Audience visibility", []string{"Public", "CrewOnly"}, string(session.AudienceVisibility))
								@planningEditTextarea(page, "session", session.ID, "public_details", "Public details", session.PublicDetails)
								@planningEditTextarea(page, "session", session.ID, "crew_notes", "Crew notes", session.CrewNotes)
								@planningEditInput(page, "session", session.ID, "planned_start", "Planned start", "datetime-local", planningDateTime(session.PlannedStart, page.Event.Timezone), true)
								<span>{ planningZone(session.PlannedStart, page.Event.Timezone) }</span>
								@planningEditSelect(page, "session", session.ID, "planned_start_occurrence", "Planned start occurrence", []string{"", "Earlier", "Later"}, "")
								@planningEditInput(page, "session", session.ID, "planned_end", "Planned end", "datetime-local", planningDateTime(session.PlannedEnd, page.Event.Timezone), true)
								<span>{ planningZone(session.PlannedEnd, page.Event.Timezone) }</span>
								@planningEditSelect(page, "session", session.ID, "planned_end_occurrence", "Planned end occurrence", []string{"", "Earlier", "Later"}, "")
								@planningEditSelect(page, "session", session.ID, "timing_policy", "Timing policy", []string{"FixedEnd", "FixedDuration", "ManualEnd"}, string(session.TimingPolicy))
								@planningEditInput(page, "session", session.ID, "minimum_duration", "Minimum duration", "text", session.MinimumDuration.String(), true)
								@planningEditSelect(page, "session", session.ID, "start_boundary", "Start boundary", []string{"Soft", "Hard"}, string(session.StartBoundary))
								@planningEditSelect(page, "session", session.ID, "end_boundary", "End boundary", []string{"Soft", "Hard"}, string(session.EndBoundary))
								@planningEditInput(page, "session", session.ID, "upload_deadline", "Presentation upload deadline", "datetime-local", planningDateTime(session.UploadDeadline, page.Event.Timezone), false)
								<span>{ planningZone(session.UploadDeadline, page.Event.Timezone) }</span>
								@planningEditSelect(page, "session", session.ID, "upload_deadline_occurrence", "Upload deadline occurrence", []string{"", "Earlier", "Later"}, "")
								@planningEditInput(page, "session", session.ID, "submission_deadline", "Competition submission deadline", "datetime-local", planningDateTime(session.SubmissionDeadline, page.Event.Timezone), false)
								<span>{ planningZone(session.SubmissionDeadline, page.Event.Timezone) }</span>
								@planningEditSelect(page, "session", session.ID, "submission_deadline_occurrence", "Submission deadline occurrence", []string{"", "Earlier", "Later"}, "")
								@planningEditSelect(page, "session", session.ID, "session_entry_default_disposition", "New Entry disposition", []string{"", "Pending", "Included"}, string(session.EntryDefault))
								<fieldset
									id={ PlanningFieldID("session", session.ID, "session_lane_ids") }
									{ page.Errors.Attributes(PlanningFieldID("session", session.ID, "session_lane_ids"))... }
								>
									<legend>Lanes</legend>
									for _, lane := range page.Draft.Lanes {
										<label>
											<input
												type="checkbox"
												name="session_lane_ids"
												value={ strconv.Itoa(lane.ID) }
												checked?={ page.draftChecked("session", session.ID, "session_lane_ids", strconv.Itoa(lane.ID), slices.Contains(session.LaneIDs, lane.ID)) }
											/>
											#{ strconv.Itoa(lane.ID) } { lane.Name }
										</label>
									}
								</fieldset>
								@FieldError(page.Errors, PlanningFieldID("session", session.ID, "session_lane_ids"))
								<fieldset
									id={ PlanningFieldID("session", session.ID, "session_location_ids") }
									{ page.Errors.Attributes(PlanningFieldID("session", session.ID, "session_location_ids"))... }
								>
									<legend>Locations</legend>
									for _, location := range page.Draft.Locations {
										<label>
											<input
												type="checkbox"
												name="session_location_ids"
												value={ strconv.Itoa(location.ID) }
												checked?={ page.draftChecked("session", session.ID, "session_location_ids", strconv.Itoa(location.ID), slices.Contains(session.LocationIDs, location.ID)) }
											/>
											#{ strconv.Itoa(location.ID) } { location.Name }
										</label>
									}
								</fieldset>
								@FieldError(page.Errors, PlanningFieldID("session", session.ID, "session_location_ids"))
								<fieldset
									id={ PlanningFieldID("session", session.ID, "session_track_ids") }
									{ page.Errors.Attributes(PlanningFieldID("session", session.ID, "session_track_ids"))... }
								>
									<legend>Tracks</legend>
									for _, track := range page.Draft.Tracks {
										<label>
											<input
												type="checkbox"
												name="session_track_ids"
												value={ strconv.Itoa(track.ID) }
												checked?={ page.draftChecked("session", session.ID, "session_track_ids", strconv.Itoa(track.ID), slices.Contains(session.TrackIDs, track.ID)) }
											/>
											#{ strconv.Itoa(track.ID) } { track.Name }
										</label>
									}
								</fieldset>
								@FieldError(page.Errors, PlanningFieldID("session", session.ID, "session_track_ids"))
								<button type="submit">Update Session</button>
							</form>
						}
					</section>
					<section>
						<h2>Draft review</h2>
						for _, failure := range page.CurrentPreview.ValidationFailures {
							@ErrorFlash(failure)
						}
						if len(page.CurrentPreview.Changes) == 0 {
							<p>No effective Draft changes.</p>
						} else {
							<ul>
								for _, change := range page.CurrentPreview.Changes {
									<li>
										Change #{ strconv.Itoa(change.ID) }:
										{ change.Status } { change.TargetType } { change.FactKey }
										{ change.CurrentValueJSON }
									</li>
								}
							</ul>
							if len(page.CurrentPreview.ChangeIDs) != 0 {
								<form method="post">
									<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
									<input type="hidden" name="action" value="publish-preview"/>
									<fieldset
										id="publish-changes"
										{ page.Errors.Attributes("publish-changes")... }
									>
										<legend>Draft changes</legend>
										for _, change := range page.CurrentPreview.Changes {
											if change.Status == "Effective" {
												<label>
													<input type="checkbox" name="change_id" value={ strconv.Itoa(change.ID) } checked/>
													Change #{ strconv.Itoa(change.ID) }
												</label>
											}
										}
									</fieldset>
									@FieldError(page.Errors, "publish-changes")
									<button type="submit">Preview publish</button>
								</form>
							}
						}
						if page.PublishPreview != nil {
							<h3>Confirm publish</h3>
							<div class="tiles">
								@Metric("Draft revision", strconv.Itoa(page.PublishPreview.DraftRevision))
								@Metric("Published revision", strconv.Itoa(page.PublishPreview.PublishedRevision))
							</div>
							for _, failure := range page.PublishPreview.ValidationFailures {
								@ErrorFlash(failure)
							}
							<ul>
								for _, change := range page.PublishPreview.Changes {
									<li>
										Change #{ strconv.Itoa(change.ID) }:
										{ change.TargetType } { change.FactKey } { change.CurrentValueJSON }
										if planningContains(page.PublishPreview.AutoIncludedChangeIDs, change.ID) {
											<strong>Automatically included dependency</strong>
										}
									</li>
								}
							</ul>
							if len(page.PublishPreview.AffectedStructure) != 0 {
								<p>Affected structure: { strings.Join(page.PublishPreview.AffectedStructure, ", ") }</p>
							}
							if len(page.PublishPreview.AffectedLanes) != 0 {
								<p>Affected Lanes: { strings.Join(page.PublishPreview.AffectedLanes, ", ") }</p>
							}
							if len(page.PublishPreview.AffectedDisplays) != 0 {
								<p>Affected Displays: { strings.Join(page.PublishPreview.AffectedDisplays, ", ") }</p>
							} else {
								<p>Affected Displays: none currently assigned.</p>
							}
							if len(page.PublishPreview.ValidationFailures) == 0 {
								<form method="post">
									<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
									<input type="hidden" name="action" value="publish"/>
									<input type="hidden" name="command_id" value={ page.CommandID }/>
									<input type="hidden" name="draft_revision" value={ strconv.Itoa(page.PublishPreview.DraftRevision) }/>
									<input type="hidden" name="published_revision" value={ strconv.Itoa(page.PublishPreview.PublishedRevision) }/>
									<input type="hidden" name="fingerprint" value={ page.PublishPreview.Fingerprint }/>
									for _, changeID := range page.PublishPreview.ChangeIDs {
										<input type="hidden" name="change_id" value={ strconv.Itoa(changeID) }/>
									}
									<label for="publish-note">Publish note</label>
									<textarea
										id="publish-note"
										name="publish_note"
										{ page.Errors.Attributes("publish-note")... }
									>{ page.Form.Get("publish_note") }</textarea>
									@FieldError(page.Errors, "publish-note")
									<button class="btn-commit" type="submit">Publish reviewed selection</button>
								</form>
							}
						}
					</section>
					<details open?={ strings.HasPrefix(page.SubmittedAction, "csv-") }>
						<summary>CSV import</summary>
						<form class="stack" method="post">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<input type="hidden" name="action" value="csv-preview"/>
							<label for="csv-mappings">Field mappings, one <code>source=target</code> per line</label>
							<textarea
								id="csv-mappings"
								name="csv_mappings"
								{ page.Errors.Attributes("csv-mappings")... }
							>{ page.CSVMappings }</textarea>
							@FieldError(page.Errors, "csv-mappings")
							<label for="csv-data">CSV data</label>
							<textarea
								id="csv-data"
								name="csv_data"
								{ page.Errors.Attributes("csv-data")... }
							>{ page.CSVData }</textarea>
							@FieldError(page.Errors, "csv-data")
							<button type="submit">Preview CSV import</button>
						</form>
						if page.CSVPreview != nil {
							@ImportProposals(page.CSVPreview.Proposals, page.CSVPreview.ValidationFailures)
							<form method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="csv-import"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								<input type="hidden" name="expected_draft_revision" value={ strconv.Itoa(page.CSVPreview.DraftRevision) }/>
								<input type="hidden" name="fingerprint" value={ page.CSVPreview.Fingerprint }/>
								<textarea hidden name="csv_mappings">{ page.CSVMappings }</textarea>
								<textarea hidden name="csv_data">{ page.CSVData }</textarea>
								<fieldset id="csv-proposal-ids" { page.Errors.Attributes("csv-proposal-ids")... }>
									<legend>Proposals to apply</legend>
									for _, proposal := range page.CSVPreview.Proposals {
										if proposal.Classification == rundown.CSVProposalAddition || proposal.Classification == rundown.CSVProposalUpdate {
											<label>
												<input
													type="checkbox"
													name="proposal_id"
													value={ proposal.ID }
													checked?={ page.SubmittedAction != "csv-import" || slices.Contains(page.Form["proposal_id"], proposal.ID) }
												/>
												Apply { proposal.ProposedValue }
											</label>
										}
									}
								</fieldset>
								@FieldError(page.Errors, "csv-proposal-ids")
								<button type="submit">Confirm CSV import</button>
							</form>
						}
					</details>
					<details open?={ strings.HasPrefix(page.SubmittedAction, "icalendar-") }>
						<summary>iCalendar import</summary>
						<form class="stack" method="post">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<input type="hidden" name="action" value="icalendar-preview"/>
							<label for="icalendar-choices">Occurrence choices, one <code>UID,PROPERTY,Earlier|Later</code> per line</label>
							<textarea
								id="icalendar-choices"
								name="icalendar_choices"
								{ page.Errors.Attributes("icalendar-choices")... }
							>{ page.ICalendarChoices }</textarea>
							@FieldError(page.Errors, "icalendar-choices")
							<label for="icalendar-data">iCalendar data</label>
							<textarea
								id="icalendar-data"
								name="icalendar_data"
								{ page.Errors.Attributes("icalendar-data")... }
							>{ page.ICalendarData }</textarea>
							@FieldError(page.Errors, "icalendar-data")
							<button type="submit">Preview iCalendar import</button>
						</form>
						if page.ICalendarPreview != nil {
							@ImportProposals(page.ICalendarPreview.Proposals, page.ICalendarPreview.ValidationFailures)
							for _, warning := range page.ICalendarPreview.Warnings {
								<p>{ warning }</p>
							}
							<form method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="icalendar-import"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								<input type="hidden" name="expected_draft_revision" value={ strconv.Itoa(page.ICalendarPreview.DraftRevision) }/>
								<input type="hidden" name="fingerprint" value={ page.ICalendarPreview.Fingerprint }/>
								<textarea hidden name="icalendar_choices">{ page.ICalendarChoices }</textarea>
								<textarea hidden name="icalendar_data">{ page.ICalendarData }</textarea>
								<fieldset id="icalendar-proposal-ids" { page.Errors.Attributes("icalendar-proposal-ids")... }>
									<legend>Proposals to apply</legend>
									for _, proposal := range page.ICalendarPreview.Proposals {
										if proposal.Classification == rundown.CSVProposalAddition || proposal.Classification == rundown.CSVProposalUpdate {
											<label>
												<input
													type="checkbox"
													name="proposal_id"
													value={ proposal.ID }
													checked?={ page.SubmittedAction != "icalendar-import" || slices.Contains(page.Form["proposal_id"], proposal.ID) }
												/>
												Apply { proposal.ProposedValue }
											</label>
										}
									}
								</fieldset>
								@FieldError(page.Errors, "icalendar-proposal-ids")
								<button type="submit">Confirm iCalendar import</button>
							</form>
						}
					</details>
				</main>
			</div>
			<script src={ EventTimePath } defer></script>
		</body>
	</html>
}

templ BackstageSessions(page BackstageSessionsPage) {
	<!doctype html>
	<html lang={ page.Event.EventLocale } data-locale={ page.Event.EventLocale }>
		@Head("Sessions and Competitions · " + page.Event.Name + " · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(page.Navigation)
				<main id="main-content" tabindex="-1">
					<h1>Sessions and Competitions</h1>
					<p>{ page.Event.Name } · { page.Role }</p>
					if page.Producer {
						<p>
							<a href={ templ.SafeURL(
								"/backstage/events/" + strconv.Itoa(page.Event.ID) + "/planning",
							) }>Plan and publish the Rundown</a>
						</p>
					}
					if len(page.Sessions) == 0 {
						<p role="status">No Sessions are available in your Event scope.</p>
					}
					for _, session := range page.Sessions {
						<article>
							<h2>{ session.Title }</h2>
							<p class="cluster">
								<span>{ humanizeIdentifier(string(session.Type)) }</span>
								@Badge(lifecycleTone(session.Lifecycle), string(session.Lifecycle))
							</p>
							if session.Type == rundown.SessionCompetition {
								if page.Manage[session.ID] {
									<a href={ templ.SafeURL(
										"/backstage/events/" + strconv.Itoa(page.Event.ID) +
										"/competitions/" + strconv.Itoa(session.ID) + "/entries",
									) }>Competition Entries and Attachments</a>
								} else {
									<p>Competition workflow is read-only for your Event Grant.</p>
								}
							}
							if session.Type == rundown.SessionPresentation && page.Producer {
								<a href={ templ.SafeURL(
									"/backstage/events/" + strconv.Itoa(page.Event.ID) +
									"/presentations/" + strconv.Itoa(session.ID) + "/submission",
								) }>Presentation Submitter and Attachments</a>
							}
						</article>
					}
				</main>
			</div>
		</body>
	</html>
}

templ ImportProposals(proposals []rundown.CSVImportProposal, failures []string) {
	for _, failure := range failures {
		@ErrorFlash(failure)
	}
	<ul>
		for _, proposal := range proposals {
			<li>
				{ proposal.Classification }:
				if proposal.ProposedValue != "" {
					{ proposal.ProposedValue }
				} else if proposal.Message != "" {
					{ proposal.Message }
				} else {
					{ proposal.RecordType }
				}
			</li>
		}
	</ul>
}

templ NewEvent(page NewEventPage) {
	<!doctype html>
	<html lang="en">
		@Head("Create Event · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(page.Navigation)
				<main id="main-content" tabindex="-1">
					<h1>Create Event</h1>
					if page.Error != "" {
						@ErrorFlash(page.Error)
					}
					<form class="stack" method="post">
						<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
						<input type="hidden" name="command_id" value={ page.CommandID }/>
						<input type="hidden" name="grant_command_id" value={ page.GrantCommandID }/>
						<label>Event name <input name="event_name" required/></label>
						<label>Planned start <input type="date" name="planned_start_date" required/></label>
						<label>Planned end <input type="date" name="planned_end_date" required/></label>
						<label>Timezone <input name="timezone" value="Etc/UTC" required/></label>
						<label>Event locale <input name="event_locale" value="en" required/></label>
						<label>Content language <input name="content_language"/></label>
						<label>Event day boundary <input type="time" name="event_day_boundary" value="00:00" required/></label>
						<label>New Competition Entry disposition
							<select name="entry_default_disposition">
								<option>Pending</option><option>Included</option>
							</select>
						</label>
						<label>New Competition Submission Eligibility
							<select name="submission_eligibility">
								<option value="AllAccounts">All Accounts</option>
								<option value="VotingEligibleAccounts">Voting Eligible Accounts</option>
							</select>
						</label>
						<label>Competition Voting Method
							<select name="voting_method"><option value="Range1To5">Range 1–5</option></select>
						</label>
						<label>Competition Self-Vote Policy
							<select name="self_vote_policy">
								<option value="Allowed">Allowed</option>
								<option value="Neutral">Neutral substitution</option>
							</select>
						</label>
						<label>Target adjustment presets in seconds
							<input name="target_adjustment_presets_seconds" value="-300,300,600"/>
						</label>
						<label>
							<input type="checkbox" name="grant_self" value="true" checked?={ page.GrantSelfDefault }/>
							Grant me Producer authority for this Event
						</label>
						<button type="submit">Create Event</button>
					</form>
				</main>
			</div>
		</body>
	</html>
}
