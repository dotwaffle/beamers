package frontend

import "fmt"
import "net/url"
import "strconv"
import "strings"
import "time"

import "github.com/dotwaffle/beamers/internal/themevalue"

// ThemeRevisionSummary identifies one immutable Revision in Backstage.
type ThemeRevisionSummary struct {
	ID        int
	CreatedAt time.Time
	Active    bool
}

// ThemePreview contains one exact Revision and its activation findings.
type ThemePreview struct {
	RevisionID int
	Config     themevalue.Config
	Findings   []themevalue.Finding
}

// ThemePage contains Installation Theme administration state.
type ThemePage struct {
	AccountName      string
	CSRFToken        string
	ReducedEffects   bool
	Navigation       BackstageNavigation
	ActiveRevisionID int
	Revisions        []ThemeRevisionSummary
	Preview          ThemePreview
	CreateCommandID  string
	ActivateCommandID string
	Form              url.Values
	Errors            FormErrors
}

func ThemeFieldID(field string) string {
	return "theme-" + strings.ReplaceAll(field, "_", "-")
}

func (page ThemePage) value(field, fallback string) string {
	if page.Form.Get("action") == "create-draft" {
		if _, ok := page.Form[field]; ok {
			return page.Form.Get(field)
		}
	}
	return fallback
}

func themeRevisionLabel(id int) string {
	if id == 0 {
		return "Built-in base Theme"
	}
	return "Theme Revision #" + strconv.Itoa(id)
}

func themePreviewStyle(config themevalue.Config) templ.SafeCSS {
	heading := `"Chakra Petch", sans-serif`
	if config.Typeface == themevalue.TypefaceClean {
		heading = `"Open Sans", system-ui, sans-serif`
	}
	backgroundImage := "radial-gradient(circle at 15% 10%, #172755 0, transparent 32rem)"
	if config.Background == themevalue.BackgroundSolid {
		backgroundImage = "none"
	}
	return templ.SafeCSS(fmt.Sprintf(
		"--preview-background:%s;--preview-surface:%s;--preview-border:%s;"+
			"--preview-text:%s;--preview-muted:%s;--preview-accent:%s;"+
			"--preview-link:%s;--preview-focus:%s;--preview-background-image:%s;"+
			"--preview-heading-font:%s;--preview-body-font:\"Open Sans\",system-ui,sans-serif",
		config.BackgroundColor,
		config.SurfaceColor,
		config.BorderColor,
		config.TextColor,
		config.MutedColor,
		config.AccentColor,
		config.LinkColor,
		config.FocusColor,
		backgroundImage,
		heading,
	))
}

templ ThemeAdministration(page ThemePage) {
	<!doctype html>
	<html lang="en">
		@Head("Installation Theme · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(page.Navigation)
				<main id="main-content" tabindex="-1">
					<h1>Installation Theme</h1>
					<p>Active: <strong>{ themeRevisionLabel(page.ActiveRevisionID) }</strong></p>
					@ErrorSummary(page.Errors)
					<section>
						<h2>Edit a new Draft Theme Revision</h2>
						<p>Only these documented controls are accepted. Saving always creates a new immutable Revision.</p>
						<form class="stack" method="post" action="/backstage/themes">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<input type="hidden" name="action" value="create-draft"/>
							<input type="hidden" name="command_id" value={ page.CreateCommandID }/>
							<label>
								Branding asset
								<select id={ ThemeFieldID("brand_asset") } name="brand_asset" { page.Errors.Attributes(ThemeFieldID("brand_asset"))... }>
									<option value="signal" selected?={ page.value("brand_asset", page.Preview.Config.BrandAsset) == themevalue.BrandAssetSignal }>Signal mark</option>
									<option value="wordmark" selected?={ page.value("brand_asset", page.Preview.Config.BrandAsset) == themevalue.BrandAssetWordmark }>Wordmark only</option>
								</select>
							</label>
							@FieldError(page.Errors, ThemeFieldID("brand_asset"))
							@ThemeColor(page, "Background color", "background_color", page.Preview.Config.BackgroundColor)
							@ThemeColor(page, "Surface color", "surface_color", page.Preview.Config.SurfaceColor)
							@ThemeColor(page, "Border color", "border_color", page.Preview.Config.BorderColor)
							@ThemeColor(page, "Text color", "text_color", page.Preview.Config.TextColor)
							@ThemeColor(page, "Muted text color", "muted_color", page.Preview.Config.MutedColor)
							@ThemeColor(page, "Accent color", "accent_color", page.Preview.Config.AccentColor)
							@ThemeColor(page, "Link color", "link_color", page.Preview.Config.LinkColor)
							@ThemeColor(page, "Focus color", "focus_color", page.Preview.Config.FocusColor)
							<label>
								Background
								<select id={ ThemeFieldID("background") } name="background" { page.Errors.Attributes(ThemeFieldID("background"))... }>
									<option value="nebula" selected?={ page.value("background", page.Preview.Config.Background) == themevalue.BackgroundNebula }>Built-in nebula</option>
									<option value="solid" selected?={ page.value("background", page.Preview.Config.Background) == themevalue.BackgroundSolid }>Solid</option>
								</select>
							</label>
							@FieldError(page.Errors, ThemeFieldID("background"))
							<label>
								Bundled type choice
								<select id={ ThemeFieldID("typeface") } name="typeface" { page.Errors.Attributes(ThemeFieldID("typeface"))... }>
									<option value="demoscene" selected?={ page.value("typeface", page.Preview.Config.Typeface) == themevalue.TypefaceDemoscene }>Chakra Petch headings and Open Sans body</option>
									<option value="clean" selected?={ page.value("typeface", page.Preview.Config.Typeface) == themevalue.TypefaceClean }>Open Sans throughout</option>
								</select>
							</label>
							@FieldError(page.Errors, ThemeFieldID("typeface"))
							<label>
								Transition
								<select id={ ThemeFieldID("transition") } name="transition" { page.Errors.Attributes(ThemeFieldID("transition"))... }>
									<option value="fade" selected?={ page.value("transition", page.Preview.Config.Transition) == themevalue.TransitionFade }>Fade</option>
									<option value="none" selected?={ page.value("transition", page.Preview.Config.Transition) == themevalue.TransitionNone }>None</option>
								</select>
							</label>
							@FieldError(page.Errors, ThemeFieldID("transition"))
							<label>
								Effect
								<select id={ ThemeFieldID("effect") } name="effect" { page.Errors.Attributes(ThemeFieldID("effect"))... }>
									<option value="starfield" selected?={ page.value("effect", page.Preview.Config.Effect) == themevalue.EffectStarfield }>Built-in starfield</option>
									<option value="none" selected?={ page.value("effect", page.Preview.Config.Effect) == themevalue.EffectNone }>None</option>
								</select>
							</label>
							@FieldError(page.Errors, ThemeFieldID("effect"))
							<label>
								Motion level
								<select id={ ThemeFieldID("motion") } name="motion" { page.Errors.Attributes(ThemeFieldID("motion"))... }>
									<option value="still" selected?={ page.value("motion", page.Preview.Config.Motion) == themevalue.MotionStill }>Still</option>
									<option value="subtle" selected?={ page.value("motion", page.Preview.Config.Motion) == themevalue.MotionSubtle }>Subtle</option>
									<option value="full" selected?={ page.value("motion", page.Preview.Config.Motion) == themevalue.MotionFull }>Full</option>
								</select>
							</label>
							@FieldError(page.Errors, ThemeFieldID("motion"))
							<button type="submit">Save, preview, and validate Draft</button>
						</form>
					</section>
					<section>
						<h2>{ themeRevisionLabel(page.Preview.RevisionID) } preview</h2>
						if len(page.Preview.Findings) == 0 {
							<p role="status">This Revision passes known activation checks.</p>
						} else {
							<p role="alert">Activation blockers:</p>
							<ul>
								for _, finding := range page.Preview.Findings {
									<li><code>{ finding.Field }</code>: { finding.Message }</li>
								}
							</ul>
						}
						<p class="theme-preview-controls">
							Brand: { page.Preview.Config.BrandAsset } ·
							Background: { page.Preview.Config.Background } ·
							Transition: { page.Preview.Config.Transition } ·
							Effect: { page.Preview.Config.Effect } ·
							Motion: { page.Preview.Config.Motion }
						</p>
						<div
							class="theme-preview-grid"
							style={ themePreviewStyle(page.Preview.Config) }
							data-brand-asset={ page.Preview.Config.BrandAsset }
							data-background={ page.Preview.Config.Background }
							data-transition={ page.Preview.Config.Transition }
							data-effect={ page.Preview.Config.Effect }
							data-motion={ page.Preview.Config.Motion }
						>
							<article class="theme-preview" data-theme-preview="public">
								if page.Preview.Config.BrandAsset == themevalue.BrandAssetSignal {
									<span aria-hidden="true">◆</span>
								}
								<h3>Public Profile</h3>
								<p class="theme-preview-muted">Released work and public Event information.</p>
								<span>Public link</span>
							</article>
							<article class="theme-preview" data-theme-preview="account">
								<h3>Account</h3>
								<p class="theme-preview-muted">Sign-in, Profile, submissions, and voting.</p>
								<span>Account link</span>
								<button type="button">Account action</button>
							</article>
							<article class="theme-preview" data-theme-preview="backstage">
								<h3>Backstage</h3>
								<p class="theme-preview-muted">Crew and installation administration.</p>
								<span>Backstage link</span>
							</article>
						</div>
						if page.Preview.RevisionID != page.ActiveRevisionID {
							<form method="post" action="/backstage/themes">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="activate"/>
								<input type="hidden" name="command_id" value={ page.ActivateCommandID }/>
								<input type="hidden" name="revision_id" value={ strconv.Itoa(page.Preview.RevisionID) }/>
								<input type="hidden" name="expected_active_revision_id" value={ strconv.Itoa(page.ActiveRevisionID) }/>
								<button
									id={ ThemeFieldID("activation_confirmation") }
									type="submit"
									disabled?={ len(page.Preview.Findings) != 0 }
									{ page.Errors.Attributes(ThemeFieldID("activation_confirmation"))... }
								>
									if page.Preview.RevisionID < page.ActiveRevisionID {
										Roll back to this exact Revision
									} else {
										Activate this Revision
									}
								</button>
								@FieldError(page.Errors, ThemeFieldID("activation_confirmation"))
							</form>
						}
					</section>
					<section>
						<h2>Immutable Revision history</h2>
						<ul>
							for _, revision := range page.Revisions {
								<li>
									<a href={ templ.SafeURL("/backstage/themes?revision=" + strconv.Itoa(revision.ID)) }>
										{ themeRevisionLabel(revision.ID) }
									</a>
									if revision.Active {
										<strong> — active</strong>
									}
									if !revision.CreatedAt.IsZero() {
										<span> — { revision.CreatedAt.UTC().Format(time.RFC3339) }</span>
									}
								</li>
							}
						</ul>
					</section>
				</main>
			</div>
		</body>
	</html>
}

templ ThemeColor(page ThemePage, label string, name string, fallback string) {
	<label>
		{ label }
		<input
			id={ ThemeFieldID(name) }
			type="color"
			name={ name }
			value={ page.value(name, fallback) }
			required
			{ page.Errors.Attributes(ThemeFieldID(name))... }
		/>
	</label>
	@FieldError(page.Errors, ThemeFieldID(name))
}
