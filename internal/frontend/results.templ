package frontend

import (
	"net/url"
	"slices"
	"strconv"
	"strings"

	"github.com/dotwaffle/beamers/internal/competition"
	"github.com/dotwaffle/beamers/internal/events"
	"github.com/dotwaffle/beamers/internal/results"
	"github.com/dotwaffle/beamers/internal/rundown"
)

type ResultsEntryPage struct {
	Entry    competition.Entry
	Standing results.Standing
}

type ResultsCompetitionPage struct {
	Session                rundown.CrewSession
	Draft                  results.Draft
	Entries                []ResultsEntryPage
	AssignedPrizegivingID int
	Correction             *ResultsCorrectionPage
}

type ResultsPrizegivingPage struct {
	Session    rundown.CrewSession
	Designated bool
	Plan       results.PrizegivingPlan
	Preview    *results.PrizegivingPreview
}

type ResultsCorrectionPage struct {
	Scope                   results.PublicationScope
	ScopeSessionID          int
	Current                 results.Correction
	PublicationRevision     int
	CorrectedResultsJSON    string
	PublicationHistoryCount int
}

type ResultsPage struct {
	AccountName     string
	CSRFToken      string
	ReducedEffects bool
	Navigation     BackstageNavigation
	CommandID      string
	Event          events.Event
	CanManage      bool
	Producer       bool
	Competitions   []ResultsCompetitionPage
	Prizegivings   []ResultsPrizegivingPage
	EventAwards    results.EventAwardsDraft
	EventAwardsPreflight *results.StandaloneEventAwardsPreflight
	SubmittedAction string
	Form            url.Values
	Errors          FormErrors
}

func ResultsFieldID(action string, targetID int, field string) string {
	prefix := strings.TrimPrefix(action, "save-")
	switch action {
	case "save-results-draft":
		prefix = "results"
	case "save-results-correction":
		prefix = "results-correction"
	case "save-prizegiving-plan":
		prefix = "prizegiving"
	case "save-competition-awards":
		prefix = "competition-awards"
	case "save-event-awards":
		prefix = "event-awards"
	}
	if targetID > 0 {
		prefix += "-" + strconv.Itoa(targetID)
	}
	return prefix + "-" + strings.ReplaceAll(field, "_", "-")
}

func (page ResultsPage) submitted(action string, targetID int) bool {
	if page.SubmittedAction != action {
		return false
	}
	field := "competition_session_id"
	switch action {
	case "save-prizegiving-plan":
		field = "ceremony_session_id"
	case "save-results-correction":
		field = "correction_scope_session_id"
	case "save-event-awards":
		return true
	}
	return page.Form.Get(field) == strconv.Itoa(targetID)
}

func (page ResultsPage) value(
	action string,
	targetID int,
	field, fallback string,
) string {
	if page.submitted(action, targetID) {
		if _, ok := page.Form[field]; ok {
			return page.Form.Get(field)
		}
	}
	return fallback
}

func (page ResultsPage) valueAt(
	action string,
	targetID int,
	field string,
	index int,
	fallback string,
) string {
	if page.submitted(action, targetID) {
		if values, ok := page.Form[field]; ok && index < len(values) {
			return values[index]
		}
	}
	return fallback
}

func (page ResultsPage) checked(
	action string,
	targetID int,
	field, value string,
	fallback bool,
) bool {
	if page.submitted(action, targetID) {
		return slices.Contains(page.Form[field], value)
	}
	return fallback
}

func (page ResultsPage) rowCount(
	action string,
	targetID int,
	fallback int,
	fields ...string,
) int {
	if !page.submitted(action, targetID) {
		return fallback
	}
	count := 0
	for _, field := range fields {
		if len(page.Form[field]) > count {
			count = len(page.Form[field])
		}
	}
	if count == 0 {
		return fallback
	}
	return count
}

func competitionAwardAt(awards []results.Award, index int) results.Award {
	if index < len(awards) {
		return awards[index]
	}
	return results.Award{}
}

func eventAwardAt(awards []results.EventAward, index int) results.EventAward {
	if index < len(awards) {
		return awards[index]
	}
	return results.EventAward{}
}

func resultsScoreValue(score results.ScoreValue) string {
	if score.Decimal != nil {
		return *score.Decimal
	}
	if score.Duration != nil {
		return score.Duration.String()
	}
	return ""
}

// resultsAwardRecipientEntryChecked reports whether one Entry is already an
// AwardRecipient, for the checkbox picker's initial render.
func resultsAwardRecipientEntryChecked(recipients []results.AwardRecipient, entryID int) bool {
	for _, recipient := range recipients {
		if recipient.EntryID == entryID {
			return true
		}
	}
	return false
}

// resultsAwardRecipientOption is one selectable Entry for an Award recipient
// picker: an ID paired with a label that disambiguates same-named Entries
// (Entry names are not unique, so the label always carries the Entry ID, and
// the Event-wide picker also carries the originating Competition's title).
type resultsAwardRecipientOption struct {
	ID    int
	Label string
}

// resultsEventEntries flattens every Entry across the Event's Competitions,
// so the Event Award recipient picker can name any Entry regardless of
// which Competition Session produced it. Each label carries the originating
// Competition title and the Entry ID, since Entry names repeat both within
// and across Competitions. The Workspace only lists Included, Eligible
// Entries, but store validation accepts any Entry belonging to the Event, so
// existingRecipients is unioned in (by Entry ID, using its stored
// DisplayName as the label) to keep a previously saved recipient selectable
// and visible even after it becomes Rejected, Withheld, or Disqualified.
func resultsEventEntries(
	competitions []ResultsCompetitionPage,
	existingRecipients []results.AwardRecipient,
) []resultsAwardRecipientOption {
	options := make([]resultsAwardRecipientOption, 0)
	seen := make(map[int]struct{})
	for _, page := range competitions {
		for _, entry := range page.Entries {
			options = append(options, resultsAwardRecipientOption{
				ID: entry.Entry.ID,
				Label: entry.Entry.Name + " — " + page.Session.Title +
					" (#" + strconv.Itoa(entry.Entry.ID) + ")",
			})
			seen[entry.Entry.ID] = struct{}{}
		}
	}
	options = append(options, resultsMissingRecipientOptions(existingRecipients, seen)...)
	return options
}

// resultsCompetitionEntries returns one Competition's Entries by Session ID,
// for the Competition Award recipient picker. Each label carries the Entry
// ID, since Entry names are not unique within a Competition. See
// resultsEventEntries for why existingRecipients must be unioned in.
func resultsCompetitionEntries(
	competitions []ResultsCompetitionPage,
	competitionID int,
	existingRecipients []results.AwardRecipient,
) []resultsAwardRecipientOption {
	for _, page := range competitions {
		if page.Session.ID == competitionID {
			options := make([]resultsAwardRecipientOption, 0, len(page.Entries))
			seen := make(map[int]struct{})
			for _, entry := range page.Entries {
				options = append(options, resultsAwardRecipientOption{
					ID:    entry.Entry.ID,
					Label: entry.Entry.Name + " (#" + strconv.Itoa(entry.Entry.ID) + ")",
				})
				seen[entry.Entry.ID] = struct{}{}
			}
			options = append(options, resultsMissingRecipientOptions(existingRecipients, seen)...)
			return options
		}
	}
	return nil
}

// resultsMissingRecipientOptions returns one picker option per Entry-linked
// recipient in existingRecipients whose Entry ID is not already in seen, so
// a recipient that fell out of the Workspace's Included/Eligible projection
// stays selectable instead of silently dropping out of the picker (and out
// of the saved Award) the next time the form is submitted.
func resultsMissingRecipientOptions(
	existingRecipients []results.AwardRecipient,
	seen map[int]struct{},
) []resultsAwardRecipientOption {
	options := make([]resultsAwardRecipientOption, 0)
	for _, recipient := range existingRecipients {
		if recipient.EntryID <= 0 {
			continue
		}
		if _, ok := seen[recipient.EntryID]; ok {
			continue
		}
		seen[recipient.EntryID] = struct{}{}
		label := recipient.DisplayName
		if label == "" {
			label = "Entry #" + strconv.Itoa(recipient.EntryID)
		}
		options = append(options, resultsAwardRecipientOption{
			ID:    recipient.EntryID,
			Label: label + " (no longer an eligible, included Entry)",
		})
	}
	return options
}

func resultsAwardRecipientNames(recipients []results.AwardRecipient) string {
	values := make([]string, 0, len(recipients))
	for _, recipient := range recipients {
		if recipient.DisplayName != "" {
			values = append(values, recipient.DisplayName)
		}
	}
	return strings.Join(values, "\n")
}

templ Results(page ResultsPage) {
	<!doctype html>
	<html lang={ page.Event.EventLocale } data-locale={ page.Event.EventLocale }>
		@Head("Results and Prizegiving · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(page.Navigation)
				<main id="main-content" tabindex="-1">
					<h1>Results and Prizegiving</h1>
					<p>{ page.Event.Name }</p>
					@ErrorSummary(page.Errors)
					if len(page.Competitions) == 0 {
						@EmptyState("No published Competitions are available.")
					}
					for _, competition := range page.Competitions {
						<section>
							<h2>{ competition.Session.Title }</h2>
							<p class="cluster">
								<span>Draft revision <code>{ strconv.Itoa(competition.Draft.Revision) }</code></span>
								@Badge(readinessTone(competition.Draft.Ready), readinessLabel(competition.Draft.Ready))
							</p>
							if competition.Draft.VotingTally != nil {
								<p>
									Voting Tally: { strconv.Itoa(competition.Draft.VotingTally.Participating) }
									participating Ballots; { competition.Draft.VotingTally.Method };
									Self-Vote Policy { competition.Draft.VotingTally.SelfVotePolicy }.
								</p>
								<ul>
									for _, entry := range competition.Draft.VotingTally.Entries {
										<li>
											Entry { strconv.Itoa(entry.EntryID) }:
											{ strconv.Itoa(entry.Total) } total from { strconv.Itoa(entry.Count) } Ballots.
										</li>
									}
								</ul>
							}
							if page.CanManage {
								<form method="post">
									<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
									<input type="hidden" name="action" value="save-results-draft"/>
									<input type="hidden" name="command_id" value={ page.CommandID }/>
									<input type="hidden" name="competition_session_id" value={ strconv.Itoa(competition.Session.ID) }/>
									<input type="hidden" name="expected_revision" value={ strconv.Itoa(competition.Draft.Revision) }/>
									<label for={ ResultsFieldID("save-results-draft", competition.Session.ID, "disposition") }>Disposition</label>
									<select
										id={ ResultsFieldID("save-results-draft", competition.Session.ID, "disposition") }
										name="disposition"
										{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "disposition"))... }
									>
										<option value={ string(results.Pending) } selected?={ page.value("save-results-draft", competition.Session.ID, "disposition", string(competition.Draft.Disposition)) == string(results.Pending) }>{ humanizeIdentifier(string(results.Pending)) }</option>
										<option value={ string(results.Publish) } selected?={ page.value("save-results-draft", competition.Session.ID, "disposition", string(competition.Draft.Disposition)) == string(results.Publish) }>{ humanizeIdentifier(string(results.Publish)) }</option>
										<option value={ string(results.NoPublicResults) } selected?={ page.value("save-results-draft", competition.Session.ID, "disposition", string(competition.Draft.Disposition)) == string(results.NoPublicResults) }>{ humanizeIdentifier(string(results.NoPublicResults)) }</option>
									</select>
									@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "disposition"))
									<label for={ ResultsFieldID("save-results-draft", competition.Session.ID, "no_public_reason") }>Crew Reason</label>
									<textarea
										id={ ResultsFieldID("save-results-draft", competition.Session.ID, "no_public_reason") }
										name="no_public_reason"
										{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "no_public_reason"))... }
									>{ page.value("save-results-draft", competition.Session.ID, "no_public_reason", competition.Draft.NoPublicReason) }</textarea>
									@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "no_public_reason"))
									if competition.Draft.VotingTally != nil {
										<label for={ ResultsFieldID("save-results-draft", competition.Session.ID, "tally_override_reason") }>Tally override Crew Reason</label>
										<textarea
											id={ ResultsFieldID("save-results-draft", competition.Session.ID, "tally_override_reason") }
											name="tally_override_reason"
											{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "tally_override_reason"))... }
										>{ page.value("save-results-draft", competition.Session.ID, "tally_override_reason", competition.Draft.TallyOverrideReason) }</textarea>
										@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "tally_override_reason"))
									}
									<label for={ ResultsFieldID("save-results-draft", competition.Session.ID, "public_explanation") }>Public explanation</label>
									<textarea
										id={ ResultsFieldID("save-results-draft", competition.Session.ID, "public_explanation") }
										name="public_explanation"
										{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "public_explanation"))... }
									>{ page.value("save-results-draft", competition.Session.ID, "public_explanation", competition.Draft.PublicExplanation) }</textarea>
									@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "public_explanation"))
									<fieldset>
										<legend>Score policy</legend>
										<label for={ ResultsFieldID("save-results-draft", competition.Session.ID, "score_type") }>Type</label>
										<select
											id={ ResultsFieldID("save-results-draft", competition.Session.ID, "score_type") }
											name="score_type"
											{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "score_type"))... }
										>
											<option value={ string(results.None) } selected?={ page.value("save-results-draft", competition.Session.ID, "score_type", string(competition.Draft.Score.Type)) == string(results.None) }>{ humanizeIdentifier(string(results.None)) }</option>
											<option value={ string(results.Decimal) } selected?={ page.value("save-results-draft", competition.Session.ID, "score_type", string(competition.Draft.Score.Type)) == string(results.Decimal) }>{ humanizeIdentifier(string(results.Decimal)) }</option>
											<option value={ string(results.Duration) } selected?={ page.value("save-results-draft", competition.Session.ID, "score_type", string(competition.Draft.Score.Type)) == string(results.Duration) }>{ humanizeIdentifier(string(results.Duration)) }</option>
										</select>
										@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "score_type"))
										<label for={ ResultsFieldID("save-results-draft", competition.Session.ID, "score_visibility") }>Visibility</label>
										<select
											id={ ResultsFieldID("save-results-draft", competition.Session.ID, "score_visibility") }
											name="score_visibility"
											{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "score_visibility"))... }
										>
											<option value={ string(results.ScorePublic) } selected?={ page.value("save-results-draft", competition.Session.ID, "score_visibility", string(competition.Draft.Score.Visibility)) == string(results.ScorePublic) }>{ humanizeIdentifier(string(results.ScorePublic)) }</option>
											<option value={ string(results.ScoreCrewOnly) } selected?={ page.value("save-results-draft", competition.Session.ID, "score_visibility", string(competition.Draft.Score.Visibility)) == string(results.ScoreCrewOnly) }>{ humanizeIdentifier(string(results.ScoreCrewOnly)) }</option>
										</select>
										@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "score_visibility"))
										<label for={ ResultsFieldID("save-results-draft", competition.Session.ID, "score_unit") }>Unit</label>
										<input
											id={ ResultsFieldID("save-results-draft", competition.Session.ID, "score_unit") }
											name="score_unit"
											value={ page.value("save-results-draft", competition.Session.ID, "score_unit", competition.Draft.Score.Unit) }
											{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "score_unit"))... }
										/>
										@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "score_unit"))
										<label for={ ResultsFieldID("save-results-draft", competition.Session.ID, "score_precision") }>Precision</label>
										<input
											id={ ResultsFieldID("save-results-draft", competition.Session.ID, "score_precision") }
											type="number"
											min="0"
											name="score_precision"
											value={ page.value("save-results-draft", competition.Session.ID, "score_precision", strconv.Itoa(competition.Draft.Score.Precision)) }
											{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "score_precision"))... }
										/>
										@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "score_precision"))
										<label for={ ResultsFieldID("save-results-draft", competition.Session.ID, "score_requirement") }>Requirement</label>
										<select
											id={ ResultsFieldID("save-results-draft", competition.Session.ID, "score_requirement") }
											name="score_requirement"
											{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "score_requirement"))... }
										>
											<option value={ string(results.ScoreOptional) } selected?={ page.value("save-results-draft", competition.Session.ID, "score_requirement", string(competition.Draft.Score.Requirement)) == string(results.ScoreOptional) }>{ humanizeIdentifier(string(results.ScoreOptional)) }</option>
											<option value={ string(results.ScoreRequired) } selected?={ page.value("save-results-draft", competition.Session.ID, "score_requirement", string(competition.Draft.Score.Requirement)) == string(results.ScoreRequired) }>{ humanizeIdentifier(string(results.ScoreRequired)) }</option>
										</select>
										@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "score_requirement"))
										<label for={ ResultsFieldID("save-results-draft", competition.Session.ID, "score_interpretation") }>Interpretation</label>
										<select
											id={ ResultsFieldID("save-results-draft", competition.Session.ID, "score_interpretation") }
											name="score_interpretation"
											{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "score_interpretation"))... }
										>
											<option value={ string(results.Informational) } selected?={ page.value("save-results-draft", competition.Session.ID, "score_interpretation", string(competition.Draft.Score.Interpretation)) == string(results.Informational) }>{ humanizeIdentifier(string(results.Informational)) }</option>
											<option value={ string(results.HigherWins) } selected?={ page.value("save-results-draft", competition.Session.ID, "score_interpretation", string(competition.Draft.Score.Interpretation)) == string(results.HigherWins) }>{ humanizeIdentifier(string(results.HigherWins)) }</option>
											<option value={ string(results.LowerWins) } selected?={ page.value("save-results-draft", competition.Session.ID, "score_interpretation", string(competition.Draft.Score.Interpretation)) == string(results.LowerWins) }>{ humanizeIdentifier(string(results.LowerWins)) }</option>
										</select>
										@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "score_interpretation"))
									</fieldset>
									<fieldset
										id={ ResultsFieldID("save-results-draft", competition.Session.ID, "result_standings") }
										{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "result_standings"))... }
									>
										<legend>Result Standings</legend>
										@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "result_standings"))
										for index, row := range competition.Entries {
											<fieldset>
												<legend>{ row.Entry.Name }</legend>
												<input type="hidden" name="standing_entry_id" value={ strconv.Itoa(row.Entry.ID) }/>
												<label for={ ResultsFieldID("save-results-draft", competition.Session.ID, "standing_"+strconv.Itoa(row.Entry.ID)) }>Standing</label>
												<select
													id={ ResultsFieldID("save-results-draft", competition.Session.ID, "standing_"+strconv.Itoa(row.Entry.ID)) }
													name="standing"
													{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "standing_"+strconv.Itoa(row.Entry.ID)))... }
												>
													<option value={ string(results.Placed) } selected?={ page.valueAt("save-results-draft", competition.Session.ID, "standing", index, string(row.Standing.Standing)) == string(results.Placed) }>{ humanizeIdentifier(string(results.Placed)) }</option>
													<option value={ string(results.Unplaced) } selected?={ page.valueAt("save-results-draft", competition.Session.ID, "standing", index, string(row.Standing.Standing)) == string(results.Unplaced) }>{ humanizeIdentifier(string(results.Unplaced)) }</option>
												</select>
												@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "standing_"+strconv.Itoa(row.Entry.ID)))
												<label for={ ResultsFieldID("save-results-draft", competition.Session.ID, "placement_"+strconv.Itoa(row.Entry.ID)) }>Placement</label>
												<input
													id={ ResultsFieldID("save-results-draft", competition.Session.ID, "placement_"+strconv.Itoa(row.Entry.ID)) }
													type="number"
													min="1"
													name="placement"
													value={ page.valueAt("save-results-draft", competition.Session.ID, "placement", index, strconv.Itoa(row.Standing.Placement)) }
													{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "placement_"+strconv.Itoa(row.Entry.ID)))... }
												/>
												@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "placement_"+strconv.Itoa(row.Entry.ID)))
												<label for={ ResultsFieldID("save-results-draft", competition.Session.ID, "display_order_"+strconv.Itoa(row.Entry.ID)) }>Display order</label>
												<input
													id={ ResultsFieldID("save-results-draft", competition.Session.ID, "display_order_"+strconv.Itoa(row.Entry.ID)) }
													type="number"
													min="1"
													name="display_order"
													value={ page.valueAt("save-results-draft", competition.Session.ID, "display_order", index, strconv.Itoa(row.Standing.DisplayOrder)) }
													required
													{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "display_order_"+strconv.Itoa(row.Entry.ID)))... }
												/>
												@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "display_order_"+strconv.Itoa(row.Entry.ID)))
												<label for={ ResultsFieldID("save-results-draft", competition.Session.ID, "score_"+strconv.Itoa(row.Entry.ID)) }>Score</label>
												<input
													id={ ResultsFieldID("save-results-draft", competition.Session.ID, "score_"+strconv.Itoa(row.Entry.ID)) }
													name="score"
													value={ page.valueAt("save-results-draft", competition.Session.ID, "score", index, resultsScoreValue(row.Standing.Score)) }
													{ page.Errors.Attributes(ResultsFieldID("save-results-draft", competition.Session.ID, "score_"+strconv.Itoa(row.Entry.ID)))... }
												/>
												@FieldError(page.Errors, ResultsFieldID("save-results-draft", competition.Session.ID, "score_"+strconv.Itoa(row.Entry.ID)))
											</fieldset>
										}
									</fieldset>
									<button type="submit">Save Results Draft</button>
								</form>
								<form method="post">
									<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
									<input type="hidden" name="action" value="save-competition-awards"/>
									<input type="hidden" name="command_id" value={ page.CommandID }/>
									<input type="hidden" name="competition_session_id" value={ strconv.Itoa(competition.Session.ID) }/>
									<input type="hidden" name="expected_revision" value={ strconv.Itoa(competition.Draft.Revision) }/>
									<fieldset
										id={ ResultsFieldID("save-competition-awards", competition.Session.ID, "award_details") }
										{ page.Errors.Attributes(ResultsFieldID("save-competition-awards", competition.Session.ID, "award_details"))... }
									>
										<legend>Competition Awards</legend>
										@FieldError(page.Errors, ResultsFieldID("save-competition-awards", competition.Session.ID, "award_details"))
										for index := range page.rowCount(
											"save-competition-awards",
											competition.Session.ID,
											len(competition.Draft.Awards) + 1,
											"award_key",
											"award_name",
											"award_recipient_entry_ids",
											"award_recipient_names",
											"award_promoted",
											"award_display_order",
										) {
											@CompetitionAwardFields(
												page,
												competition.Session.ID,
												competitionAwardAt(competition.Draft.Awards, index),
												index,
											)
										}
									</fieldset>
									<button type="submit">Save Competition Awards</button>
								</form>
							}
							if page.Producer && competition.Draft.Revision > 0 && !competition.Draft.Ready {
								<form method="post">
									<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
									<input type="hidden" name="action" value="mark-results-ready"/>
									<input type="hidden" name="command_id" value={ page.CommandID }/>
									<input type="hidden" name="competition_session_id" value={ strconv.Itoa(competition.Session.ID) }/>
									<input type="hidden" name="expected_revision" value={ strconv.Itoa(competition.Draft.Revision) }/>
									<button type="submit">Mark exact revision Ready</button>
								</form>
							}
							if page.Producer && competition.Draft.Ready && competition.AssignedPrizegivingID == 0 {
								<form method="post">
									<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
									<input type="hidden" name="action" value="release-standalone-results"/>
									<input type="hidden" name="command_id" value={ page.CommandID }/>
									<input type="hidden" name="competition_session_id" value={ strconv.Itoa(competition.Session.ID) }/>
									<button type="submit">Release standalone Results</button>
								</form>
							}
							if competition.Correction != nil {
								@ResultsCorrection(page, *competition.Correction)
							}
						</section>
					}
					for _, prizegiving := range page.Prizegivings {
						<section>
							<h2>{ prizegiving.Session.Title } Prizegiving</h2>
							if !prizegiving.Designated {
								if page.Producer {
									<form method="post">
										<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
										<input type="hidden" name="action" value="designate-prizegiving"/>
										<input type="hidden" name="command_id" value={ page.CommandID }/>
										<input type="hidden" name="ceremony_session_id" value={ strconv.Itoa(prizegiving.Session.ID) }/>
										<button type="submit">Designate Prizegiving</button>
									</form>
								}
							} else {
								<p class="cluster">
									<span>Plan revision <code>{ strconv.Itoa(prizegiving.Plan.Revision) }</code></span>
									@Badge(lockedTone(prizegiving.Plan.Locked), lockedLabel(prizegiving.Plan.Locked))
								</p>
								if page.Producer && !prizegiving.Plan.Locked {
									<form method="post">
										<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
										<input type="hidden" name="action" value="save-prizegiving-plan"/>
										<input type="hidden" name="command_id" value={ page.CommandID }/>
										<input type="hidden" name="ceremony_session_id" value={ strconv.Itoa(prizegiving.Session.ID) }/>
										<input type="hidden" name="expected_revision" value={ strconv.Itoa(prizegiving.Plan.Revision) }/>
										<fieldset>
											<legend>Competition assignments</legend>
											for _, competition := range page.Competitions {
												<label>
													<input
													type="checkbox"
													name="plan_competition_session_id"
													value={ strconv.Itoa(competition.Session.ID) }
													checked?={ page.checked(
														"save-prizegiving-plan",
														prizegiving.Session.ID,
														"plan_competition_session_id",
														strconv.Itoa(competition.Session.ID),
														slices.Contains(prizegiving.Plan.CompetitionSessionIDs, competition.Session.ID),
													) }
													/>
													{ competition.Session.Title }
												</label>
											}
										</fieldset>
										<label>Release policy
											<select
												id={ ResultsFieldID("save-prizegiving-plan", prizegiving.Session.ID, "release_policy") }
												name="release_policy"
												{ page.Errors.Attributes(ResultsFieldID("save-prizegiving-plan", prizegiving.Session.ID, "release_policy"))... }
											>
												<option value={ string(results.ResultsProgressiveOnReveal) } selected?={ page.value("save-prizegiving-plan", prizegiving.Session.ID, "release_policy", string(prizegiving.Plan.ReleasePolicy)) == string(results.ResultsProgressiveOnReveal) }>{ humanizeIdentifier(string(results.ResultsProgressiveOnReveal)) }</option>
												<option value={ string(results.ResultsAllAtCue) } selected?={ page.value("save-prizegiving-plan", prizegiving.Session.ID, "release_policy", string(prizegiving.Plan.ReleasePolicy)) == string(results.ResultsAllAtCue) }>{ humanizeIdentifier(string(results.ResultsAllAtCue)) }</option>
												<option value={ string(results.ResultsAtCeremonyEnd) } selected?={ page.value("save-prizegiving-plan", prizegiving.Session.ID, "release_policy", string(prizegiving.Plan.ReleasePolicy)) == string(results.ResultsAtCeremonyEnd) }>{ humanizeIdentifier(string(results.ResultsAtCeremonyEnd)) }</option>
											</select>
										</label>
										@FieldError(page.Errors, ResultsFieldID("save-prizegiving-plan", prizegiving.Session.ID, "release_policy"))
										if len(prizegiving.Plan.Sequence) == 0 {
											<p>Saving assignments creates the default sequence and publication order.</p>
										} else {
											<fieldset>
												<legend>Sequence and Reveal Methods</legend>
												for index, item := range prizegiving.Plan.Sequence {
													@PrizegivingItemFields(page, prizegiving.Session.ID, item, prizegiving.Plan.PublicationOrder, index)
												}
											</fieldset>
										}
										<label>
											Results text template revision
											<input
												id={ ResultsFieldID("save-prizegiving-plan", prizegiving.Session.ID, "results_text_template_revision") }
												type="number"
												min="1"
												name="results_text_template_revision"
												value={ page.value("save-prizegiving-plan", prizegiving.Session.ID, "results_text_template_revision", strconv.Itoa(prizegiving.Plan.Template.Revision)) }
												required
												{ page.Errors.Attributes(ResultsFieldID("save-prizegiving-plan", prizegiving.Session.ID, "results_text_template_revision"))... }
											/>
										</label>
										@FieldError(page.Errors, ResultsFieldID("save-prizegiving-plan", prizegiving.Session.ID, "results_text_template_revision"))
										<label>
											Results text template
											<textarea
												id={ ResultsFieldID("save-prizegiving-plan", prizegiving.Session.ID, "results_text_template") }
												name="results_text_template"
												required
												{ page.Errors.Attributes(ResultsFieldID("save-prizegiving-plan", prizegiving.Session.ID, "results_text_template"))... }
											>{ page.value("save-prizegiving-plan", prizegiving.Session.ID, "results_text_template", prizegiving.Plan.Template.Source) }</textarea>
										</label>
										@FieldError(page.Errors, ResultsFieldID("save-prizegiving-plan", prizegiving.Session.ID, "results_text_template"))
										<button type="submit">Save Prizegiving plan</button>
									</form>
								}
								if page.Producer && prizegiving.Plan.Revision > 0 && !prizegiving.Plan.Locked {
									<form method="post">
										<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
										<input type="hidden" name="action" value="run-prizegiving-preflight"/>
										<input type="hidden" name="command_id" value={ page.CommandID }/>
										<input type="hidden" name="ceremony_session_id" value={ strconv.Itoa(prizegiving.Session.ID) }/>
										<input type="hidden" name="expected_revision" value={ strconv.Itoa(prizegiving.Plan.Revision) }/>
										<button type="submit">Run Prizegiving Preflight</button>
									</form>
								}
								if prizegiving.Plan.Locked {
									<p><a href={ resultsPreviewPath(page.Event.ID, prizegiving.Session.ID, results.PrizegivingPreviewModePreview) }>Preview locked Results</a></p>
									<p><a href={ resultsPreviewPath(page.Event.ID, prizegiving.Session.ID, results.PrizegivingPreviewModeRehearsal) }>Rehearse locked Results</a></p>
									<p><a href={ programControlPath(page.Event.ID, prizegiving.Session.ID) }>Open Prizegiving Program Control</a></p>
									if page.Producer && prizegiving.Plan.ReleasePolicy == results.ResultsAllAtCue {
										<form method="post">
											<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
											<input type="hidden" name="action" value="fire-prizegiving-cue"/>
											<input type="hidden" name="command_id" value={ page.CommandID }/>
											<input type="hidden" name="ceremony_session_id" value={ strconv.Itoa(prizegiving.Session.ID) }/>
											<button type="submit">Release Results at cue</button>
										</form>
									}
								}
								if prizegiving.Preview != nil {
									<article>
										<h3>{ humanizeIdentifier(string(prizegiving.Preview.Mode)) }</h3>
										<p><strong>{ prizegiving.Preview.Watermark }</strong></p>
										<pre>{ prizegiving.Preview.ResultsText }</pre>
									</article>
								}
							}
						</section>
					}
					<section>
						<h2>Event Awards</h2>
						<p>Draft revision { strconv.Itoa(page.EventAwards.Revision) }.</p>
						if page.CanManage {
							<form method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="save-event-awards"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								<input type="hidden" name="expected_revision" value={ strconv.Itoa(page.EventAwards.Revision) }/>
								<fieldset
									id={ ResultsFieldID("save-event-awards", 0, "award_details") }
									{ page.Errors.Attributes(ResultsFieldID("save-event-awards", 0, "award_details"))... }
								>
									<legend>Event Award details</legend>
									@FieldError(page.Errors, ResultsFieldID("save-event-awards", 0, "award_details"))
									for index := range page.rowCount(
										"save-event-awards",
										0,
										len(page.EventAwards.Awards) + 1,
										"event_award_key",
										"event_award_name",
										"event_award_recipient_entry_ids",
										"event_award_recipient_names",
										"event_award_path",
										"event_award_display_order",
									) {
										@EventAwardFields(
											page,
											eventAwardAt(page.EventAwards.Awards, index),
											page.Prizegivings,
											index,
										)
									}
								</fieldset>
								<button type="submit">Save Event Awards</button>
							</form>
						}
						for _, state := range page.EventAwards.PathStates {
							<p class="cluster">
								<span>{ humanizeIdentifier(string(state.ReleasePath.Kind)) } path revision <code>{ strconv.Itoa(state.Revision) }</code></span>
								@Badge(readinessTone(state.Ready), readinessLabel(state.Ready))
							</p>
							if page.Producer && !state.Ready {
								<form method="post">
									<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
									<input type="hidden" name="action" value="mark-event-awards-ready"/>
									<input type="hidden" name="command_id" value={ page.CommandID }/>
									<input type="hidden" name="expected_revision" value={ strconv.Itoa(page.EventAwards.Revision) }/>
									<input type="hidden" name="event_award_path_kind" value={ string(state.ReleasePath.Kind) }/>
									<input type="hidden" name="event_award_path_prizegiving_session_id" value={ strconv.Itoa(state.ReleasePath.PrizegivingSessionID) }/>
									<input type="hidden" name="expected_path_revision" value={ strconv.Itoa(state.Revision) }/>
									<button type="submit">Mark Event Awards path Ready</button>
								</form>
							}
							if page.Producer && state.Ready && state.ReleasePath.Kind == results.StandaloneRelease {
								<form method="post">
									<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
									<input type="hidden" name="action" value="release-standalone-event-awards"/>
									<input type="hidden" name="command_id" value={ page.CommandID }/>
									<input type="hidden" name="expected_revision" value={ strconv.Itoa(page.EventAwards.Revision) }/>
									<input type="hidden" name="expected_path_revision" value={ strconv.Itoa(state.Revision) }/>
									<button type="submit">Release standalone Event Awards</button>
								</form>
							}
						}
						if page.Producer {
							<p><a href={ resultsEventAwardsPreflightPath(page.Event.ID) }>Preflight standalone Event Awards</a></p>
						}
						if page.EventAwardsPreflight != nil {
							if len(page.EventAwardsPreflight.Findings) == 0 {
								<p>Standalone Event Awards Preflight passed without changing release state.</p>
							} else {
								for _, finding := range page.EventAwardsPreflight.Findings {
									@ErrorFlash(finding.Code + ": " + finding.Message)
								}
							}
						}
					</section>
				</main>
			</div>
		</body>
	</html>
}

func resultsEventAwardsPreflightPath(eventID int) string {
	return "/backstage/events/" + strconv.Itoa(eventID) +
		"/results?event_awards_preflight=true"
}

// readinessLabel and readinessTone name and tone a Ready boolean as a badge,
// so it is never confused for an internal Go value. Ready is orthogonal to
// the adjacent Draft/Published revision language, so the false case reads
// "Not Ready" rather than "Draft" -- reusing "Draft" here would collide with
// the lifecycle-stage noun printed beside it and lose the readiness signal.
func readinessLabel(ready bool) string {
	if ready {
		return "Ready"
	}
	return "Not Ready"
}

func readinessTone(ready bool) string {
	if ready {
		return "success"
	}
	return "draft"
}

// lockedLabel and lockedTone name and tone a Prizegiving Plan's Locked
// boolean as a badge.
func lockedLabel(locked bool) string {
	if locked {
		return "Locked"
	}
	return "Unlocked"
}

func lockedTone(locked bool) string {
	if locked {
		return "warning"
	}
	return "neutral"
}

// correctionStatusTone maps a Correction's review status onto a badge tone.
func correctionStatusTone(status results.CorrectionStatus) string {
	switch status {
	case results.CorrectionReady:
		return "success"
	case results.CorrectionPublished:
		return "ended"
	default:
		return "draft"
	}
}

func resultsEventAwardPrizegivingPath(ceremonyID int) string {
	return "Prizegiving:" + strconv.Itoa(ceremonyID)
}

func resultsEventAwardPathValue(award results.EventAward) string {
	if award.ReleasePath.Kind == results.PrizegivingRelease {
		return resultsEventAwardPrizegivingPath(
			award.ReleasePath.PrizegivingSessionID,
		)
	}
	return string(results.StandaloneRelease)
}

func resultsAwardDisplayOrder(order, index int) string {
	if order > 0 {
		return strconv.Itoa(order)
	}
	return strconv.Itoa(index + 1)
}

templ EventAwardFields(
	page ResultsPage,
	award results.EventAward,
	prizegivings []ResultsPrizegivingPage,
	index int,
) {
	<fieldset>
		<legend>
			if page.valueAt("save-event-awards", 0, "event_award_name", index, award.Name) == "" {
				New Event Award
			} else {
				{ page.valueAt("save-event-awards", 0, "event_award_name", index, award.Name) }
			}
		</legend>
		<label for={ ResultsFieldID("save-event-awards", 0, "event_award_key_"+strconv.Itoa(index)) }>Key</label>
		<input
			id={ ResultsFieldID("save-event-awards", 0, "event_award_key_"+strconv.Itoa(index)) }
			name="event_award_key"
			value={ page.valueAt("save-event-awards", 0, "event_award_key", index, award.Key) }
			{ page.Errors.Attributes(ResultsFieldID("save-event-awards", 0, "event_award_key_"+strconv.Itoa(index)))... }
		/>
		@FieldError(page.Errors, ResultsFieldID("save-event-awards", 0, "event_award_key_"+strconv.Itoa(index)))
		<label for={ ResultsFieldID("save-event-awards", 0, "event_award_name_"+strconv.Itoa(index)) }>Name</label>
		<input
			id={ ResultsFieldID("save-event-awards", 0, "event_award_name_"+strconv.Itoa(index)) }
			name="event_award_name"
			value={ page.valueAt("save-event-awards", 0, "event_award_name", index, award.Name) }
			{ page.Errors.Attributes(ResultsFieldID("save-event-awards", 0, "event_award_name_"+strconv.Itoa(index)))... }
		/>
		@FieldError(page.Errors, ResultsFieldID("save-event-awards", 0, "event_award_name_"+strconv.Itoa(index)))
		<fieldset
			id={ ResultsFieldID("save-event-awards", 0, "event_award_recipient_entry_ids_"+strconv.Itoa(index)) }
			{ page.Errors.Attributes(ResultsFieldID("save-event-awards", 0, "event_award_recipient_entry_ids_"+strconv.Itoa(index)))... }
		>
			<legend>Recipient Entries</legend>
			for _, option := range resultsEventEntries(page.Competitions, award.Recipients) {
				<label>
					<input
						type="checkbox"
						name={ "event_award_recipient_entry_ids_" + strconv.Itoa(index) }
						value={ strconv.Itoa(option.ID) }
						checked?={ page.checked("save-event-awards", 0, "event_award_recipient_entry_ids_"+strconv.Itoa(index), strconv.Itoa(option.ID), resultsAwardRecipientEntryChecked(award.Recipients, option.ID)) }
					/>
					{ option.Label }
				</label>
			}
		</fieldset>
		@FieldError(page.Errors, ResultsFieldID("save-event-awards", 0, "event_award_recipient_entry_ids_"+strconv.Itoa(index)))
		<label for={ ResultsFieldID("save-event-awards", 0, "event_award_recipient_names_"+strconv.Itoa(index)) }>Other recipient names, one per line</label>
		<textarea
			id={ ResultsFieldID("save-event-awards", 0, "event_award_recipient_names_"+strconv.Itoa(index)) }
			name="event_award_recipient_names"
			{ page.Errors.Attributes(ResultsFieldID("save-event-awards", 0, "event_award_recipient_names_"+strconv.Itoa(index)))... }
		>{ page.valueAt("save-event-awards", 0, "event_award_recipient_names", index, resultsAwardRecipientNames(award.Recipients)) }</textarea>
		@FieldError(page.Errors, ResultsFieldID("save-event-awards", 0, "event_award_recipient_names_"+strconv.Itoa(index)))
		<label for={ ResultsFieldID("save-event-awards", 0, "event_award_path_"+strconv.Itoa(index)) }>Release path</label>
			<select
				id={ ResultsFieldID("save-event-awards", 0, "event_award_path_"+strconv.Itoa(index)) }
				name="event_award_path"
				{ page.Errors.Attributes(ResultsFieldID("save-event-awards", 0, "event_award_path_"+strconv.Itoa(index)))... }
			>
				<option value="Standalone" selected?={ page.valueAt("save-event-awards", 0, "event_award_path", index, resultsEventAwardPathValue(award)) == string(results.StandaloneRelease) }>Standalone</option>
				for _, prizegiving := range prizegivings {
						if prizegiving.Designated {
							<option
								value={ resultsEventAwardPrizegivingPath(prizegiving.Session.ID) }
								selected?={ page.valueAt("save-event-awards", 0, "event_award_path", index, resultsEventAwardPathValue(award)) == resultsEventAwardPrizegivingPath(prizegiving.Session.ID) }
							>Prizegiving: { prizegiving.Session.Title }</option>
					}
				}
			</select>
		@FieldError(page.Errors, ResultsFieldID("save-event-awards", 0, "event_award_path_"+strconv.Itoa(index)))
		<label for={ ResultsFieldID("save-event-awards", 0, "event_award_display_order_"+strconv.Itoa(index)) }>Display order</label>
		<input
			id={ ResultsFieldID("save-event-awards", 0, "event_award_display_order_"+strconv.Itoa(index)) }
			type="number"
			min="1"
			name="event_award_display_order"
			value={ page.valueAt("save-event-awards", 0, "event_award_display_order", index, resultsAwardDisplayOrder(award.DisplayOrder, index)) }
			{ page.Errors.Attributes(ResultsFieldID("save-event-awards", 0, "event_award_display_order_"+strconv.Itoa(index)))... }
		/>
		@FieldError(page.Errors, ResultsFieldID("save-event-awards", 0, "event_award_display_order_"+strconv.Itoa(index)))
	</fieldset>
}

templ ResultsCorrection(page ResultsPage, correction ResultsCorrectionPage) {
	<section>
		<h3>Results Correction</h3>
		<p>
			Publication revision <code>{ strconv.Itoa(correction.PublicationRevision) }</code>.
			Preserved releases: { strconv.Itoa(correction.PublicationHistoryCount) }.
		</p>
		if correction.Current.Revision > 0 {
			<p class="cluster">
				<span>Correction revision <code>{ strconv.Itoa(correction.Current.Revision) }</code></span>
				@Badge(correctionStatusTone(correction.Current.Status), string(correction.Current.Status))
			</p>
		}
		if page.Producer && correction.Current.Status != results.CorrectionReady {
			<form method="post">
				<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
				<input type="hidden" name="action" value="save-results-correction"/>
				<input type="hidden" name="command_id" value={ page.CommandID }/>
				<input type="hidden" name="correction_scope" value={ string(correction.Scope) }/>
				<input type="hidden" name="correction_scope_session_id" value={ strconv.Itoa(correction.ScopeSessionID) }/>
				<input type="hidden" name="expected_correction_revision" value={ strconv.Itoa(correction.Current.Revision) }/>
				<input type="hidden" name="base_publication_revision" value={ strconv.Itoa(correction.PublicationRevision) }/>
				<label for={ ResultsFieldID("save-results-correction", correction.ScopeSessionID, "corrected_results_json") }>Corrected Results JSON</label>
				<textarea
					id={ ResultsFieldID("save-results-correction", correction.ScopeSessionID, "corrected_results_json") }
					name="corrected_results_json"
					required
					{ page.Errors.Attributes(ResultsFieldID("save-results-correction", correction.ScopeSessionID, "corrected_results_json"))... }
				>{ page.value("save-results-correction", correction.ScopeSessionID, "corrected_results_json", correction.CorrectedResultsJSON) }</textarea>
				@FieldError(page.Errors, ResultsFieldID("save-results-correction", correction.ScopeSessionID, "corrected_results_json"))
				<label for={ ResultsFieldID("save-results-correction", correction.ScopeSessionID, "crew_reason") }>Crew Reason</label>
				<textarea
					id={ ResultsFieldID("save-results-correction", correction.ScopeSessionID, "crew_reason") }
					name="crew_reason"
					required
					{ page.Errors.Attributes(ResultsFieldID("save-results-correction", correction.ScopeSessionID, "crew_reason"))... }
				>{ page.value("save-results-correction", correction.ScopeSessionID, "crew_reason", correction.Current.Proposal.CrewReason) }</textarea>
				@FieldError(page.Errors, ResultsFieldID("save-results-correction", correction.ScopeSessionID, "crew_reason"))
				<label for={ ResultsFieldID("save-results-correction", correction.ScopeSessionID, "public_note") }>Public note</label>
				<textarea
					id={ ResultsFieldID("save-results-correction", correction.ScopeSessionID, "public_note") }
					name="public_note"
					{ page.Errors.Attributes(ResultsFieldID("save-results-correction", correction.ScopeSessionID, "public_note"))... }
				>{ page.value("save-results-correction", correction.ScopeSessionID, "public_note", correction.Current.Proposal.PublicNote) }</textarea>
				@FieldError(page.Errors, ResultsFieldID("save-results-correction", correction.ScopeSessionID, "public_note"))
				<button type="submit">Save Results Correction</button>
			</form>
		}
		if page.Producer && correction.Current.Status == results.CorrectionDraft {
			<form method="post">
				<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
				<input type="hidden" name="action" value="review-results-correction"/>
				<input type="hidden" name="command_id" value={ page.CommandID }/>
				<input type="hidden" name="correction_scope" value={ string(correction.Scope) }/>
				<input type="hidden" name="correction_scope_session_id" value={ strconv.Itoa(correction.ScopeSessionID) }/>
				<input type="hidden" name="expected_correction_revision" value={ strconv.Itoa(correction.Current.Revision) }/>
				<button type="submit">Mark Correction Ready</button>
			</form>
		}
		if page.Producer && correction.Current.Status == results.CorrectionReady {
			<form method="post">
				<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
				<input type="hidden" name="action" value="publish-results-correction"/>
				<input type="hidden" name="command_id" value={ page.CommandID }/>
				<input type="hidden" name="correction_scope" value={ string(correction.Scope) }/>
				<input type="hidden" name="correction_scope_session_id" value={ strconv.Itoa(correction.ScopeSessionID) }/>
				<input type="hidden" name="expected_correction_revision" value={ strconv.Itoa(correction.Current.Revision) }/>
				<button class="btn-commit" type="submit">Publish Results Correction</button>
			</form>
		}
	</section>
}

func resultsPreviewPath(eventID, ceremonyID int, mode results.PrizegivingPreviewMode) string {
	return "/backstage/events/" + strconv.Itoa(eventID) + "/results?ceremony_id=" +
		strconv.Itoa(ceremonyID) + "&preview=" + string(mode)
}

func prizegivingPublicationOrder(
	sequence results.ResultItem,
	publication []results.ResultItemRef,
	fallback int,
) int {
	for _, item := range publication {
		if item.Kind == sequence.Kind &&
			item.CompetitionSessionID == sequence.CompetitionSessionID &&
			item.AwardKey == sequence.AwardKey {
			return item.DisplayOrder
		}
	}
	return fallback + 1
}

templ PrizegivingItemFields(
	page ResultsPage,
	ceremonyID int,
	item results.ResultItem,
	publication []results.ResultItemRef,
	index int,
) {
	<fieldset>
		<legend>{ humanizeIdentifier(string(item.Kind)) }</legend>
		<input type="hidden" name="item_kind" value={ string(item.Kind) }/>
		<input type="hidden" name="item_competition_session_id" value={ strconv.Itoa(item.CompetitionSessionID) }/>
		<input type="hidden" name="item_award_key" value={ item.AwardKey }/>
		<label for={ ResultsFieldID("save-prizegiving-plan", ceremonyID, "sequence_display_order_"+strconv.Itoa(index)) }>Sequence order</label>
		<input
			id={ ResultsFieldID("save-prizegiving-plan", ceremonyID, "sequence_display_order_"+strconv.Itoa(index)) }
			type="number"
			min="1"
			name="sequence_display_order"
			value={ page.valueAt("save-prizegiving-plan", ceremonyID, "sequence_display_order", index, strconv.Itoa(item.DisplayOrder)) }
			required
			{ page.Errors.Attributes(ResultsFieldID("save-prizegiving-plan", ceremonyID, "sequence_display_order_"+strconv.Itoa(index)))... }
		/>
		@FieldError(page.Errors, ResultsFieldID("save-prizegiving-plan", ceremonyID, "sequence_display_order_"+strconv.Itoa(index)))
		<label for={ ResultsFieldID("save-prizegiving-plan", ceremonyID, "reveal_method_"+strconv.Itoa(index)) }>Reveal Method</label>
		<select
			id={ ResultsFieldID("save-prizegiving-plan", ceremonyID, "reveal_method_"+strconv.Itoa(index)) }
			name="reveal_method"
			{ page.Errors.Attributes(ResultsFieldID("save-prizegiving-plan", ceremonyID, "reveal_method_"+strconv.Itoa(index)))... }
		>
			<option value={ string(results.RevealStatic) } selected?={ page.valueAt("save-prizegiving-plan", ceremonyID, "reveal_method", index, string(item.RevealMethod)) == string(results.RevealStatic) }>{ humanizeIdentifier(string(results.RevealStatic)) }</option>
			<option value={ string(results.RevealSequentialPodium) } selected?={ page.valueAt("save-prizegiving-plan", ceremonyID, "reveal_method", index, string(item.RevealMethod)) == string(results.RevealSequentialPodium) }>{ humanizeIdentifier(string(results.RevealSequentialPodium)) }</option>
			<option value={ string(results.RevealAnimatedScoreBars) } selected?={ page.valueAt("save-prizegiving-plan", ceremonyID, "reveal_method", index, string(item.RevealMethod)) == string(results.RevealAnimatedScoreBars) }>{ humanizeIdentifier(string(results.RevealAnimatedScoreBars)) }</option>
		</select>
		@FieldError(page.Errors, ResultsFieldID("save-prizegiving-plan", ceremonyID, "reveal_method_"+strconv.Itoa(index)))
		<label for={ ResultsFieldID("save-prizegiving-plan", ceremonyID, "publication_display_order_"+strconv.Itoa(index)) }>Publication order</label>
		<input
			id={ ResultsFieldID("save-prizegiving-plan", ceremonyID, "publication_display_order_"+strconv.Itoa(index)) }
			type="number"
			min="1"
			name="publication_display_order"
			value={ page.valueAt("save-prizegiving-plan", ceremonyID, "publication_display_order", index, strconv.Itoa(prizegivingPublicationOrder(item, publication, index))) }
			required
			{ page.Errors.Attributes(ResultsFieldID("save-prizegiving-plan", ceremonyID, "publication_display_order_"+strconv.Itoa(index)))... }
		/>
		@FieldError(page.Errors, ResultsFieldID("save-prizegiving-plan", ceremonyID, "publication_display_order_"+strconv.Itoa(index)))
	</fieldset>
}

templ CompetitionAwardFields(
	page ResultsPage,
	competitionID int,
	award results.Award,
	index int,
) {
	<fieldset>
		<legend>
			if page.valueAt("save-competition-awards", competitionID, "award_name", index, award.Name) == "" {
				New Award
			} else {
				{ page.valueAt("save-competition-awards", competitionID, "award_name", index, award.Name) }
			}
		</legend>
		<label for={ ResultsFieldID("save-competition-awards", competitionID, "award_key_"+strconv.Itoa(index)) }>Key</label>
		<input
			id={ ResultsFieldID("save-competition-awards", competitionID, "award_key_"+strconv.Itoa(index)) }
			name="award_key"
			value={ page.valueAt("save-competition-awards", competitionID, "award_key", index, award.Key) }
			{ page.Errors.Attributes(ResultsFieldID("save-competition-awards", competitionID, "award_key_"+strconv.Itoa(index)))... }
		/>
		@FieldError(page.Errors, ResultsFieldID("save-competition-awards", competitionID, "award_key_"+strconv.Itoa(index)))
		<label for={ ResultsFieldID("save-competition-awards", competitionID, "award_name_"+strconv.Itoa(index)) }>Name</label>
		<input
			id={ ResultsFieldID("save-competition-awards", competitionID, "award_name_"+strconv.Itoa(index)) }
			name="award_name"
			value={ page.valueAt("save-competition-awards", competitionID, "award_name", index, award.Name) }
			{ page.Errors.Attributes(ResultsFieldID("save-competition-awards", competitionID, "award_name_"+strconv.Itoa(index)))... }
		/>
		@FieldError(page.Errors, ResultsFieldID("save-competition-awards", competitionID, "award_name_"+strconv.Itoa(index)))
		<fieldset
			id={ ResultsFieldID("save-competition-awards", competitionID, "award_recipient_entry_ids_"+strconv.Itoa(index)) }
			{ page.Errors.Attributes(ResultsFieldID("save-competition-awards", competitionID, "award_recipient_entry_ids_"+strconv.Itoa(index)))... }
		>
			<legend>Recipient Entries</legend>
			for _, option := range resultsCompetitionEntries(page.Competitions, competitionID, award.Recipients) {
				<label>
					<input
						type="checkbox"
						name={ "award_recipient_entry_ids_" + strconv.Itoa(index) }
						value={ strconv.Itoa(option.ID) }
						checked?={ page.checked("save-competition-awards", competitionID, "award_recipient_entry_ids_"+strconv.Itoa(index), strconv.Itoa(option.ID), resultsAwardRecipientEntryChecked(award.Recipients, option.ID)) }
					/>
					{ option.Label }
				</label>
			}
		</fieldset>
		@FieldError(page.Errors, ResultsFieldID("save-competition-awards", competitionID, "award_recipient_entry_ids_"+strconv.Itoa(index)))
		<label for={ ResultsFieldID("save-competition-awards", competitionID, "award_recipient_names_"+strconv.Itoa(index)) }>Other recipient names, one per line</label>
		<textarea
			id={ ResultsFieldID("save-competition-awards", competitionID, "award_recipient_names_"+strconv.Itoa(index)) }
			name="award_recipient_names"
			{ page.Errors.Attributes(ResultsFieldID("save-competition-awards", competitionID, "award_recipient_names_"+strconv.Itoa(index)))... }
		>{ page.valueAt("save-competition-awards", competitionID, "award_recipient_names", index, resultsAwardRecipientNames(award.Recipients)) }</textarea>
		@FieldError(page.Errors, ResultsFieldID("save-competition-awards", competitionID, "award_recipient_names_"+strconv.Itoa(index)))
		<label for={ ResultsFieldID("save-competition-awards", competitionID, "award_promoted_"+strconv.Itoa(index)) }>Promoted</label>
			<select
				id={ ResultsFieldID("save-competition-awards", competitionID, "award_promoted_"+strconv.Itoa(index)) }
				name="award_promoted"
				{ page.Errors.Attributes(ResultsFieldID("save-competition-awards", competitionID, "award_promoted_"+strconv.Itoa(index)))... }
			>
				<option value="false" selected?={ page.valueAt("save-competition-awards", competitionID, "award_promoted", index, strconv.FormatBool(award.Promoted)) == "false" }>No</option>
				<option value="true" selected?={ page.valueAt("save-competition-awards", competitionID, "award_promoted", index, strconv.FormatBool(award.Promoted)) == "true" }>Yes</option>
			</select>
		@FieldError(page.Errors, ResultsFieldID("save-competition-awards", competitionID, "award_promoted_"+strconv.Itoa(index)))
		<label for={ ResultsFieldID("save-competition-awards", competitionID, "award_display_order_"+strconv.Itoa(index)) }>Display order</label>
		<input
			id={ ResultsFieldID("save-competition-awards", competitionID, "award_display_order_"+strconv.Itoa(index)) }
			type="number"
			min="1"
			name="award_display_order"
			value={ page.valueAt("save-competition-awards", competitionID, "award_display_order", index, resultsAwardDisplayOrder(award.DisplayOrder, index)) }
			{ page.Errors.Attributes(ResultsFieldID("save-competition-awards", competitionID, "award_display_order_"+strconv.Itoa(index)))... }
		/>
		@FieldError(page.Errors, ResultsFieldID("save-competition-awards", competitionID, "award_display_order_"+strconv.Itoa(index)))
	</fieldset>
}
