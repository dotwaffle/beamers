package frontend

import (
	"strconv"

	"github.com/dotwaffle/beamers/internal/attachments"
	"github.com/dotwaffle/beamers/internal/competition"
	"github.com/dotwaffle/beamers/internal/presentation"
	"github.com/dotwaffle/beamers/internal/voting"
)

type SubmissionsPage struct {
	AccountName    string
	CSRFToken      string
	ReducedEffects bool
	Backstage      bool
	CommandID      string
	Competitions   []competition.SubmissionCompetition
	Presentations  []presentation.Submission
	Ballots        []voting.Window
	EventSlugs     map[int]string
	Attachments    attachments.AccountState
	Form           SubmissionForm
	Errors         FormErrors
}

type SubmissionForm struct {
	Action        string
	SessionID     int
	EntryID       int
	Name          string
	PublicDetails string
	Speaker       string
	UploadTarget  attachments.TargetKind
	UploadTargetID int
	UploadName     string
	UploadCrewOnly bool
}

func (form SubmissionForm) matches(action string, sessionID, entryID int) bool {
	return form.Action == action && form.SessionID == sessionID && form.EntryID == entryID
}

func (form SubmissionForm) matchesUpload(target attachments.TargetKind, targetID int) bool {
	return form.Action == "upload" && form.UploadTarget == target && form.UploadTargetID == targetID
}

func submittedVersions(
	values []attachments.AccountVersion,
	targetType attachments.TargetKind,
	targetID int,
) []attachments.AccountVersion {
	result := make([]attachments.AccountVersion, 0)
	for _, value := range values {
		if value.OwnerType == targetType && value.OwnerID == targetID {
			result = append(result, value)
		}
	}
	return result
}

func submittedReopenWindows(
	values []attachments.AccountReopenWindow,
	targetType attachments.TargetKind,
	targetID int,
) []attachments.AccountReopenWindow {
	result := make([]attachments.AccountReopenWindow, 0)
	for _, value := range values {
		if value.TargetType == targetType && value.TargetID == targetID {
			result = append(result, value)
		}
	}
	return result
}

templ Submissions(page SubmissionsPage) {
	<!doctype html>
	<html lang="en">
		@Head("My Participation · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, page.Backstage)
			<main id="main-content" tabindex="-1">
				<h1>My Participation</h1>
				@ErrorSummary(page.Errors)
				<section aria-labelledby="participation-uploads">
					<h2 id="participation-uploads">Uploads</h2>
					<p>{ strconv.Itoa(len(page.Attachments.Versions)) } immutable Attachment Versions across your Entries and Presentations.</p>
				</section>
				<section aria-labelledby="participation-voting">
					<h2 id="participation-voting">Voting</h2>
					if len(page.Ballots) == 0 {
						@EmptyState("No open Ballots.")
					} else {
						for _, ballot := range page.Ballots {
							<p>
								{ ballot.EventName } — { ballot.Title }:
								<a href={ templ.SafeURL("/voting/" + strconv.Itoa(ballot.SessionID) + "?event_id=" + strconv.Itoa(ballot.EventID)) }>Vote</a>
							</p>
						}
					}
					<p><a href="/voting">Redeem a Voting Key</a></p>
				</section>
				<h2>Presentations</h2>
				if len(page.Presentations) == 0 {
					@EmptyState("No assigned Presentations.")
				}
				for _, found := range page.Presentations {
					<section id={ "presentation-" + strconv.Itoa(found.SessionID) }>
						<h3>{ found.EventName } — { found.SessionTitle }</h3>
						if slug := page.EventSlugs[found.EventID]; slug != "" {
							<p><a href={ templ.SafeURL("/events/" + slug + "/schedule/sessions/" + strconv.Itoa(found.SessionID)) }>View Presentation</a></p>
						}
						if found.UploadDeadline.IsZero() {
							<p>Submission access closes at Actual Start.</p>
						} else {
							<p>
								Presentation Upload Deadline:
								@EventTime(found.UploadDeadline, found.Timezone, found.EventLocale)
							</p>
						}
						<form id={ "presentation-" + strconv.Itoa(found.SessionID) + "-manage" } class="stack" method="post">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<input type="hidden" name="action" value="update-presentation"/>
							<input type="hidden" name="command_id" value={ page.CommandID }/>
							<input type="hidden" name="event_id" value={ strconv.Itoa(found.EventID) }/>
							<input type="hidden" name="session_id" value={ strconv.Itoa(found.SessionID) }/>
							<input type="hidden" name="expected_revision" value={ strconv.Itoa(found.Revision) }/>
							<label>
								Speaker credit
								<input
									id={ "presentation-" + strconv.Itoa(found.SessionID) + "-speaker" }
									name="speaker"
									value={ submissionValue(page.Form.matches("update-presentation", found.SessionID, 0), page.Form.Speaker, found.Speaker) }
									{ page.Errors.Attributes("presentation-" + strconv.Itoa(found.SessionID) + "-speaker")... }
								/>
							</label>
							@FieldError(page.Errors, "presentation-" + strconv.Itoa(found.SessionID) + "-speaker")
							<label>
								Public details
								<textarea
									id={ "presentation-" + strconv.Itoa(found.SessionID) + "-details" }
									name="public_details"
									{ page.Errors.Attributes("presentation-" + strconv.Itoa(found.SessionID) + "-details")... }
								>{ submissionValue(page.Form.matches("update-presentation", found.SessionID, 0), page.Form.PublicDetails, found.PublicDetails) }</textarea>
							</label>
							@FieldError(page.Errors, "presentation-" + strconv.Itoa(found.SessionID) + "-details")
							<button type="submit">Update Presentation details</button>
						</form>
						<form id={ "presentation-" + strconv.Itoa(found.SessionID) + "-upload" } class="stack" method="post" enctype="multipart/form-data" action={ templ.SafeURL("/submissions/" + strconv.Itoa(found.EventID) + "/presentations/" + strconv.Itoa(found.SessionID) + "/upload") }>
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<input type="hidden" name="command_id" value={ page.CommandID }/>
							<label>
								Attachment name
								<input
									id={ "presentation-" + strconv.Itoa(found.SessionID) + "-upload-name" }
									name="name"
									value={ submissionValue(page.Form.matchesUpload(attachments.TargetPresentation, found.SessionID), page.Form.UploadName, "") }
									required
									{ page.Errors.Attributes("presentation-" + strconv.Itoa(found.SessionID) + "-upload-name")... }
								/>
							</label>
							@FieldError(page.Errors, "presentation-" + strconv.Itoa(found.SessionID) + "-upload-name")
							<label>
								File
								<input
									id={ "presentation-" + strconv.Itoa(found.SessionID) + "-upload-file" }
									type="file"
									name="file"
									required
									{ page.Errors.Attributes("presentation-" + strconv.Itoa(found.SessionID) + "-upload-file")... }
								/>
							</label>
							@FieldError(page.Errors, "presentation-" + strconv.Itoa(found.SessionID) + "-upload-file")
							<label>
								<input
									type="checkbox"
									name="crew_only"
									value="true"
									checked?={ page.Form.matchesUpload(attachments.TargetPresentation, found.SessionID) && page.Form.UploadCrewOnly }
								/>
								Crew Only Release Eligibility
							</label>
							<button type="submit">Upload immutable Version</button>
						</form>
						<h4>Attachment Versions</h4>
						if len(submittedVersions(page.Attachments.Versions, attachments.TargetPresentation, found.SessionID)) == 0 {
							@EmptyState("No Attachment Versions.")
						}
						for _, version := range submittedVersions(page.Attachments.Versions, attachments.TargetPresentation, found.SessionID) {
							<p>
								{ version.Name } — Version { strconv.Itoa(version.Version) }:
								{ version.OriginalFilename } · SHA-256 { version.SHA256 }
							</p>
						}
						for _, window := range submittedReopenWindows(page.Attachments.ReopenWindows, attachments.TargetPresentation, found.SessionID) {
							if window.ClosedAt.IsZero() {
								<p>
									Submission access reopened until
									@EventTime(window.ExpiresAt, found.Timezone, found.EventLocale)
								</p>
							}
						}
					</section>
				}
				<h2>Entries</h2>
				if len(page.Competitions) == 0 {
					@EmptyState("No published Competitions are accepting submissions.")
				}
				for _, found := range page.Competitions {
					<section id={ "competition-" + strconv.Itoa(found.SessionID) }>
						<h3>{ found.EventName } — { found.SessionTitle }</h3>
						if slug := page.EventSlugs[found.EventID]; slug != "" {
							<p><a href={ templ.SafeURL("/events/" + slug + "/competitions/" + strconv.Itoa(found.SessionID)) }>View Competition</a></p>
						}
						<p>
							Submission Deadline:
							@EventTime(found.SubmissionDeadline, found.Timezone, found.EventLocale)
						</p>
						if found.CanCreate {
							<form class="stack" method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="create"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								<input type="hidden" name="event_id" value={ strconv.Itoa(found.EventID) }/>
								<input type="hidden" name="session_id" value={ strconv.Itoa(found.SessionID) }/>
								<label>
									Entry name
									<input
										id={ "entry-create-" + strconv.Itoa(found.SessionID) + "-name" }
										name="entry_name"
										value={ submissionValue(page.Form.matches("create", found.SessionID, 0), page.Form.Name, "") }
										required
										{ page.Errors.Attributes("entry-create-" + strconv.Itoa(found.SessionID) + "-name")... }
									/>
								</label>
								@FieldError(page.Errors, "entry-create-" + strconv.Itoa(found.SessionID) + "-name")
								<label>
									Public details
									<textarea
										id={ "entry-create-" + strconv.Itoa(found.SessionID) + "-details" }
										name="public_details"
										{ page.Errors.Attributes("entry-create-" + strconv.Itoa(found.SessionID) + "-details")... }
									>{ submissionValue(page.Form.matches("create", found.SessionID, 0), page.Form.PublicDetails, "") }</textarea>
								</label>
								@FieldError(page.Errors, "entry-create-" + strconv.Itoa(found.SessionID) + "-details")
								<button type="submit">Create Entry</button>
							</form>
						}
						for _, entry := range found.Entries {
							<article>
								<h4>{ entry.Name }</h4>
								<p>{ entry.PublicDetails }</p>
								<form class="stack" method="post">
									<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
									<input type="hidden" name="action" value="update"/>
									<input type="hidden" name="command_id" value={ page.CommandID }/>
									<input type="hidden" name="event_id" value={ strconv.Itoa(found.EventID) }/>
									<input type="hidden" name="session_id" value={ strconv.Itoa(found.SessionID) }/>
									<input type="hidden" name="entry_id" value={ strconv.Itoa(entry.ID) }/>
									<input type="hidden" name="expected_revision" value={ strconv.Itoa(entry.Revision) }/>
									<label>
										Entry name
										<input
											id={ "entry-" + strconv.Itoa(entry.ID) + "-name" }
											name="entry_name"
											value={ submissionValue(page.Form.matches("update", found.SessionID, entry.ID), page.Form.Name, entry.Name) }
											required
											{ page.Errors.Attributes("entry-" + strconv.Itoa(entry.ID) + "-name")... }
										/>
									</label>
									@FieldError(page.Errors, "entry-" + strconv.Itoa(entry.ID) + "-name")
									<label>
										Public details
										<textarea
											id={ "entry-" + strconv.Itoa(entry.ID) + "-details" }
											name="public_details"
											{ page.Errors.Attributes("entry-" + strconv.Itoa(entry.ID) + "-details")... }
										>{ submissionValue(page.Form.matches("update", found.SessionID, entry.ID), page.Form.PublicDetails, entry.PublicDetails) }</textarea>
									</label>
									@FieldError(page.Errors, "entry-" + strconv.Itoa(entry.ID) + "-details")
									<button type="submit">Update Entry</button>
								</form>
								<form class="stack" method="post" enctype="multipart/form-data" action={ templ.SafeURL("/submissions/" + strconv.Itoa(found.EventID) + "/entries/" + strconv.Itoa(entry.ID) + "/upload") }>
									<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
									<input type="hidden" name="command_id" value={ page.CommandID }/>
									<label>
										Attachment name
										<input
											id={ "entry-" + strconv.Itoa(entry.ID) + "-upload-name" }
											name="name"
											value={ submissionValue(page.Form.matchesUpload(attachments.TargetEntry, entry.ID), page.Form.UploadName, "") }
											required
											{ page.Errors.Attributes("entry-" + strconv.Itoa(entry.ID) + "-upload-name")... }
										/>
									</label>
									@FieldError(page.Errors, "entry-" + strconv.Itoa(entry.ID) + "-upload-name")
									<label>
										File
										<input
											id={ "entry-" + strconv.Itoa(entry.ID) + "-upload-file" }
											type="file"
											name="file"
											required
											{ page.Errors.Attributes("entry-" + strconv.Itoa(entry.ID) + "-upload-file")... }
										/>
									</label>
									@FieldError(page.Errors, "entry-" + strconv.Itoa(entry.ID) + "-upload-file")
									<label>
										<input
											type="checkbox"
											name="crew_only"
											value="true"
											checked?={ page.Form.matchesUpload(attachments.TargetEntry, entry.ID) && page.Form.UploadCrewOnly }
										/>
										Crew Only Release Eligibility
									</label>
									<button type="submit">Upload immutable Version</button>
								</form>
								<h5>Attachment Versions</h5>
								if len(submittedVersions(page.Attachments.Versions, attachments.TargetEntry, entry.ID)) == 0 {
									@EmptyState("No Attachment Versions.")
								}
								for _, version := range submittedVersions(page.Attachments.Versions, attachments.TargetEntry, entry.ID) {
									<p>
										{ version.Name } — Version { strconv.Itoa(version.Version) }:
										{ version.OriginalFilename } · SHA-256 { version.SHA256 }
									</p>
								}
								for _, window := range submittedReopenWindows(page.Attachments.ReopenWindows, attachments.TargetEntry, entry.ID) {
									if window.ClosedAt.IsZero() {
										<p>
											Submission access reopened until
											@EventTime(window.ExpiresAt, found.Timezone, found.EventLocale)
										</p>
									}
								}
							</article>
						}
					</section>
				}
			</main>
			<script src={ EventTimePath } defer></script>
		</body>
	</html>
}

func submissionValue(submitted bool, value, fallback string) string {
	if submitted {
		return value
	}
	return fallback
}
