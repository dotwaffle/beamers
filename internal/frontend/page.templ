package frontend

import "net/url"
import "strconv"
import "strings"
import "time"

import "github.com/dotwaffle/beamers/internal/auth"
import "github.com/dotwaffle/beamers/internal/events"

type BackstageNavigation struct {
	Administrator bool
	Events        []BackstageEvent
	Breadcrumbs   []Breadcrumb
}

type BackstageEvent struct {
	ID       int
	Name     string
	Role     string
	Sections []BackstageSection
}

type BackstageSection struct {
	ID                string
	Label             string
	Href              string
	Current           bool
	UnavailableReason string
}

type Shell struct {
	AccountName    string
	CSRFToken      string
	ReturnTo       string
	ReducedEffects bool
	Backstage      bool
	MainID         string
	Event          EventContext
}

type EventContext struct {
	Name        string
	Slug        string
	ActivePath  string
	Breadcrumbs []Breadcrumb
}

type Breadcrumb struct {
	Label string
	Href  string
}

type FormError struct {
	FieldID string
	Label   string
	Message string
}

type FormErrors []FormError

func (errors FormErrors) Attributes(fieldID string) templ.Attributes {
	for _, formError := range errors {
		if formError.FieldID == fieldID {
			return templ.Attributes{
				"aria-invalid":     "true",
				"aria-describedby": fieldID + "-error",
			}
		}
	}
	return nil
}

func (errors FormErrors) Message(fieldID string) string {
	for _, formError := range errors {
		if formError.FieldID == fieldID {
			return formError.Message
		}
	}
	return ""
}

func mainContentID(id string) string {
	if id == "" {
		return "main-content"
	}
	return id
}

func EffectsPath(returnTo string) string {
	return "/effects?return_to=" + url.QueryEscape(returnTo)
}

func EffectsLabel(reducedEffects bool) string {
	if reducedEffects {
		return "Resume effects"
	}
	return "Pause effects"
}

func publicEventDate(value, locale string) string {
	date, err := time.Parse(time.DateOnly, value)
	if err != nil {
		return value
	}
	if locale == "en-US" {
		return date.Format("Jan 2, 2006")
	}
	if locale == "de" || strings.HasPrefix(locale, "de-") {
		return date.Format("02.01.2006")
	}
	return date.Format("02 Jan 2006")
}

templ ErrorSummary(errors FormErrors) {
	if len(errors) > 0 {
		<section id="error-summary" class="error error-summary" role="alert" tabindex="-1" autofocus>
			<h2>There is a problem</h2>
			<ul>
				for _, formError := range errors {
					<li>
						if formError.FieldID == "" {
							{ formError.Message }
						} else {
							<a href={ templ.SafeURL("#" + formError.FieldID) }>
								{ formError.Label }: { formError.Message }
							</a>
						}
					</li>
				}
			</ul>
		</section>
	}
}

templ FieldError(errors FormErrors, fieldID string) {
	if message := errors.Message(fieldID); message != "" {
		<p id={ fieldID + "-error" } class="error">{ message }</p>
	}
}

templ EffectsLink(returnTo string, reducedEffects bool) {
	<a href={ EffectsPath(returnTo) }>{ EffectsLabel(reducedEffects) }</a>
}

templ Head(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<link rel="stylesheet" href={ StylesheetPath }/>
		<link rel="stylesheet" href={ InstallationThemePath }/>
		<title>{ title }</title>
	</head>
}

templ EventHead(title string, eventID int) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<link rel="stylesheet" href={ StylesheetPath }/>
		<link rel="stylesheet" href={ EventThemePath(eventID) }/>
		<title>{ title }</title>
	</head>
}

templ Navigation(accountName string, csrfToken string, reducedEffects bool, backstage bool) {
	@ShellNavigation(Shell{
		AccountName: accountName,
		CSRFToken: csrfToken,
		ReducedEffects: reducedEffects,
		Backstage: backstage,
	})
}

templ ShellNavigation(shell Shell) {
	@SkipLink(mainContentID(shell.MainID))
	<header>
		<nav aria-label="Primary" class="primary-navigation">
			<a class="brand" href="/">Beamers</a>
			<a href="/">Events</a>
			if shell.AccountName == "" {
				if shell.ReturnTo == "" {
					<a href="/sign-in">Sign in</a>
				} else {
					<a href={ templ.SafeURL("/sign-in?return_to=" + url.QueryEscape(shell.ReturnTo)) }>Sign in</a>
				}
				<a href="/register">Register</a>
			} else {
				<span>{ shell.AccountName }</span>
				<a href="/profile">Profile</a>
				<a href="/my-participation">My Participation</a>
				<a href="/my-schedule">My Schedule</a>
				if shell.Backstage {
					<a href="/backstage">Backstage</a>
				}
				<form method="post" action="/sign-out">
					<input type="hidden" name="csrf_token" value={ shell.CSRFToken }/>
					<button type="submit">Sign out</button>
				</form>
			}
			if shell.CSRFToken == "" {
				@EffectsLink(shell.ReturnTo, shell.ReducedEffects)
			} else {
				<form method="post" action="/effects">
					<input type="hidden" name="csrf_token" value={ shell.CSRFToken }/>
					if shell.ReturnTo != "" {
						<input type="hidden" name="return_to" value={ shell.ReturnTo }/>
					}
					<button
						type="submit"
						name="reduce_effects"
						value={ strconv.FormatBool(!shell.ReducedEffects) }
						aria-pressed={ strconv.FormatBool(shell.ReducedEffects) }
					>
						if shell.ReducedEffects {
							Resume effects
						} else {
							Pause effects
						}
					</button>
				</form>
			}
		</nav>
	</header>
}

templ EventShell(shell Shell) {
	@ShellNavigation(shell)
	<div class="event-layout">
		@EventNavigationViews(shell.Event)
		<div class="event-content">
			@EventBreadcrumbs(shell.Event.Breadcrumbs)
			{ children... }
		</div>
	</div>
}

templ EventNavigationViews(event EventContext) {
	<details class="event-drawer">
		<summary>{ event.Name } navigation</summary>
		@EventLinks(event)
	</details>
	<aside class="event-sidebar">
		@EventLinks(event)
	</aside>
}

templ EventLinks(event EventContext) {
	<nav aria-label={ event.Name + " Event" } class="event-links">
		<strong class="navigation-title">{ event.Name }</strong>
		<ul>
			<li>
				@EventLink(
					"Overview",
					"/events/" + event.Slug,
					event.ActivePath == "/events/"+event.Slug,
				)
			</li>
			<li>
				@EventLink(
					"Event Schedule",
					"/events/" + event.Slug + "/schedule",
					event.ActivePath == "/events/"+event.Slug+"/schedule",
				)
			</li>
			<li>
				@EventLink(
					"Competitions",
					"/events/" + event.Slug + "/competitions",
					event.ActivePath == "/events/"+event.Slug+"/competitions",
				)
			</li>
			<li>
				@EventLink(
					"Event Results",
					"/events/" + event.Slug + "/results",
					event.ActivePath == "/events/"+event.Slug+"/results",
				)
			</li>
		</ul>
	</nav>
}

templ EventLink(label string, href string, active bool) {
	if active {
		<a href={ templ.SafeURL(href) } aria-current="page">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) }>{ label }</a>
	}
}

templ EventBreadcrumbs(breadcrumbs []Breadcrumb) {
	<nav aria-label="Breadcrumb" class="breadcrumbs">
		<ol>
			for _, breadcrumb := range breadcrumbs {
				<li>
					if breadcrumb.Href == "" {
						<span aria-current="page">{ breadcrumb.Label }</span>
					} else {
						<a href={ templ.SafeURL(breadcrumb.Href) }>{ breadcrumb.Label }</a>
					}
				</li>
			}
		</ol>
	</nav>
}

templ Effects(csrfToken string, reducedEffects bool, returnTo string) {
	<!doctype html>
	<html lang="en">
		@Head("Effects · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation("", csrfToken, reducedEffects, false)
			<main id="main-content" tabindex="-1">
				<h1>{ EffectsLabel(reducedEffects) }</h1>
				<p>Decorative motion stays off until you resume it.</p>
				<form method="post" action="/effects">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="return_to" value={ returnTo }/>
					<button
						type="submit"
						name="reduce_effects"
						value={ strconv.FormatBool(!reducedEffects) }
					>{ EffectsLabel(reducedEffects) }</button>
				</form>
			</main>
		</body>
	</html>
}

templ Register(
	csrfToken string,
	handle string,
	displayName string,
	errors FormErrors,
	open bool,
	sceneIDCreation bool,
	reducedEffects bool,
) {
	<!doctype html>
	<html lang="en">
		@Head("Register · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation("", csrfToken, reducedEffects, false)
			<main id="main-content" tabindex="-1">
				<h1>Register</h1>
				@ErrorSummary(errors)
				if open {
					if sceneIDCreation {
						<p><a href="/auth/federation/sceneid/begin">Create Account with SceneID</a></p>
					}
					<form class="stack" method="post" action="/register">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<label for="register-handle">
							Account Handle
						</label>
						<input id="register-handle" name="handle" value={ handle } autocomplete="username" maxlength="200" required { errors.Attributes("register-handle")... }/>
						@FieldError(errors, "register-handle")
						<label for="register-display-name">
							Display Name
						</label>
						<input id="register-display-name" name="display_name" value={ displayName } autocomplete="name" maxlength="200" required { errors.Attributes("register-display-name")... }/>
						@FieldError(errors, "register-display-name")
						<label for="register-password">
							Password
						</label>
						<input id="register-password" type="password" name="password" autocomplete="new-password" minlength="12" maxlength="1024" required { errors.Attributes("register-password")... }/>
						@FieldError(errors, "register-password")
						<button type="submit">Create Account</button>
					</form>
				} else {
					<p>Registration is closed.</p>
				}
			</main>
		</body>
	</html>
}

templ ProfilePage(
	csrfToken string,
	profile auth.Profile,
	errors FormErrors,
	passwordActive bool,
	canRemovePassword bool,
	credentials []auth.WebAuthnCredential,
	sceneIDConfigured bool,
	recoveryCodes []string,
	recoveryCommandID string,
	credentialCommandID string,
	reducedEffects bool,
	backstage bool,
) {
	<!doctype html>
	<html lang="en">
		@Head("Profile · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation(profile.DisplayName, csrfToken, reducedEffects, backstage)
			<main id="main-content" tabindex="-1">
				<h1>Profile</h1>
				<p>Account Handle: <strong>{ profile.Handle }</strong></p>
				@ErrorSummary(errors)
				<form class="stack" method="post" action="/profile">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<label for="profile-display-name">
						Display Name
					</label>
					<input id="profile-display-name" name="display_name" value={ profile.DisplayName } autocomplete="name" maxlength="200" required { errors.Attributes("profile-display-name")... }/>
					@FieldError(errors, "profile-display-name")
					<fieldset id="profile-entries" { errors.Attributes("profile-entries")... }>
						<legend>Public Profile</legend>
						<label>
							<input type="checkbox" name="published" value="true" checked?={ profile.Published }/>
							Publish my Profile
						</label>
						for _, entry := range profile.AvailableEntries {
							<label>
								<input type="checkbox" name="entry_id" value={ strconv.Itoa(entry.ID) } checked?={ entry.Selected }/>
								{ entry.Name }
							</label>
						}
					</fieldset>
					@FieldError(errors, "profile-entries")
					<button type="submit">Save Profile</button>
				</form>
				if profile.Published {
					<p><a href={ templ.SafeURL("/people/" + profile.Handle) }>View Public Profile</a></p>
				}
				<section>
					<h2>Sign-in Credentials</h2>
					<p data-webauthn-status role="status">Checking WebAuthn availability…</p>
					<div class="stack" data-webauthn-registration hidden>
						<label>
							Credential name
							<input data-webauthn-name maxlength="200" autocomplete="off" required/>
						</label>
						<button type="button" data-webauthn-register>Register passkey or security key</button>
					</div>
					if passwordActive {
						<p>Password Credential: active</p>
						if canRemovePassword {
							<form method="post" action="/profile">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<input type="hidden" name="action" value="remove-password"/>
								<input type="hidden" name="command_id" value={ credentialCommandID + "-remove-password" }/>
								<button type="submit">Remove password</button>
							</form>
						} else {
							<p>Register another Credential before removing your password.</p>
						}
					} else {
						<p>Password Credential: removed</p>
					}
					if sceneIDConfigured {
						<form method="post" action="/auth/federation/sceneid/begin">
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<input type="hidden" name="mode" value="link"/>
							<button type="submit">Link SceneID</button>
						</form>
					}
					if len(credentials) == 0 {
						<p>No WebAuthn Credentials registered.</p>
					} else {
						<ul>
							for _, credential := range credentials {
								<li>
									<strong>{ credential.Name }</strong>
									if credential.Attachment != "" {
										<span> ({ credential.Attachment })</span>
									}
									if credential.Revoked {
										<span> — revoked</span>
									} else {
										<span> — active</span>
										<form method="post" action="/profile">
											<input type="hidden" name="csrf_token" value={ csrfToken }/>
											<input type="hidden" name="action" value="revoke-webauthn"/>
											<input type="hidden" name="credential_id" value={ strconv.Itoa(credential.ID) }/>
											<input type="hidden" name="command_id" value={ credentialCommandID + "-revoke-" + strconv.Itoa(credential.ID) }/>
											<button type="submit">Revoke</button>
										</form>
									}
								</li>
							}
						</ul>
					}
				</section>
				<section>
					<h2>Account recovery</h2>
					if len(recoveryCodes) > 0 {
						<p role="status">Save these Recovery Codes now. They will not be shown again.</p>
						<ul>
							for _, code := range recoveryCodes {
								<li><code data-recovery-code>{ code }</code></li>
							}
						</ul>
					}
					<form method="post" action="/profile">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<input type="hidden" name="action" value="replace-recovery-codes"/>
						<input type="hidden" name="command_id" value={ recoveryCommandID }/>
						<button type="submit">Replace Recovery Codes</button>
					</form>
				</section>
			</main>
			<script src={ WebAuthnPath } defer></script>
		</body>
	</html>
}

templ PublicProfile(profile auth.Profile, csrfToken string, reducedEffects bool) {
	<!doctype html>
	<html lang="en">
		@Head(profile.DisplayName + " · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation("", csrfToken, reducedEffects, false)
			<main id="main-content" tabindex="-1">
				<h1>{ profile.DisplayName }</h1>
				if len(profile.Entries) > 0 {
					<h2>Released Entries</h2>
					<ul>
						for _, entry := range profile.Entries {
							<li>{ entry.Name }</li>
						}
					</ul>
				}
			</main>
		</body>
	</html>
}

templ BackstageLinks(navigation BackstageNavigation) {
	<nav class="backstage-links" aria-label="Backstage">
		if navigation.Administrator {
			<section aria-label="Installation">
				<strong class="navigation-title">Installation</strong>
					<ul>
						<li><a href="/backstage/events/new">Create Event</a></li>
						<li><a href="/backstage/administration">Accounts, Event Grants, and activation</a></li>
						<li><a href="/backstage/themes">Installation Theme</a></li>
					<li><a href="/admin/registration">Registration</a></li>
					<li><a href="/backstage/installation">Backups and diagnostics</a></li>
				</ul>
			</section>
		}
		for _, event := range navigation.Events {
			<section aria-label={ event.Name }>
				<strong class="navigation-title">{ event.Name }</strong>
				<p>{ event.Role }</p>
				<ul>
					for _, section := range event.Sections {
						<li>
							if section.UnavailableReason != "" {
								<span>{ section.Label }</span>
								<p>{ section.UnavailableReason }</p>
							} else {
								@EventLink(section.Label, section.Href, section.Current)
							}
						</li>
					}
				</ul>
			</section>
		}
	</nav>
}

templ BackstageNavigationViews(navigation BackstageNavigation) {
	<details class="backstage-drawer">
		<summary>Backstage navigation</summary>
		@BackstageLinks(navigation)
	</details>
	<aside class="backstage-sidebar">
		@BackstageLinks(navigation)
	</aside>
	if len(navigation.Breadcrumbs) > 0 {
		<div class="backstage-breadcrumbs">
			@EventBreadcrumbs(navigation.Breadcrumbs)
		</div>
	}
}

templ Backstage(
	accountName string,
	csrfToken string,
	reducedEffects bool,
	navigation BackstageNavigation,
) {
	<!doctype html>
	<html lang="en">
		@Head("Backstage · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation(accountName, csrfToken, reducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(navigation)
				<main id="main-content" tabindex="-1">
					<h1>Backstage</h1>
					if navigation.Administrator {
						<section id="administration">
							<h2>Accounts, Event Grants, and activation</h2>
						</section>
					}
					for _, event := range navigation.Events {
						<section>
							<h2>{ event.Name } · { event.Role }</h2>
							for _, section := range event.Sections {
								<h3 id={ section.ID }>{ section.Label }</h3>
							}
						</section>
					}
				</main>
			</div>
		</body>
	</html>
}

templ RegistrationPolicy(
	csrfToken string,
	open bool,
	reducedEffects bool,
	accountName string,
	navigation BackstageNavigation,
) {
	<!doctype html>
	<html lang="en">
		@Head("Registration · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation(accountName, csrfToken, reducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(navigation)
				<main id="main-content" tabindex="-1">
					<h1>Registration</h1>
					<form class="stack" method="post" action="/admin/registration">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<label>
							<input type="checkbox" name="registration_open" value="true" checked?={ open }/>
							Allow new Accounts
						</label>
						<button type="submit">Save Registration Policy</button>
					</form>
				</main>
			</div>
		</body>
	</html>
}

templ Root(
	setupRequired bool,
	accountName string,
	csrfToken string,
	reducedEffects bool,
	backstage bool,
	publicEvents []events.PublicEvent,
) {
	<!doctype html>
	<html lang="en">
		@Head("Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation(accountName, csrfToken, reducedEffects, backstage)
			<main id="main-content" tabindex="-1">
				if setupRequired {
					<h1>Set up Beamers</h1>
					<p>Create the first Account using the one-time token printed by <code>beamers bootstrap</code>.</p>
					<p><a href="/setup">Continue setup</a></p>
				} else {
					<h1>Events</h1>
					if len(publicEvents) == 0 {
						<p>No public Events yet.</p>
					} else {
						for _, event := range publicEvents {
							if event.Active {
								<section>
									<h2>Featured Event</h2>
									@PublicEventSummary(event)
								</section>
							}
						}
						<section>
							<h2>Public Events</h2>
							<ul>
								for _, event := range publicEvents {
									if !event.Active {
										<li>@PublicEventSummary(event)</li>
									}
								}
							</ul>
						</section>
					}
				}
			</main>
		</body>
	</html>
}

templ PublicEventSummary(event events.PublicEvent) {
	<a href={ templ.SafeURL("/events/" + event.Slug) }>{ event.Name }</a>
	<span>
		<time datetime={ event.PlannedStartDate }>{ event.PlannedStartDate }</time>
		–
		<time datetime={ event.PlannedEndDate }>{ event.PlannedEndDate }</time>
	</span>
}

templ PublicEventHub(
	event events.PublicEvent,
	accountName string,
	csrfToken string,
	reducedEffects bool,
	backstage bool,
) {
	<!doctype html>
		<html lang={ event.EventLocale }>
		@EventHead(event.Name + " · Beamers", event.ID)
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@EventShell(Shell{
				AccountName: accountName,
				CSRFToken: csrfToken,
				ReturnTo: "/events/" + event.Slug,
				ReducedEffects: reducedEffects,
				Backstage: backstage,
				Event: EventContext{
					Name: event.Name,
					Slug: event.Slug,
					ActivePath: "/events/" + event.Slug,
					Breadcrumbs: []Breadcrumb{
						{Label: "Events", Href: "/"},
						{Label: event.Name},
					},
				},
			}) {
				<main id="main-content" tabindex="-1">
					<h1>{ event.Name }</h1>
					<p>
						<time datetime={ event.PlannedStartDate }>{ publicEventDate(event.PlannedStartDate, event.EventLocale) }</time>
						–
						<time datetime={ event.PlannedEndDate }>{ publicEventDate(event.PlannedEndDate, event.EventLocale) }</time>
					</p>
				</main>
			}
		</body>
	</html>
}

templ PublicEventUnavailable(
	event events.PublicEvent,
	accountName string,
	csrfToken string,
	reducedEffects bool,
	backstage bool,
	section string,
	message string,
) {
	<!doctype html>
	<html lang={ event.EventLocale }>
		@EventHead(event.Name + " " + section, event.ID)
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@EventShell(Shell{
				AccountName: accountName,
				CSRFToken: csrfToken,
				ReturnTo: "/events/" + event.Slug + "/" + strings.ToLower(section),
				ReducedEffects: reducedEffects,
				Backstage: backstage,
				Event: EventContext{
					Name: event.Name,
					Slug: event.Slug,
					ActivePath: "/events/" + event.Slug + "/" + strings.ToLower(section),
					Breadcrumbs: []Breadcrumb{
						{Label: "Events", Href: "/"},
						{Label: event.Name, Href: "/events/" + event.Slug},
						{Label: section},
					},
				},
			}) {
				<main id="main-content" tabindex="-1">
					<h1>{ event.Name } { section }</h1>
					<p>{ message }</p>
				</main>
			}
		</body>
	</html>
}

templ RecoveryPage(title string, message string) {
	<!doctype html>
	<html lang="en">
		@Head(title + " · Beamers")
		<body data-reduced-effects="false">
			@ShellNavigation(Shell{})
			<main id="main-content" tabindex="-1">
				<h1>{ title }</h1>
				<p>{ message }</p>
				<p><a href="/">Return to Events</a></p>
			</main>
		</body>
	</html>
}

templ Setup(
	csrfToken string,
	handle string,
	displayName string,
	errors FormErrors,
	reducedEffects bool,
) {
	<!doctype html>
	<html lang="en">
		@Head("Set up Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation("", csrfToken, reducedEffects, false)
			<main id="main-content" tabindex="-1">
				<h1>Set up Beamers</h1>
				@ErrorSummary(errors)
				<form class="stack" method="post" action="/setup">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<label for="setup-token">
						One-time setup token
					</label>
					<input id="setup-token" name="bootstrap_token" autocomplete="off" required { errors.Attributes("setup-token")... }/>
					@FieldError(errors, "setup-token")
					<label for="setup-handle">
						Account Handle
					</label>
					<input id="setup-handle" name="handle" value={ handle } autocomplete="username" maxlength="200" required { errors.Attributes("setup-handle")... }/>
					@FieldError(errors, "setup-handle")
					<label for="setup-display-name">
						Display Name
					</label>
					<input id="setup-display-name" name="display_name" value={ displayName } autocomplete="name" maxlength="200" required { errors.Attributes("setup-display-name")... }/>
					@FieldError(errors, "setup-display-name")
					<label for="setup-password">
						Password
					</label>
					<input id="setup-password" type="password" name="password" autocomplete="new-password" minlength="12" maxlength="1024" required { errors.Attributes("setup-password")... }/>
					@FieldError(errors, "setup-password")
					<button type="submit">Create first Account</button>
				</form>
			</main>
		</body>
	</html>
}

templ SignIn(
	csrfToken string,
	handle string,
	returnTo string,
	errors FormErrors,
	sceneID bool,
	reducedEffects bool,
) {
	<!doctype html>
	<html lang="en">
		@Head("Sign in · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation("", csrfToken, reducedEffects, false)
			<main id="main-content" tabindex="-1">
				<h1>Sign in</h1>
				@ErrorSummary(errors)
				<form
					class="stack"
					method="post"
					action="/sign-in"
					data-webauthn-sign-in-form
					data-return-to={ returnTo }
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="return_to" value={ returnTo }/>
					<label for="sign-in-handle">
						Account Handle
					</label>
					<input id="sign-in-handle" name="handle" value={ handle } autocomplete="username" required { errors.Attributes("sign-in-handle")... }/>
					@FieldError(errors, "sign-in-handle")
					<label for="sign-in-password">
						Password
					</label>
					<input id="sign-in-password" type="password" name="password" autocomplete="current-password" required { errors.Attributes("sign-in-password")... }/>
					@FieldError(errors, "sign-in-password")
					<button type="submit">Sign in</button>
					<button type="button" data-webauthn-sign-in hidden>Sign in with passkey or security key</button>
				</form>
				<p data-webauthn-status role="status"></p>
				if sceneID {
					<p><a href={ templ.SafeURL("/auth/federation/sceneid/begin?return_to=" + url.QueryEscape(returnTo)) }>Sign in with SceneID</a></p>
				}
				<p><a href="/recover">Use a Recovery Code or Administrator Recovery Token</a></p>
			</main>
			<script src={ WebAuthnPath } defer></script>
		</body>
	</html>
}

templ Recover(
	csrfToken string,
	handle string,
	commandID string,
	errors FormErrors,
	reducedEffects bool,
) {
	<!doctype html>
	<html lang="en">
		@Head("Recover Account · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation("", csrfToken, reducedEffects, false)
			<main id="main-content" tabindex="-1">
				<h1>Recover Account</h1>
				@ErrorSummary(errors)
				<form class="stack" method="post" action="/recover">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="command_id" value={ commandID }/>
					<label for="recover-handle">
						Account Handle
					</label>
					<input id="recover-handle" name="handle" value={ handle } autocomplete="username" required { errors.Attributes("recover-handle")... }/>
					@FieldError(errors, "recover-handle")
					<label for="recover-credential">
						Recovery Code or Administrator Recovery Token
					</label>
					<input id="recover-credential" name="credential" autocomplete="one-time-code" required { errors.Attributes("recover-credential")... }/>
					@FieldError(errors, "recover-credential")
					<label for="recover-password">
						New Password
					</label>
					<input id="recover-password" type="password" name="password" autocomplete="new-password" minlength="12" maxlength="1024" required { errors.Attributes("recover-password")... }/>
					@FieldError(errors, "recover-password")
					<button type="submit">Recover Account</button>
				</form>
			</main>
		</body>
	</html>
}

templ SkipLink(mainID string) {
	<a class="skip-link" href={ templ.SafeURL("#" + mainID) }>Skip to main content</a>
}
