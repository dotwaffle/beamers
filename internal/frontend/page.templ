package frontend

import "net/url"
import "strconv"

import "github.com/dotwaffle/beamers/internal/auth"
import "github.com/dotwaffle/beamers/internal/events"

type BackstageNavigation struct {
	Administrator bool
	Events        []BackstageEvent
}

type BackstageEvent struct {
	ID       int
	Role     string
	Sections []BackstageSection
}

type BackstageSection struct {
	ID    string
	Label string
	Href  string
}

templ Head(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<link rel="stylesheet" href={ StylesheetPath }/>
		<link rel="stylesheet" href={ InstallationThemePath }/>
		<title>{ title }</title>
	</head>
}

templ Navigation(accountName string, csrfToken string, reducedEffects bool, backstage bool) {
	<header>
		<nav aria-label="Primary">
			<a href="/">Beamers</a>
			<a href="/schedule">Schedule</a>
			if accountName == "" {
				<a href="/sign-in">Sign in</a>
				<a href="/register">Register</a>
			} else {
				<span>{ accountName }</span>
				<a href="/profile">Profile</a>
				<a href="/submissions">Submissions</a>
				<a href="/voting">Voting</a>
				if backstage {
					<a href="/backstage">Backstage</a>
				}
				<form method="post" action="/sign-out">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit">Sign out</button>
				</form>
			}
			<form method="post" action="/effects">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<button
					type="submit"
					name="reduce_effects"
					value={ strconv.FormatBool(!reducedEffects) }
					aria-pressed={ strconv.FormatBool(reducedEffects) }
				>
					if reducedEffects {
						Resume effects
					} else {
						Pause effects
					}
				</button>
			</form>
		</nav>
	</header>
}

templ Register(
	csrfToken string,
	message string,
	handle string,
	displayName string,
	open bool,
	sceneIDCreation bool,
	reducedEffects bool,
) {
	<!doctype html>
	<html lang="en">
		@Head("Register · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation("", csrfToken, reducedEffects, false)
			<main>
				<h1>Register</h1>
				if message != "" {
					<p class="error" role="alert">{ message }</p>
				}
				if open {
					if sceneIDCreation {
						<p><a href="/auth/federation/sceneid/begin">Create Account with SceneID</a></p>
					}
					<form class="stack" method="post" action="/register">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<label>
							Account Handle
							<input name="handle" value={ handle } autocomplete="username" maxlength="200" required/>
						</label>
						<label>
							Display Name
							<input name="display_name" value={ displayName } autocomplete="name" maxlength="200" required/>
						</label>
						<label>
							Password
							<input type="password" name="password" autocomplete="new-password" minlength="12" required/>
						</label>
						<button type="submit">Create Account</button>
					</form>
				} else {
					<p>Registration is closed.</p>
				}
			</main>
		</body>
	</html>
}

templ ProfilePage(
	csrfToken string,
	profile auth.Profile,
	passwordActive bool,
	canRemovePassword bool,
	credentials []auth.WebAuthnCredential,
	sceneIDConfigured bool,
	recoveryCodes []string,
	recoveryCommandID string,
	credentialCommandID string,
	reducedEffects bool,
	backstage bool,
) {
	<!doctype html>
	<html lang="en">
		@Head("Profile · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation(profile.DisplayName, csrfToken, reducedEffects, backstage)
			<main>
				<h1>Profile</h1>
				<p>Account Handle: <strong>{ profile.Handle }</strong></p>
				<form class="stack" method="post" action="/profile">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<label>
						Display Name
						<input name="display_name" value={ profile.DisplayName } autocomplete="name" maxlength="200" required/>
					</label>
					<label>
						<input type="checkbox" name="published" value="true" checked?={ profile.Published }/>
						Publish my Profile
					</label>
					for _, entry := range profile.AvailableEntries {
						<label>
							<input type="checkbox" name="entry_id" value={ strconv.Itoa(entry.ID) } checked?={ entry.Selected }/>
							{ entry.Name }
						</label>
					}
					<button type="submit">Save Profile</button>
				</form>
				if profile.Published {
					<p><a href={ templ.SafeURL("/people/" + profile.Handle) }>View Public Profile</a></p>
				}
				<section>
					<h2>Sign-in Credentials</h2>
					<p data-webauthn-status role="status">Checking WebAuthn availability…</p>
					<div class="stack" data-webauthn-registration hidden>
						<label>
							Credential name
							<input data-webauthn-name maxlength="200" autocomplete="off" required/>
						</label>
						<button type="button" data-webauthn-register>Register passkey or security key</button>
					</div>
					if passwordActive {
						<p>Password Credential: active</p>
						if canRemovePassword {
							<form method="post" action="/profile">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<input type="hidden" name="action" value="remove-password"/>
								<input type="hidden" name="command_id" value={ credentialCommandID + "-remove-password" }/>
								<button type="submit">Remove password</button>
							</form>
						} else {
							<p>Register another Credential before removing your password.</p>
						}
					} else {
						<p>Password Credential: removed</p>
					}
					if sceneIDConfigured {
						<form method="post" action="/auth/federation/sceneid/begin">
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<input type="hidden" name="mode" value="link"/>
							<button type="submit">Link SceneID</button>
						</form>
					}
					if len(credentials) == 0 {
						<p>No WebAuthn Credentials registered.</p>
					} else {
						<ul>
							for _, credential := range credentials {
								<li>
									<strong>{ credential.Name }</strong>
									if credential.Attachment != "" {
										<span> ({ credential.Attachment })</span>
									}
									if credential.Revoked {
										<span> — revoked</span>
									} else {
										<span> — active</span>
										<form method="post" action="/profile">
											<input type="hidden" name="csrf_token" value={ csrfToken }/>
											<input type="hidden" name="action" value="revoke-webauthn"/>
											<input type="hidden" name="credential_id" value={ strconv.Itoa(credential.ID) }/>
											<input type="hidden" name="command_id" value={ credentialCommandID + "-revoke-" + strconv.Itoa(credential.ID) }/>
											<button type="submit">Revoke</button>
										</form>
									}
								</li>
							}
						</ul>
					}
				</section>
				<section>
					<h2>Account recovery</h2>
					if len(recoveryCodes) > 0 {
						<p role="status">Save these Recovery Codes now. They will not be shown again.</p>
						<ul>
							for _, code := range recoveryCodes {
								<li><code data-recovery-code>{ code }</code></li>
							}
						</ul>
					}
					<form method="post" action="/profile">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<input type="hidden" name="action" value="replace-recovery-codes"/>
						<input type="hidden" name="command_id" value={ recoveryCommandID }/>
						<button type="submit">Replace Recovery Codes</button>
					</form>
				</section>
			</main>
			<script src={ WebAuthnPath } defer></script>
		</body>
	</html>
}

templ PublicProfile(profile auth.Profile, csrfToken string, reducedEffects bool) {
	<!doctype html>
	<html lang="en">
		@Head(profile.DisplayName + " · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation("", csrfToken, reducedEffects, false)
			<main>
				<h1>{ profile.DisplayName }</h1>
				if len(profile.Entries) > 0 {
					<h2>Released Entries</h2>
					<ul>
						for _, entry := range profile.Entries {
							<li>{ entry.Name }</li>
						}
					</ul>
				}
			</main>
		</body>
	</html>
}

templ BackstageLinks(navigation BackstageNavigation) {
	<nav class="backstage-links" aria-label="Backstage">
		if navigation.Administrator {
			<section>
				<h2>Installation</h2>
					<ul>
						<li><a href="/backstage/events/new">Create Event</a></li>
						<li><a href="/backstage/administration">Accounts, Event Grants, and activation</a></li>
						<li><a href="/backstage/themes">Installation Theme</a></li>
					<li><a href="/admin/registration">Registration</a></li>
					<li><a href="/backstage/installation">Backups and diagnostics</a></li>
				</ul>
			</section>
		}
		for _, event := range navigation.Events {
			<section>
				<h2>Event #{ strconv.Itoa(event.ID) }</h2>
				<p>{ event.Role }</p>
				<ul>
					for _, section := range event.Sections {
						<li><a href={ templ.SafeURL(section.Href) }>{ section.Label }</a></li>
					}
				</ul>
			</section>
		}
	</nav>
}

templ BackstageNavigationViews(navigation BackstageNavigation) {
	<details class="backstage-drawer">
		<summary>Backstage navigation</summary>
		@BackstageLinks(navigation)
	</details>
	<aside class="backstage-sidebar">
		@BackstageLinks(navigation)
	</aside>
}

templ Backstage(
	accountName string,
	csrfToken string,
	reducedEffects bool,
	navigation BackstageNavigation,
) {
	<!doctype html>
	<html lang="en">
		@Head("Backstage · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation(accountName, csrfToken, reducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(navigation)
				<main>
					<h1>Backstage</h1>
					if navigation.Administrator {
						<section id="administration">
							<h2>Accounts, Event Grants, and activation</h2>
						</section>
					}
					for _, event := range navigation.Events {
						<section>
							<h2>Event #{ strconv.Itoa(event.ID) } · { event.Role }</h2>
							for _, section := range event.Sections {
								<h3 id={ section.ID }>{ section.Label }</h3>
							}
						</section>
					}
				</main>
			</div>
		</body>
	</html>
}

templ RegistrationPolicy(
	csrfToken string,
	open bool,
	reducedEffects bool,
	accountName string,
	navigation BackstageNavigation,
) {
	<!doctype html>
	<html lang="en">
		@Head("Registration · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation(accountName, csrfToken, reducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(navigation)
				<main>
					<h1>Registration</h1>
					<form class="stack" method="post" action="/admin/registration">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<label>
							<input type="checkbox" name="registration_open" value="true" checked?={ open }/>
							Allow new Accounts
						</label>
						<button type="submit">Save Registration Policy</button>
					</form>
				</main>
			</div>
		</body>
	</html>
}

templ Root(
	setupRequired bool,
	accountName string,
	csrfToken string,
	reducedEffects bool,
	backstage bool,
	publicEvents []events.PublicEvent,
) {
	<!doctype html>
	<html lang="en">
		@Head("Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation(accountName, csrfToken, reducedEffects, backstage)
			<main>
				if setupRequired {
					<h1>Set up Beamers</h1>
					<p>Create the first Account using the one-time token printed by <code>beamers bootstrap</code>.</p>
					<p><a href="/setup">Continue setup</a></p>
				} else {
					<h1>Events</h1>
					if len(publicEvents) == 0 {
						<p>No public Events yet.</p>
					} else {
						for _, event := range publicEvents {
							if event.Active {
								<section>
									<h2>Featured Event</h2>
									@PublicEventSummary(event)
								</section>
							}
						}
						<section>
							<h2>Public Events</h2>
							<ul>
								for _, event := range publicEvents {
									if !event.Active {
										<li>@PublicEventSummary(event)</li>
									}
								}
							</ul>
						</section>
					}
				}
			</main>
		</body>
	</html>
}

templ PublicEventSummary(event events.PublicEvent) {
	<a href={ templ.SafeURL("/events/" + event.Slug) }>{ event.Name }</a>
	<span>
		<time datetime={ event.PlannedStartDate }>{ event.PlannedStartDate }</time>
		–
		<time datetime={ event.PlannedEndDate }>{ event.PlannedEndDate }</time>
	</span>
}

templ PublicEvent(
	event events.PublicEvent,
	csrfToken string,
	reducedEffects bool,
) {
	<!doctype html>
		<html lang={ event.EventLocale }>
		@Head(event.Name + " · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation("", csrfToken, reducedEffects, false)
			<main>
				<h1>{ event.Name }</h1>
				<p>
					<time datetime={ event.PlannedStartDate }>{ event.PlannedStartDate }</time>
					–
					<time datetime={ event.PlannedEndDate }>{ event.PlannedEndDate }</time>
				</p>
			</main>
		</body>
	</html>
}

templ Setup(csrfToken string, message string, reducedEffects bool) {
	<!doctype html>
	<html lang="en">
		@Head("Set up Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation("", csrfToken, reducedEffects, false)
			<main>
				<h1>Set up Beamers</h1>
				if message != "" {
					<p class="error" role="alert">{ message }</p>
				}
				<form class="stack" method="post" action="/setup">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<label>
						One-time setup token
						<input name="bootstrap_token" autocomplete="off" required/>
					</label>
					<label>
						Account Handle
						<input name="handle" autocomplete="username" maxlength="200" required/>
					</label>
					<label>
						Display Name
						<input name="display_name" autocomplete="name" maxlength="200" required/>
					</label>
					<label>
						Password
						<input type="password" name="password" autocomplete="new-password" minlength="12" required/>
					</label>
					<button type="submit">Create first Account</button>
				</form>
			</main>
		</body>
	</html>
}

templ SignIn(csrfToken string, message string, handle string, returnTo string, sceneID bool, reducedEffects bool) {
	<!doctype html>
	<html lang="en">
		@Head("Sign in · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation("", csrfToken, reducedEffects, false)
			<main>
				<h1>Sign in</h1>
				if message != "" {
					<p class="error" role="alert">{ message }</p>
				}
				<form
					class="stack"
					method="post"
					action="/sign-in"
					data-webauthn-sign-in-form
					data-return-to={ returnTo }
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="return_to" value={ returnTo }/>
					<label>
						Account Handle
						<input name="handle" value={ handle } autocomplete="username" required/>
					</label>
					<label>
						Password
						<input type="password" name="password" autocomplete="current-password" required/>
					</label>
					<button type="submit">Sign in</button>
					<button type="button" data-webauthn-sign-in hidden>Sign in with passkey or security key</button>
				</form>
				<p data-webauthn-status role="status"></p>
				if sceneID {
					<p><a href={ templ.SafeURL("/auth/federation/sceneid/begin?return_to=" + url.QueryEscape(returnTo)) }>Sign in with SceneID</a></p>
				}
				<p><a href="/recover">Use a Recovery Code or Administrator Recovery Token</a></p>
			</main>
			<script src={ WebAuthnPath } defer></script>
		</body>
	</html>
}

templ Recover(csrfToken string, message string, handle string, commandID string, reducedEffects bool) {
	<!doctype html>
	<html lang="en">
		@Head("Recover Account · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(reducedEffects) }>
			@Navigation("", csrfToken, reducedEffects, false)
			<main>
				<h1>Recover Account</h1>
				if message != "" {
					<p class="error" role="alert">{ message }</p>
				}
				<form class="stack" method="post" action="/recover">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="command_id" value={ commandID }/>
					<label>
						Account Handle
						<input name="handle" value={ handle } autocomplete="username" required/>
					</label>
					<label>
						Recovery Code or Administrator Recovery Token
						<input name="credential" autocomplete="one-time-code" required/>
					</label>
					<label>
						New Password
						<input type="password" name="password" autocomplete="new-password" minlength="12" required/>
					</label>
					<button type="submit">Recover Account</button>
				</form>
			</main>
		</body>
	</html>
}
