package frontend

import "net/url"
import "strconv"

import "github.com/dotwaffle/beamers/internal/attachments"
import "github.com/dotwaffle/beamers/internal/events"
import "github.com/dotwaffle/beamers/internal/rundown"

type EventOverviewPage struct {
	AccountName     string
	CSRFToken       string
	ReducedEffects  bool
	Navigation      BackstageNavigation
	Event           events.Event
	Active          bool
	AttachmentRelease events.AttachmentReleaseState
	Rundown         rundown.PublishPreview
	Role            string
	Producer        bool
	Administrator   bool
}

type EventSettingsPage struct {
	AccountName     string
	CSRFToken       string
	ReducedEffects  bool
	Navigation      BackstageNavigation
	Event           events.Event
	Release         attachments.ReleaseCuePreview
	Ceremonies      []rundown.CrewSession
	CommandID       string
	SubmittedAction string
	Form            url.Values
	Errors          FormErrors
}

func (page EventSettingsPage) submitted(action string) bool {
	return page.Form != nil && page.SubmittedAction == action
}

func (page EventSettingsPage) value(action, field, fallback string) string {
	if page.submitted(action) {
		if _, ok := page.Form[field]; ok {
			return page.Form.Get(field)
		}
	}
	return fallback
}

func (page EventSettingsPage) checked(action, field string, fallback bool) bool {
	if page.submitted(action) {
		return page.Form.Get(field) == "true"
	}
	return fallback
}

// DisplayThresholdFields holds one editable timer-emphasis row.
type DisplayThresholdFields struct {
	Seconds  string
	Emphasis string
}

// DisplaySettingsForm holds submitted values for the Event Display settings editor.
type DisplaySettingsForm struct {
	RotationSeconds       string
	ReducedEffects        bool
	TimerThresholds       []DisplayThresholdFields
	SessionTypeOverrides  map[string]bool
	SessionTypeThresholds map[string][]DisplayThresholdFields
	SessionOverrides      map[int]bool
	SessionThresholds     map[int][]DisplayThresholdFields
}

// DisplaySettingsPage contains one Producer's Event Display settings workflow.
type DisplaySettingsPage struct {
	AccountName    string
	CSRFToken      string
	ReducedEffects bool
	Navigation     BackstageNavigation
	Event          events.Event
	EventRevision  int
	Draft          rundown.DraftRundown
	SessionTypes   []string
	Form           DisplaySettingsForm
	CommandID      string
	Errors         FormErrors
	ErrorSection   string
}

templ EventOverview(page EventOverviewPage) {
	<!doctype html>
	<html lang={ page.Event.EventLocale } data-locale={ page.Event.EventLocale }>
		@Head(page.Event.Name + " · Backstage · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(page.Navigation)
				<main id="main-content" tabindex="-1">
					<h1>{ page.Event.Name }</h1>
					<p>{ page.Role }</p>
					<section>
						<h2>Status</h2>
						<dl>
							if page.Producer {
								<dt><a href={ templ.SafeURL("/backstage/events/" + strconv.Itoa(page.Event.ID) + "/settings") }>Public visibility</a></dt>
							} else {
								<dt>Public visibility</dt>
							}
							if page.Event.Public {
								<dd>Listed in the Public Event Listing.</dd>
							} else {
								<dd>Not listed.</dd>
							}
							if page.Administrator {
								<dt><a href="/backstage/administration">Active Event</a></dt>
							} else {
								<dt>Active Event</dt>
							}
							if page.Active {
								<dd>Active.</dd>
							} else {
								<dd>Not active.</dd>
							}
							<dt>Attachment release</dt>
							if page.AttachmentRelease.Policy == events.AttachmentReleaseOnEnded {
								<dd>On Ended.</dd>
							} else if page.AttachmentRelease.Policy == events.AttachmentReleaseOnEventCue {
								if page.AttachmentRelease.CueAt.IsZero() {
									<dd>On Event Release Cue; cue not fired.</dd>
								} else {
									<dd>On Event Release Cue; cue fired.</dd>
								}
							} else {
								<dd>On Live.</dd>
							}
						</dl>
					</section>
					<section>
						<h2>Readiness</h2>
						<div class="tiles">
							<dl class="metric">
								if page.Producer {
									<dt><a href={ templ.SafeURL("/backstage/events/" + strconv.Itoa(page.Event.ID) + "/planning") }>Rundown readiness</a></dt>
								} else {
									<dt>Rundown readiness</dt>
								}
								if page.Rundown.PublishedRevision == 0 {
									<dd>No Rundown published.</dd>
								} else if len(page.Rundown.ValidationFailures) != 0 {
									<dd>Draft changes are blocked from publishing.</dd>
								} else if len(page.Rundown.ChangeIDs) != 0 {
									<dd>Draft changes await publishing.</dd>
								} else {
									<dd>Published Rundown is current.</dd>
								}
							</dl>
						</div>
					</section>
					<section>
						<h2>Next actions</h2>
						if page.Producer {
							<ul>
								<li><a href={ templ.SafeURL("/backstage/events/" + strconv.Itoa(page.Event.ID) + "/settings") }>Event settings</a></li>
								<li><a href={ templ.SafeURL("/backstage/events/" + strconv.Itoa(page.Event.ID) + "/planning") }>Plan and publish</a></li>
								if page.Active && page.Rundown.PublishedRevision > 0 {
									<li><a href={ templ.SafeURL("/backstage/events/" + strconv.Itoa(page.Event.ID) + "/operations") }>Open live operations</a></li>
								}
							</ul>
						} else {
							<p>This Event overview is read-only for your Event Grant.</p>
						}
					</section>
				</main>
			</div>
		</body>
	</html>
}

templ EventSettings(page EventSettingsPage) {
	<!doctype html>
	<html lang={ page.Event.EventLocale } data-locale={ page.Event.EventLocale }>
		@Head("Event settings · " + page.Event.Name + " · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(page.Navigation)
				<main id="main-content" tabindex="-1">
					<h1>Event settings</h1>
					<p>{ page.Event.Name }</p>
					@ErrorSummary(page.Errors)
					<p>
						Related:
						<a href={ templ.SafeURL("/backstage/events/" + strconv.Itoa(page.Event.ID) + "/display-settings") }>Event Display settings</a>
						and
						<a href={ templ.SafeURL("/backstage/events/" + strconv.Itoa(page.Event.ID) + "/theme") }>Event Theme</a>.
					</p>
					<form class="stack" method="post">
						<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
						<input type="hidden" name="command_id" value={ page.CommandID }/>
						<input type="hidden" name="expected_event_revision" value={ strconv.Itoa(page.Event.Revision) }/>
						<label for="event-name">Event name</label>
						<input
							id="event-name"
							name="event_name"
							value={ page.value("", "event_name", page.Event.Name) }
							required
							{ page.Errors.Attributes("event-name")... }
						/>
						@FieldError(page.Errors, "event-name")
						if page.Event.PublicSlug == "" {
							<p>A current Event Slug will be assigned when this Event first joins the Public Event Listing.</p>
						} else {
							<p>
								Current public URL:
								<a href={ templ.SafeURL("/events/" + page.Event.PublicSlug) }>
									/events/{ page.Event.PublicSlug }
								</a>
							</p>
							<label for="public-slug">Current Event Slug</label>
							<input
								id="public-slug"
								name="public_slug"
								value={ page.value("", "public_slug", page.Event.PublicSlug) }
								required
								{ page.Errors.Attributes("public-slug")... }
							/>
							@FieldError(page.Errors, "public-slug")
							<p>Previously public slugs are retained as redirects.</p>
						}
						<label for="event-public">
							<input
								id="event-public"
								type="checkbox"
								name="public"
								value="true"
								checked?={ page.checked("", "public", page.Event.Public) }
								{ page.Errors.Attributes("event-public")... }
							/>
							Include in the Public Event Listing
						</label>
						@FieldError(page.Errors, "event-public")
						<label for="planned-start-date">Planned start</label>
						<input
							id="planned-start-date"
							type="date"
							name="planned_start_date"
							value={ page.value("", "planned_start_date", page.Event.PlannedStartDate) }
							required
							{ page.Errors.Attributes("planned-start-date")... }
						/>
						@FieldError(page.Errors, "planned-start-date")
						<label for="planned-end-date">Planned end</label>
						<input
							id="planned-end-date"
							type="date"
							name="planned_end_date"
							value={ page.value("", "planned_end_date", page.Event.PlannedEndDate) }
							required
							{ page.Errors.Attributes("planned-end-date")... }
						/>
						@FieldError(page.Errors, "planned-end-date")
						<label for="event-timezone">Timezone</label>
						<input
							id="event-timezone"
							name="timezone"
							value={ page.value("", "timezone", page.Event.Timezone) }
							required
							{ page.Errors.Attributes("event-timezone")... }
						/>
						@FieldError(page.Errors, "event-timezone")
						<label for="event-locale">Event locale</label>
						<input
							id="event-locale"
							name="event_locale"
							value={ page.value("", "event_locale", page.Event.EventLocale) }
							required
							{ page.Errors.Attributes("event-locale")... }
						/>
						@FieldError(page.Errors, "event-locale")
						<label for="content-language">Content language</label>
						<input
							id="content-language"
							name="content_language"
							value={ page.value("", "content_language", page.Event.ContentLanguage) }
							{ page.Errors.Attributes("content-language")... }
						/>
						@FieldError(page.Errors, "content-language")
						<label for="event-day-boundary">Event day boundary</label>
						<input
							id="event-day-boundary"
							type="time"
							name="event_day_boundary"
							value={ page.value("", "event_day_boundary", page.Event.EventDayBoundary) }
							required
							{ page.Errors.Attributes("event-day-boundary")... }
						/>
						@FieldError(page.Errors, "event-day-boundary")
						<label for="entry-default-disposition">New Competition Entry disposition</label>
						<select
							id="entry-default-disposition"
							name="entry_default_disposition"
							{ page.Errors.Attributes("entry-default-disposition")... }
						>
							<option value="Pending" selected?={ page.value("", "entry_default_disposition", page.Event.EntryDefaultDisposition) == "Pending" }>Pending</option>
							<option value="Included" selected?={ page.value("", "entry_default_disposition", page.Event.EntryDefaultDisposition) == "Included" }>Included</option>
						</select>
						@FieldError(page.Errors, "entry-default-disposition")
						<label for="submission-eligibility">New Competition Submission Eligibility</label>
						<select
							id="submission-eligibility"
							name="submission_eligibility"
							{ page.Errors.Attributes("submission-eligibility")... }
						>
							<option value="AllAccounts" selected?={ page.value("", "submission_eligibility", page.Event.SubmissionEligibility) == "AllAccounts" }>All Accounts</option>
							<option value="VotingEligibleAccounts" selected?={ page.value("", "submission_eligibility", page.Event.SubmissionEligibility) == "VotingEligibleAccounts" }>Voting Eligible Accounts</option>
						</select>
						@FieldError(page.Errors, "submission-eligibility")
						<label for="voting-method">Competition Voting Method</label>
						<select
							id="voting-method"
							name="voting_method"
							{ page.Errors.Attributes("voting-method")... }
						>
								<option value="Range1To5">Range 1–5</option>
						</select>
						@FieldError(page.Errors, "voting-method")
						<label for="self-vote-policy">Competition Self-Vote Policy</label>
						<select
							id="self-vote-policy"
							name="self_vote_policy"
							{ page.Errors.Attributes("self-vote-policy")... }
						>
							<option value="Allowed" selected?={ page.value("", "self_vote_policy", page.Event.SelfVotePolicy) == "Allowed" }>Allowed</option>
							<option value="Neutral" selected?={ page.value("", "self_vote_policy", page.Event.SelfVotePolicy) == "Neutral" }>Neutral substitution</option>
						</select>
						@FieldError(page.Errors, "self-vote-policy")
						<label for="target-adjustment-presets">Target adjustment presets in seconds</label>
						<input
							id="target-adjustment-presets"
							name="target_adjustment_presets_seconds"
							value={ page.value("", "target_adjustment_presets_seconds", planningPresets(page.Event.TargetAdjustmentPresetsSeconds)) }
							{ page.Errors.Attributes("target-adjustment-presets")... }
						/>
						@FieldError(page.Errors, "target-adjustment-presets")
						<button type="submit">Save Event settings</button>
					</form>
					<section>
						<h2>Attachment release</h2>
						<p>Competition release policies remain editable on their Competition pages.</p>
						<form class="stack" method="post">
							<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
							<input type="hidden" name="action" value="configure-attachment-release"/>
							<input type="hidden" name="command_id" value={ page.CommandID }/>
							<input type="hidden" name="expected_release_revision" value={ strconv.Itoa(page.Release.Configuration.Revision) }/>
							<label for="release-policy">Event Release Policy</label>
							<select
								id="release-policy"
								name="release_policy"
								{ page.Errors.Attributes("release-policy")... }
							>
								<option value="OnLive" selected?={ page.value("configure-attachment-release", "release_policy", string(page.Release.Configuration.Policy)) == "OnLive" }>On Live</option>
								<option value="OnEnded" selected?={ page.value("configure-attachment-release", "release_policy", string(page.Release.Configuration.Policy)) == "OnEnded" }>On Ended</option>
								<option value="OnEventReleaseCue" selected?={ page.value("configure-attachment-release", "release_policy", string(page.Release.Configuration.Policy)) == "OnEventReleaseCue" }>On Event Release Cue</option>
							</select>
							@FieldError(page.Errors, "release-policy")
							<label for="cue-session">Optional release Ceremony</label>
							<select
								id="cue-session"
								name="cue_session_id"
								{ page.Errors.Attributes("cue-session")... }
							>
									<option value="">No ceremony binding</option>
									for _, session := range page.Ceremonies {
										<option
											value={ strconv.Itoa(session.ID) }
											selected?={ page.value("configure-attachment-release", "cue_session_id", strconv.Itoa(page.Release.Configuration.CueSessionID)) == strconv.Itoa(session.ID) }
										>{ session.Title }</option>
									}
							</select>
							@FieldError(page.Errors, "cue-session")
							<button type="submit">Save Attachment release</button>
						</form>
						<h3>Event Release Cue</h3>
						<dl>
							<dt>Current cue state</dt>
							if page.Release.Configuration.CueAt.IsZero() {
								<dd>Cue not fired.</dd>
							} else {
								<dd>Cue fired.</dd>
							}
							<dt>Eligible Final Versions</dt>
							<dd>{ strconv.Itoa(page.Release.Eligible) }</dd>
							<dt>Held Final Versions</dt>
							<dd>{ strconv.Itoa(page.Release.Held) }</dd>
							<dt>Blocked Final Versions</dt>
							<dd>{ strconv.Itoa(page.Release.Blocked) }</dd>
						</dl>
						if page.Release.BlockedByUnresolvedEntries {
							<p class="error" role="alert">
								Release is blocked by unresolved Entries. Resolve them, then reload this preview.
							</p>
						}
						if page.Release.Configuration.Policy == attachments.ReleaseOnEventCue &&
							page.Release.Configuration.CueAt.IsZero() &&
							!page.Release.BlockedByUnresolvedEntries {
							<form class="stack" method="post">
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="fire-attachment-release-cue"/>
								<input type="hidden" name="command_id" value={ page.CommandID }/>
								<input type="hidden" name="expected_release_revision" value={ strconv.Itoa(page.Release.Configuration.Revision) }/>
								<input type="hidden" name="preview_fingerprint" value={ page.Release.Fingerprint }/>
								<label for="release-cue-confirmed">
									<input
										id="release-cue-confirmed"
										type="checkbox"
										name="confirmed"
										value="true"
										required
										{ page.Errors.Attributes("release-cue-confirmed")... }
									/>
									I reviewed this impact and confirm the Event Release Cue.
								</label>
								@FieldError(page.Errors, "release-cue-confirmed")
								<button type="submit">Fire Event Release Cue</button>
							</form>
						}
					</section>
				</main>
			</div>
		</body>
	</html>
}

templ DisplaySettings(page DisplaySettingsPage) {
	<!doctype html>
	<html lang={ page.Event.EventLocale } data-locale={ page.Event.EventLocale }>
		@Head("Event Display settings · " + page.Event.Name + " · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(page.Navigation)
				<main id="main-content" tabindex="-1">
					<h1>Event Display settings</h1>
					<p>{ page.Event.Name }</p>
					<p>
						Branding and colors remain in the
						<a href={ templ.SafeURL("/backstage/events/" + strconv.Itoa(page.Event.ID) + "/theme") }>Event Theme</a>
						workflow.
					</p>
					@ErrorSummary(page.Errors)
					<form class="stack" method="post">
						<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
						<input type="hidden" name="command_id" value={ page.CommandID }/>
						<input type="hidden" name="expected_event_revision" value={ strconv.Itoa(page.EventRevision) }/>
						<label for="rotation_seconds">Rotation interval in seconds</label>
						<input
							id="rotation_seconds"
							type="number"
							name="rotation_seconds"
							min="5"
							max="300"
							value={ page.Form.RotationSeconds }
							required
							{ page.Errors.Attributes("rotation_seconds")... }
						/>
						@FieldError(page.Errors, "rotation_seconds")
						<label>
							<input
								type="checkbox"
								name="reduced_effects"
								value="true"
								checked?={ page.Form.ReducedEffects }
							/>
							Reduce Display motion and effects
						</label>
						<fieldset>
							<legend>Default timer thresholds</legend>
							<p>Set remaining seconds and an attention or urgent emphasis. Leave a row empty to remove it.</p>
							@displayThresholdRows("timer_threshold", page.Form.TimerThresholds, page.Errors)
						</fieldset>
						<details open?={ page.ErrorSection == "session-type" }>
							<summary>Session-type overrides</summary>
							for _, sessionType := range page.SessionTypes {
								<fieldset>
									<legend>{ sessionType }</legend>
									<label>
										<input
											type="checkbox"
											name={ "session_type." + sessionType + ".threshold_override" }
											value="true"
											checked?={ page.Form.SessionTypeOverrides[sessionType] }
										/>
										Override Event defaults
									</label>
									<p>Leave all rows empty to use no thresholds. Clear the checkbox to inherit Event defaults.</p>
									@displayThresholdRows(
										"session_type." + sessionType + ".threshold",
										page.Form.SessionTypeThresholds[sessionType],
										page.Errors,
									)
								</fieldset>
							}
						</details>
						<details open?={ page.ErrorSection == "session" }>
							<summary>Individual Session overrides</summary>
							if len(page.Draft.Sessions) == 0 {
								<p>Add named Sessions in Plan and publish before configuring overrides.</p>
							}
							for _, session := range page.Draft.Sessions {
								<fieldset>
									<legend>{ session.Title } ({ string(session.Type) })</legend>
									<label>
										<input
											type="checkbox"
											name={ "session." + strconv.Itoa(session.ID) + ".threshold_override" }
											value="true"
											checked?={ page.Form.SessionOverrides[session.ID] }
										/>
										Override Event and Session-type defaults
									</label>
									<p>Leave all rows empty to use no thresholds. Clear the checkbox to inherit.</p>
									@displayThresholdRows(
										"session." + strconv.Itoa(session.ID) + ".threshold",
										page.Form.SessionThresholds[session.ID],
										page.Errors,
									)
								</fieldset>
							}
						</details>
						<button type="submit">Save Event Display settings</button>
					</form>
				</main>
			</div>
		</body>
	</html>
}

templ displayThresholdRows(prefix string, rows []DisplayThresholdFields, errors FormErrors) {
	for index, row := range rows {
		<div>
			<label for={ displayThresholdFieldID(prefix, "seconds", index) }>Remaining seconds</label>
			<input
				id={ displayThresholdFieldID(prefix, "seconds", index) }
				type="number"
				name={ prefix + "_seconds" }
				min="1"
				max="86400"
				value={ row.Seconds }
				{ errors.Attributes(displayThresholdFieldID(prefix, "seconds", index))... }
			/>
			@FieldError(errors, displayThresholdFieldID(prefix, "seconds", index))
			<label for={ displayThresholdFieldID(prefix, "emphasis", index) }>Emphasis</label>
			<select
				id={ displayThresholdFieldID(prefix, "emphasis", index) }
				name={ prefix + "_emphasis" }
				{ errors.Attributes(displayThresholdFieldID(prefix, "emphasis", index))... }
			>
				<option value="" selected?={ row.Emphasis == "" }>No threshold</option>
				<option value="attention" selected?={ row.Emphasis == "attention" }>Attention</option>
				<option value="urgent" selected?={ row.Emphasis == "urgent" }>Urgent</option>
			</select>
			@FieldError(errors, displayThresholdFieldID(prefix, "emphasis", index))
			<span class="visually-hidden">Threshold row { strconv.Itoa(index + 1) }</span>
		</div>
	}
}

func displayThresholdFieldID(prefix, kind string, index int) string {
	return prefix + "-" + kind + "-" + strconv.Itoa(index)
}

// FinalFilesPage contains one Administrator's reviewed Event export preview.
type FinalFilesPage struct {
	AccountName    string
	CSRFToken      string
	ReducedEffects bool
	Navigation     BackstageNavigation
	Event          events.Event
	Plan           attachments.FinalFilesPlan
	TotalSize      int64
	Errors         FormErrors
}

// FinalFiles renders the digest-bound Final Files Export workflow.
templ FinalFiles(page FinalFilesPage) {
	<!doctype html>
	<html lang={ page.Event.EventLocale } data-locale={ page.Event.EventLocale }>
		@Head("Final Files Export · " + page.Event.Name + " · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(page.Navigation)
				<main id="main-content" tabindex="-1">
					<h1>Final Files Export</h1>
					<p>{ page.Event.Name }</p>
					@ErrorSummary(page.Errors)
					<section>
						<h2>Exact preview</h2>
						<dl>
							<dt>Files</dt>
							<dd>{ strconv.Itoa(len(page.Plan.Files)) }</dd>
							<dt>Total size</dt>
							<dd>{ strconv.FormatInt(page.TotalSize, 10) } bytes</dd>
							<dt>Collisions</dt>
							if len(page.Plan.Collisions) == 0 {
								<dd>None.</dd>
							} else {
								<dd>
									<ul>
										for _, collision := range page.Plan.Collisions {
											<li><code>{ collision }</code></li>
										}
									</ul>
								</dd>
							}
						</dl>
						<div class="table-scroll">
						<table>
							<caption>Files included in this exact export preview</caption>
							<thead>
								<tr>
									<th scope="col">Session</th>
									<th scope="col">Competition</th>
									<th scope="col">Entry</th>
									<th scope="col">Original filename</th>
									<th scope="col">Exact output path</th>
									<th scope="col">Size</th>
									<th scope="col">SHA-256</th>
								</tr>
							</thead>
							<tbody>
								for _, file := range page.Plan.Files {
									<tr>
										<td>{ file.SessionTitle }</td>
										if file.EntryID == 0 {
											<td>—</td>
											<td>—</td>
										} else {
											<td>{ file.SessionTitle }</td>
											<td>{ file.EntryName }</td>
										}
										<td>{ file.OriginalFilename }</td>
										<td><code>{ file.Path }</code></td>
										<td>{ strconv.FormatInt(file.SizeBytes, 10) } bytes</td>
										<td><code>{ file.SHA256 }</code></td>
									</tr>
								}
							</tbody>
						</table>
						</div>
					</section>
					<form class="stack" method="post">
						<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
						<input type="hidden" name="preview_digest" value={ page.Plan.PreviewDigest }/>
						<label>
							<input
								id="final-files-confirmed"
								type="checkbox"
								name="confirmed"
								value="true"
								required
								{ page.Errors.Attributes("final-files-confirmed")... }
							/>
							I reviewed this exact preview and confirm the ZIP download.
						</label>
						@FieldError(page.Errors, "final-files-confirmed")
						<button type="submit">Download Final Files ZIP</button>
					</form>
				</main>
			</div>
		</body>
	</html>
}
