package frontend

import (
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/dotwaffle/beamers/internal/competition"
	"github.com/dotwaffle/beamers/internal/displays"
	"github.com/dotwaffle/beamers/internal/displayviews"
	"github.com/dotwaffle/beamers/internal/events"
	"github.com/dotwaffle/beamers/internal/rundown"
	"github.com/dotwaffle/beamers/internal/sessioncontrol"
)

// OperationsPage contains current Session and Display operations state.
type OperationsPage struct {
	AccountName           string
	CSRFToken             string
	ReducedEffects        bool
	Navigation            BackstageNavigation
	Event                 events.Event
	Rundown               rundown.CrewRundown
	Displays              []displays.Status
	DisplaysAvailable     bool
	CommandIDs            map[string]string
	OperableSessionIDs    map[int]bool
	DisplayCommandIDs     map[int]string
	EnrollmentCommandID   string
	CanAdministerDisplays bool
	CanProduce            bool
	TargetPreview         *sessioncontrol.TargetPreview
	EndPreflight          *competition.EndPreflight
	PreviewSessionID      int
	PreviewRevision       int
	Adjustment            time.Duration
	ReinstatePreview      *sessioncontrol.ReinstatePreview
	ForecastStart         time.Time
	LaneIDs               []int
	LocationIDs           []int
	SubmittedAction       string
	Form                  url.Values
	Errors                FormErrors
}

func OperationFieldID(action string, id int, field string) string {
	if id > 0 {
		action += "-" + strconv.Itoa(id)
	}
	return action + "-" + strings.ReplaceAll(field, "_", "-")
}

func (page OperationsPage) submitted(action string, id int) bool {
	if page.SubmittedAction != action {
		return false
	}
	switch action {
	case "assign-display":
		return page.Form.Get("display_id") == strconv.Itoa(id)
	case "enroll-display":
		return true
	default:
		return page.Form.Get("session_id") == strconv.Itoa(id)
	}
}

func (page OperationsPage) value(action string, id int, field, fallback string) string {
	if page.submitted(action, id) && field != "code" {
		if _, ok := page.Form[field]; ok {
			return page.Form.Get(field)
		}
	}
	return fallback
}

// Operations renders authorized Session and Display controls.
templ Operations(page OperationsPage) {
	<!doctype html>
	<html lang="en">
		@Head("Sessions and Displays · Beamers")
		<body data-reduced-effects={ strconv.FormatBool(page.ReducedEffects) }>
			@Navigation(page.AccountName, page.CSRFToken, page.ReducedEffects, true)
			<div class="backstage-layout">
				@BackstageNavigationViews(page.Navigation)
				<main id="main-content" tabindex="-1">
					<h1>Sessions and Displays</h1>
					<p>{ page.Event.Name }</p>
					@ErrorSummary(page.Errors)
					<section>
						<h2>Sessions</h2>
						if liveSessionAnchor(page.Rundown.Sessions) != "" {
							<a class="follow-live" href={ liveSessionAnchor(page.Rundown.Sessions) }>Jump to the Live Session</a>
						}
						for _, session := range page.Rundown.Sessions {
							<article
								id={ sessionAnchorID(session.ID) }
								class="rundown-row stack"
								data-row-state={ rundownRowState(session.Lifecycle) }
							>
								<div class="split">
									<h3>{ session.Title }</h3>
									@StateAxes(page.Rundown.PublishedRevision > 0, session.Lifecycle, session.AudienceVisibility)
								</div>
								<p>revision <code>{ strconv.Itoa(session.LiveStateRevision) }</code></p>
								if session.Lifecycle == rundown.SessionScheduled && page.OperableSessionIDs[session.ID] {
									@sessionOperationForm(page, session, "start-session", "Start Session")
									@cancelSessionForm(page, session)
								}
								if session.Lifecycle == rundown.SessionLive && page.OperableSessionIDs[session.ID] {
									if session.Type == rundown.SessionCompetition {
										@sessionOperationForm(page, session, "preview-end-session", "Preview End Session")
									} else {
										@sessionOperationForm(page, session, "end-session", "End Session")
									}
									@cancelSessionForm(page, session)
									<form class="stack" method="post" action={ operationsPath(page.Event.ID) }>
										<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
										<input type="hidden" name="action" value="preview-adjust-target"/>
										<input type="hidden" name="session_id" value={ strconv.Itoa(session.ID) }/>
										<input type="hidden" name="expected_live_state_revision" value={ strconv.Itoa(session.LiveStateRevision) }/>
										<label for={ OperationFieldID("preview-adjust-target", session.ID, "adjustment") }>Target adjustment</label>
										<input
											id={ OperationFieldID("preview-adjust-target", session.ID, "adjustment") }
											name="adjustment"
											value={ page.value("preview-adjust-target", session.ID, "adjustment", "5m") }
											required
											{ page.Errors.Attributes(OperationFieldID("preview-adjust-target", session.ID, "adjustment"))... }
										/>
										@FieldError(page.Errors, OperationFieldID("preview-adjust-target", session.ID, "adjustment"))
										<button type="submit">Preview Adjust Target</button>
									</form>
								}
								if session.Lifecycle == rundown.SessionCanceled && page.CanProduce &&
									page.OperableSessionIDs[session.ID] {
									<form class="stack" method="post" action={ operationsPath(page.Event.ID) }>
										<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
										<input type="hidden" name="action" value="preview-reinstate"/>
										<input type="hidden" name="session_id" value={ strconv.Itoa(session.ID) }/>
										<input type="hidden" name="expected_live_state_revision" value={ strconv.Itoa(session.LiveStateRevision) }/>
										<label for={ OperationFieldID("preview-reinstate", session.ID, "forecast_start") }>
											New Forecast Start ({ page.Event.Timezone })
										</label>
										<input
											id={ OperationFieldID("preview-reinstate", session.ID, "forecast_start") }
											type="datetime-local"
											name="forecast_start"
											value={ page.value("preview-reinstate", session.ID, "forecast_start", "") }
											required
											{ page.Errors.Attributes(OperationFieldID("preview-reinstate", session.ID, "forecast_start"))... }
										/>
										@FieldError(page.Errors, OperationFieldID("preview-reinstate", session.ID, "forecast_start"))
										<label for={ OperationFieldID("preview-reinstate", session.ID, "lane_ids") }>Lane IDs</label>
										<input
											id={ OperationFieldID("preview-reinstate", session.ID, "lane_ids") }
											name="lane_ids"
											value={ page.value("preview-reinstate", session.ID, "lane_ids", commaSeparatedIDs(session.LaneIDs)) }
											required
											{ page.Errors.Attributes(OperationFieldID("preview-reinstate", session.ID, "lane_ids"))... }
										/>
										@FieldError(page.Errors, OperationFieldID("preview-reinstate", session.ID, "lane_ids"))
										<label for={ OperationFieldID("preview-reinstate", session.ID, "location_ids") }>Location IDs</label>
										<input
											id={ OperationFieldID("preview-reinstate", session.ID, "location_ids") }
											name="location_ids"
											value={ page.value("preview-reinstate", session.ID, "location_ids", commaSeparatedIDs(session.LocationIDs)) }
											required
											{ page.Errors.Attributes(OperationFieldID("preview-reinstate", session.ID, "location_ids"))... }
										/>
										@FieldError(page.Errors, OperationFieldID("preview-reinstate", session.ID, "location_ids"))
										<button type="submit">Preview Reinstate and reschedule</button>
									</form>
								}
							</article>
						}
					</section>
					if page.TargetPreview != nil {
						<section>
							<h2>Adjust Target Preview</h2>
							<p>
								<span>Current target </span>
								@EventTime(page.TargetPreview.CurrentTarget, page.Event.Timezone, page.Event.EventLocale)
								<span>; proposed target </span>
								@EventTime(page.TargetPreview.ProposedTarget, page.Event.Timezone, page.Event.EventLocale)
								<span>.</span>
							</p>
							@timingEffects(page.TargetPreview.Effects, page.Event)
							if page.TargetPreview.RequiresHardBoundaryConfirmation {
								<p role="alert">Hard Boundary movement requires explicit confirmation.</p>
							}
							<form method="post" action={ operationsPath(page.Event.ID) }>
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="adjust-target"/>
								<input type="hidden" name="session_id" value={ strconv.Itoa(page.PreviewSessionID) }/>
								<input type="hidden" name="expected_live_state_revision" value={ strconv.Itoa(page.PreviewRevision) }/>
								<input type="hidden" name="adjustment" value={ page.Adjustment.String() }/>
								<input type="hidden" name="preview_fingerprint" value={ page.TargetPreview.Fingerprint }/>
								<input type="hidden" name="command_id" value={ page.CommandIDs["adjust-target:"+strconv.Itoa(page.PreviewSessionID)] }/>
								<label for={ OperationFieldID("adjust-target", page.PreviewSessionID, "confirmed") }>
									<input
										id={ OperationFieldID("adjust-target", page.PreviewSessionID, "confirmed") }
										type="checkbox"
										name="confirmed"
										value="true"
										required
										{ page.Errors.Attributes(OperationFieldID("adjust-target", page.PreviewSessionID, "confirmed"))... }
									/>
									I reviewed this preview and confirm Adjust Target.
								</label>
								@FieldError(page.Errors, OperationFieldID("adjust-target", page.PreviewSessionID, "confirmed"))
								if page.TargetPreview.RequiresHardBoundaryConfirmation {
									<label for={ OperationFieldID("adjust-target", page.PreviewSessionID, "hard_boundary_confirmed") }>
										<input
											id={ OperationFieldID("adjust-target", page.PreviewSessionID, "hard_boundary_confirmed") }
											type="checkbox"
											name="hard_boundary_confirmed"
											value="true"
											required
											{ page.Errors.Attributes(OperationFieldID("adjust-target", page.PreviewSessionID, "hard_boundary_confirmed"))... }
										/>
										Confirm Hard Boundary movement
									</label>
									@FieldError(page.Errors, OperationFieldID("adjust-target", page.PreviewSessionID, "hard_boundary_confirmed"))
								}
								<button type="submit">Adjust Target</button>
							</form>
						</section>
					}
					if page.EndPreflight != nil {
						<section>
							<h2>End Competition Preview</h2>
							if page.EndPreflight.RequiresConfirmation {
								<p role="alert">Deferred Entries will become Not Presented and require resolution.</p>
								<ul>
									for _, entry := range page.EndPreflight.DeferredEntries {
										<li>{ entry.Name }</li>
									}
								</ul>
							} else {
								@EmptyState("No deferred Entries.")
							}
							<form method="post" action={ operationsPath(page.Event.ID) }>
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="end-session"/>
								<input type="hidden" name="session_id" value={ strconv.Itoa(page.PreviewSessionID) }/>
								<input type="hidden" name="expected_live_state_revision" value={ strconv.Itoa(page.PreviewRevision) }/>
								<input type="hidden" name="command_id" value={ page.CommandIDs["end-session:"+strconv.Itoa(page.PreviewSessionID)] }/>
								<input type="hidden" name="deferred_entries_fingerprint" value={ page.EndPreflight.Fingerprint }/>
								if page.EndPreflight.RequiresConfirmation {
									<label for={ OperationFieldID("end-session", page.PreviewSessionID, "confirmed_deferred_entries") }>
										<input
											id={ OperationFieldID("end-session", page.PreviewSessionID, "confirmed_deferred_entries") }
											type="checkbox"
											name="confirmed_deferred_entries"
											value="true"
											required
											{ page.Errors.Attributes(OperationFieldID("end-session", page.PreviewSessionID, "confirmed_deferred_entries"))... }
										/>
										Confirm deferred Entries
									</label>
									@FieldError(page.Errors, OperationFieldID("end-session", page.PreviewSessionID, "confirmed_deferred_entries"))
								}
								<button type="submit">End Competition</button>
							</form>
						</section>
					}
					if page.ReinstatePreview != nil {
						<section>
							<h2>Reinstate Session Preview</h2>
							@timingEffects(page.ReinstatePreview.Effects, page.Event)
							if page.ReinstatePreview.RequiresHardBoundaryConfirmation {
								<p role="alert">Hard Boundary movement requires explicit confirmation.</p>
							}
							<form method="post" action={ operationsPath(page.Event.ID) }>
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="reinstate-session"/>
								<input type="hidden" name="session_id" value={ strconv.Itoa(page.PreviewSessionID) }/>
								<input type="hidden" name="expected_live_state_revision" value={ strconv.Itoa(page.PreviewRevision) }/>
								<input type="hidden" name="forecast_start" value={ page.ForecastStart.UTC().Format(time.RFC3339) }/>
								<input type="hidden" name="lane_ids" value={ commaSeparatedIDs(page.LaneIDs) }/>
								<input type="hidden" name="location_ids" value={ commaSeparatedIDs(page.LocationIDs) }/>
								<input type="hidden" name="preview_fingerprint" value={ page.ReinstatePreview.Fingerprint }/>
								<input type="hidden" name="command_id" value={ page.CommandIDs["reinstate-session:"+strconv.Itoa(page.PreviewSessionID)] }/>
								<label for={ OperationFieldID("reinstate-session", page.PreviewSessionID, "confirmed") }>
									<input
										id={ OperationFieldID("reinstate-session", page.PreviewSessionID, "confirmed") }
										type="checkbox"
										name="confirmed"
										value="true"
										required
										{ page.Errors.Attributes(OperationFieldID("reinstate-session", page.PreviewSessionID, "confirmed"))... }
									/>
									I reviewed this placement preview and confirm Reinstate.
								</label>
								@FieldError(page.Errors, OperationFieldID("reinstate-session", page.PreviewSessionID, "confirmed"))
								if page.ReinstatePreview.RequiresHardBoundaryConfirmation {
									<label for={ OperationFieldID("reinstate-session", page.PreviewSessionID, "hard_boundary_confirmed") }>
										<input
											id={ OperationFieldID("reinstate-session", page.PreviewSessionID, "hard_boundary_confirmed") }
											type="checkbox"
											name="hard_boundary_confirmed"
											value="true"
											required
											{ page.Errors.Attributes(OperationFieldID("reinstate-session", page.PreviewSessionID, "hard_boundary_confirmed"))... }
										/>
										Confirm Hard Boundary movement
									</label>
									@FieldError(page.Errors, OperationFieldID("reinstate-session", page.PreviewSessionID, "hard_boundary_confirmed"))
								}
								<button type="submit">Reinstate and reschedule Session</button>
							</form>
						</section>
					}
					<section>
						<h2>Displays</h2>
						if page.CanAdministerDisplays {
							<form class="stack" method="post" action={ operationsPath(page.Event.ID) }>
								<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
								<input type="hidden" name="action" value="enroll-display"/>
								<input type="hidden" name="command_id" value={ page.EnrollmentCommandID }/>
								<label for={ OperationFieldID("enroll-display", 0, "code") }>Enrollment code</label>
								<input
									id={ OperationFieldID("enroll-display", 0, "code") }
									name="code"
									required
									{ page.Errors.Attributes(OperationFieldID("enroll-display", 0, "code"))... }
								/>
								@FieldError(page.Errors, OperationFieldID("enroll-display", 0, "code"))
								<label for={ OperationFieldID("enroll-display", 0, "name") }>Display name</label>
								<input
									id={ OperationFieldID("enroll-display", 0, "name") }
									name="name"
									value={ page.value("enroll-display", 0, "name", "") }
									{ page.Errors.Attributes(OperationFieldID("enroll-display", 0, "name"))... }
								/>
								@FieldError(page.Errors, OperationFieldID("enroll-display", 0, "name"))
								<label for={ OperationFieldID("enroll-display", 0, "display_id") }>Existing Display ID for recovery</label>
								<input
									id={ OperationFieldID("enroll-display", 0, "display_id") }
									name="display_id"
									inputmode="numeric"
									value={ page.value("enroll-display", 0, "display_id", "") }
									{ page.Errors.Attributes(OperationFieldID("enroll-display", 0, "display_id"))... }
								/>
								@FieldError(page.Errors, OperationFieldID("enroll-display", 0, "display_id"))
								<button type="submit">Enroll or recover Display</button>
							</form>
						}
						if !page.DisplaysAvailable {
							<p>Display operations are unavailable while this Event is not active.</p>
						} else if len(page.Displays) == 0 {
							@EmptyState("No enrolled Displays. Enroll one below.")
						} else {
							for _, display := range page.Displays {
								<article data-display-id={ strconv.Itoa(display.ID) }>
									<h3>Display #{ strconv.Itoa(display.ID) } · { display.Name }</h3>
									<p>Delivery: { display.DeliveryState }</p>
									if display.Standby {
										<p>Assignment: Standby</p>
									} else {
										<p>
											Assignment: { display.LocationName } · { display.ViewKey }
											if len(display.DisplayGroupKeys) > 0 {
												<span> · { strings.Join(display.DisplayGroupKeys, ", ") }</span>
											}
										</p>
									}
									<p>
										Applied Event #{ strconv.Itoa(display.AppliedActiveEventID) },
										activation generation <code>{ strconv.Itoa(display.AppliedActivationGeneration) }</code>,
										Published revision <code>{ strconv.Itoa(display.AppliedPublishedRevision) }</code>.
									</p>
									if page.CanAdministerDisplays {
										<form class="stack" method="post" action={ operationsPath(page.Event.ID) }>
											<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
											<input type="hidden" name="action" value="assign-display"/>
											<input type="hidden" name="command_id" value={ page.DisplayCommandIDs[display.ID] }/>
											<input type="hidden" name="display_id" value={ strconv.Itoa(display.ID) }/>
											<label for={ OperationFieldID("assign-display", display.ID, "location_id") }>Location</label>
											<select
												id={ OperationFieldID("assign-display", display.ID, "location_id") }
												name="location_id"
												required
												{ page.Errors.Attributes(OperationFieldID("assign-display", display.ID, "location_id"))... }
											>
												for _, location := range page.Rundown.Locations {
													<option
														value={ strconv.Itoa(location.ID) }
														selected?={ page.value("assign-display", display.ID, "location_id", strconv.Itoa(display.LocationID)) == strconv.Itoa(location.ID) }
													>{ location.Name }</option>
												}
											</select>
											@FieldError(page.Errors, OperationFieldID("assign-display", display.ID, "location_id"))
											<label for={ OperationFieldID("assign-display", display.ID, "view_key") }>View</label>
											<select
												id={ OperationFieldID("assign-display", display.ID, "view_key") }
												name="view_key"
												required
												{ page.Errors.Attributes(OperationFieldID("assign-display", display.ID, "view_key"))... }
											>
												for _, view := range displayviews.Normal() {
													<option value={ view } selected?={ page.value("assign-display", display.ID, "view_key", display.ViewKey) == view }>{ view }</option>
												}
											</select>
											@FieldError(page.Errors, OperationFieldID("assign-display", display.ID, "view_key"))
											<label for={ OperationFieldID("assign-display", display.ID, "display_group_keys") }>Display group keys</label>
											<input
												id={ OperationFieldID("assign-display", display.ID, "display_group_keys") }
												name="display_group_keys"
												value={ page.value("assign-display", display.ID, "display_group_keys", strings.Join(display.DisplayGroupKeys, ", ")) }
												{ page.Errors.Attributes(OperationFieldID("assign-display", display.ID, "display_group_keys"))... }
											/>
											@FieldError(page.Errors, OperationFieldID("assign-display", display.ID, "display_group_keys"))
											<button type="submit">Assign and group Display</button>
										</form>
									}
								</article>
							}
						}
					</section>
				</main>
			</div>
		</body>
	</html>
}

func operationsPath(eventID int) templ.SafeURL {
	return templ.SafeURL("/backstage/events/" + strconv.Itoa(eventID) + "/operations")
}

templ sessionOperationForm(
	page OperationsPage,
	session rundown.CrewSession,
	action string,
	label string,
) {
	<form method="post" action={ operationsPath(page.Event.ID) }>
		<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
		<input type="hidden" name="action" value={ action }/>
		if !strings.HasPrefix(action, "preview-") {
			<input type="hidden" name="command_id" value={ page.CommandIDs[action+":"+strconv.Itoa(session.ID)] }/>
		}
		<input type="hidden" name="session_id" value={ strconv.Itoa(session.ID) }/>
		<input type="hidden" name="expected_live_state_revision" value={ strconv.Itoa(session.LiveStateRevision) }/>
		<button type="submit">{ label }</button>
	</form>
}

templ cancelSessionForm(page OperationsPage, session rundown.CrewSession) {
	<form class="stack" method="post" action={ operationsPath(page.Event.ID) }>
		<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
		<input type="hidden" name="action" value="cancel-session"/>
		<input type="hidden" name="command_id" value={ page.CommandIDs["cancel-session:"+strconv.Itoa(session.ID)] }/>
		<input type="hidden" name="session_id" value={ strconv.Itoa(session.ID) }/>
		<input type="hidden" name="expected_live_state_revision" value={ strconv.Itoa(session.LiveStateRevision) }/>
		<label for={ OperationFieldID("cancel-session", session.ID, "public_cancellation_message") }>Public cancellation message</label>
		<input
			id={ OperationFieldID("cancel-session", session.ID, "public_cancellation_message") }
			name="public_cancellation_message"
			maxlength="10000"
			value={ page.value("cancel-session", session.ID, "public_cancellation_message", "") }
			{ page.Errors.Attributes(OperationFieldID("cancel-session", session.ID, "public_cancellation_message"))... }
		/>
		@FieldError(page.Errors, OperationFieldID("cancel-session", session.ID, "public_cancellation_message"))
		<label for={ OperationFieldID("cancel-session", session.ID, "crew_notes") }>Crew notes</label>
		<textarea
			id={ OperationFieldID("cancel-session", session.ID, "crew_notes") }
			name="crew_notes"
			maxlength="10000"
			{ page.Errors.Attributes(OperationFieldID("cancel-session", session.ID, "crew_notes"))... }
		>{ page.value("cancel-session", session.ID, "crew_notes", "") }</textarea>
		@FieldError(page.Errors, OperationFieldID("cancel-session", session.ID, "crew_notes"))
		<label for={ OperationFieldID("cancel-session", session.ID, "confirmed") }>
			<input
				id={ OperationFieldID("cancel-session", session.ID, "confirmed") }
				type="checkbox"
				name="confirmed"
				value="true"
				required
				{ page.Errors.Attributes(OperationFieldID("cancel-session", session.ID, "confirmed"))... }
			/>
			Confirm cancellation
		</label>
		@FieldError(page.Errors, OperationFieldID("cancel-session", session.ID, "confirmed"))
		<button class="btn-destructive" type="submit">Cancel Session</button>
	</form>
}

templ timingEffects(effects []sessioncontrol.TargetEffect, event events.Event) {
	if len(effects) == 0 {
		<p>No downstream timing changes.</p>
	} else {
		<ul>
			for _, effect := range effects {
				<li>
					Session #{ strconv.Itoa(effect.SessionID) }:
					@EventTime(effect.CurrentForecastStart, event.Timezone, event.EventLocale)
					<span>–</span>
					@EventTime(effect.CurrentForecastEnd, event.Timezone, event.EventLocale)
					<span> becomes </span>
					@EventTime(effect.ProposedForecastStart, event.Timezone, event.EventLocale)
					<span>–</span>
					@EventTime(effect.ProposedForecastEnd, event.Timezone, event.EventLocale)
					<span>.</span>
				</li>
			}
		</ul>
	}
}
