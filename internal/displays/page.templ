package displays

import "time"

templ EnrollmentPage(code string, qrCodeDataURL string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta http-equiv="refresh" content="3"/>
			@standaloneSkipLinkStyle()
			<title>Enroll this Display</title>
		</head>
		<body>
			@skipLink()
			<main id="main-content" tabindex="-1">
				<h1>Enroll this Display</h1>
				<img src={ templ.SafeURL(qrCodeDataURL) } alt="QR code for Display Enrollment" width="320" height="320"/>
				<p>Enrollment code: <strong>{ code }</strong></p>
				<p>Scan the QR code or enter the code on an Administrator device.</p>
			</main>
		</body>
	</html>
}

templ EnrollmentClaimPage(code string, commandID string, buildVersion string, initialName string, displayID string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			@standaloneSkipLinkStyle()
			<style>
				body {
					margin: 0;
					color: #101828;
					background: #fff;
					font: 1rem/1.5 system-ui, sans-serif;
				}
				main {
					box-sizing: border-box;
					max-width: 44rem;
					margin: auto;
					padding: 1rem;
				}
				form,
				label {
					display: grid;
					gap: 0.5rem;
				}
				form {
					gap: 1rem;
				}
				input:not([type="hidden"]),
				button {
					box-sizing: border-box;
					min-width: 2.75rem;
					min-height: 2.75rem;
					font: inherit;
				}
				:focus-visible {
					outline: 0.2rem solid #175cd3;
					outline-offset: 0.15rem;
				}
			</style>
			<title>Claim Display</title>
		</head>
		<body>
			@skipLink()
			<main id="main-content" tabindex="-1">
				<h1>Claim Display</h1>
				<p>Enrollment code: <strong>{ code }</strong></p>
				<form method="post" action="/admin/displays/enroll">
					<input type="hidden" name="code" value={ code }/>
					<input type="hidden" name="command_id" value={ commandID }/>
					<input type="hidden" name="build_version" value={ buildVersion }/>
					<label>Display name <input name="name" value={ initialName } maxlength="200" required/></label>
					<label>Existing Display ID after Sanitized Restore <input type="number" name="display_id" value={ displayID } min="1"/></label>
					<button type="submit">Enroll Display</button>
				</form>
			</main>
		</body>
	</html>
}

templ EnrollmentClaimReloadPage(reloadURL string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta http-equiv="refresh" content={ "0; url=" + reloadURL }/>
			@standaloneSkipLinkStyle()
			<title>Reloading Display claim</title>
		</head>
		<body>
			@skipLink()
			<main id="main-content" tabindex="-1">
				<h1>Beamers was updated</h1>
				<p role="status">Reloading this Display claim with the entered name preserved.</p>
				<p><a href={ templ.SafeURL(reloadURL) }>Continue to the current Display claim page</a></p>
			</main>
		</body>
	</html>
}

templ EnrollmentClaimedPage(display Display) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			@standaloneSkipLinkStyle()
			<title>Display enrolled</title>
		</head>
		<body>
			@skipLink()
			<main id="main-content" tabindex="-1">
				<h1>Display enrolled</h1>
				<p>{ display.Name } is ready.</p>
			</main>
		</body>
	</html>
}

templ DisplayPage(snapshot Snapshot) {
	<!doctype html>
	<html lang="en" data-protocol-version={ snapshot.ProtocolVersion } data-asset-version={ snapshot.AssetVersion }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="stylesheet" href={ StylesheetPath() }/>
			<title>{ displayPageTitle(snapshot) }</title>
		</head>
		<body>
			if snapshot.EmergencyAlert != nil {
				<main class="display-view emergency-alert display-override-replace" data-override-kind="EmergencyAlert">
					<section role="alert" aria-live="assertive">
						<h1>Emergency Alert</h1>
						<p class="display-override-text">{ snapshot.EmergencyAlert.Text }</p>
					</section>
				</main>
			} else if snapshot.UrgentNotice != nil && snapshot.UrgentNotice.Presentation == "Replace" {
				<main class={ displayPageClass(snapshot) + " display-override-replace urgent-notice-replace" } style={ displayThemeStyle(snapshot) } data-override-kind="UrgentNotice">
					<section role="alert" aria-live="assertive">
						<h1>Urgent Notice</h1>
						<p class="display-override-text">{ snapshot.UrgentNotice.Text }</p>
					</section>
				</main>
			} else if snapshot.TechnicalDifficulties != nil {
				<main class={ displayPageClass(snapshot) + " display-override-replace" } style={ displayThemeStyle(snapshot) } data-override-kind="TechnicalDifficulties">
					<section>
						<h1>Technical Difficulties</h1>
						<p class="display-override-text">{ snapshot.TechnicalDifficulties.Text }</p>
					</section>
				</main>
			} else {
				<main class={ displayPageClass(snapshot) } style={ displayThemeStyle(snapshot) } data-layout={ snapshot.Composition.Layout.Key }>
					for _, region := range snapshot.Composition.Layout.Regions {
						@displayRegion(snapshot, region.Name, region.Widget, region.Persistent)
					}
				</main>
			}
			if snapshot.EmergencyAlert == nil && (snapshot.UrgentNotice == nil || snapshot.UrgentNotice.Presentation != "Replace") && snapshot.StageMessage != nil {
				<aside class="stage-message" role="status" aria-live="assertive" data-stage-message data-emphasis={ snapshot.StageMessage.Emphasis }>
					<strong>{ stageMessageLabel(snapshot.StageMessage.Emphasis) }</strong>
					<p>{ snapshot.StageMessage.Text }</p>
				</aside>
			}
			if snapshot.EmergencyAlert == nil && snapshot.UrgentNotice != nil && snapshot.UrgentNotice.Presentation == "Overlay" {
				<aside class="urgent-notice-overlay" role="alert" aria-live="assertive" data-urgent-notice>
					<strong>Urgent Notice:</strong>
					<p>{ snapshot.UrgentNotice.Text }</p>
				</aside>
			}
			@displayClient()
		</body>
	</html>
}

templ displayRegion(snapshot Snapshot, name string, widget string, persistent bool) {
	<section
		class="display-region"
		data-region={ name }
		data-widget={ widget }
		data-persistent={ displayPersistent(persistent) }
		{ displayRegionAttributes(snapshot, widget)... }
	>
		if widget == "branding" {
			if snapshot.Standby {
				<p>{ displayBranding(snapshot) }</p>
			} else {
				<h1>{ displayBranding(snapshot) }</h1>
				if snapshot.ViewKey == "event-overview" {
					<p>Event Overview</p>
					<p>Location: { snapshot.LocationName }</p>
				}
			}
		} else if widget == "standby" {
			<h1>Standby</h1>
			<p>Display: { snapshot.Display.Name }</p>
			if snapshot.EventName != "" {
				<p>Active Event: { snapshot.EventName }</p>
			}
			<p>This Display has no Assignment for the Active Event.</p>
		} else if widget == "location" {
			<h1>{ snapshot.LocationName }</h1>
			<p>Location Signage</p>
		} else if widget == "now-next" {
			<h2>Now / Next</h2>
			for index, session := range displayNowNext(snapshot.Sessions, snapshot.ServerTime) {
				if index < 2 {
					@displaySessionRegion(snapshot, session, false, false, displayNowNextSlot(index))
				}
			}
		} else if widget == "rotation" {
			for index, session := range snapshot.Sessions {
				@displaySessionRegion(snapshot, session, true, index > 0, "rotation")
			}
			if len(snapshot.Sessions) == 0 {
				<p>No public Event information is currently scheduled.</p>
			}
		} else if widget == "timeline" {
			<div class="display-timeline-days">
				for _, day := range displayTimelineDays(snapshot.Sessions) {
					<section class="display-timeline-day">
						<h3>{ day.Label }</h3>
						<ol class="display-timeline" style={ displayTimelineDayStyle(day) }>
							for _, lane := range displayTimelineLaneLabels(day) {
								<li class="display-timeline-lane-label" style={ displayTimelineLaneStyle(lane) } aria-hidden="true">{ displayTimelineLaneLabel(lane) }</li>
							}
							for _, gridline := range day.Gridlines {
								<li class="display-timeline-gridline" style={ displayTimelineGridlineStyle(gridline) } aria-hidden="true"><span>{ gridline.Label }</span></li>
							}
							if day.NowOffset != nil {
								<li class="display-timeline-now" style={ displayTimelineNowStyle(day) } aria-hidden="true"></li>
							}
							for _, session := range day.Sessions {
								@displayTimelineBlock(snapshot, session)
							}
						</ol>
					</section>
				}
			</div>
			if len(snapshot.Sessions) == 0 {
				<p>No public Event information is currently scheduled.</p>
			}
		} else if widget == "clock" {
			<time data-display-clock datetime={ snapshot.ServerTime.Format("2006-01-02T15:04:05Z07:00") }>{ displayClockTime(snapshot) }</time>
		} else if widget == "stage-timer" {
			if timer, ok := displayStageTimer(snapshot); ok {
				<h2>{ timer.Title }</h2>
				<p data-timer-direction>{ timer.Direction }</p>
				<time data-stage-timer-clock datetime={ timer.Anchor.Format("2006-01-02T15:04:05Z07:00") }>{ timer.Text }</time>
				<p data-timer-emphasis-label>{ timer.EmphasisLabel }</p>
				if timer.AdjustmentNotice != "" && snapshot.ServerTime.Before(timer.AdjustmentNoticeExpiresAt) {
					<p data-timer-adjustment-notice data-expires-at={ timer.AdjustmentNoticeExpiresAt.Format("2006-01-02T15:04:05Z07:00") }>{ timer.AdjustmentNotice }</p>
				}
				if !timer.ForecastEnd.IsZero() {
					<p>Forecast End: <time datetime={ timer.ForecastEnd.Format("2006-01-02T15:04:05Z07:00") }>{ timer.DisplayForecastEnd }</time></p>
				}
				@displayProgressBar(timer.SpanStart, timer.SpanEnd, snapshot.ServerTime)
			} else {
				<h2>Stage Timer</h2>
				<p>No Session is live at this Location.</p>
			}
		} else if widget == "program-output" {
			if snapshot.ProgramOutput != nil {
				<h2>{ snapshot.ProgramOutput.Title }</h2>
				<p>{ snapshot.ProgramOutput.Kind }</p>
			} else {
				<h2>Standby</h2>
			}
		}
	</section>
}

templ displayTimelineBlock(snapshot Snapshot, session Session) {
	<li class="display-timeline-block" style={ displayTimelineStyle(session) } data-unavailable?={ session.Unavailable } data-lifecycle={ session.Lifecycle }>
		if session.Unavailable {
			<p>{ session.AvailabilityMessage }</p>
		} else {
			<h3>{ session.Title }</h3>
			if displayLifecycleBadge(session) {
				<span class="display-badge" data-lifecycle={ session.Lifecycle }>{ session.Lifecycle }</span>
			}
			<p>
				<time datetime={ session.PresentedStart.Format("2006-01-02T15:04:05Z07:00") }>{ session.DisplayPresentedStart }</time>
			</p>
		}
	</li>
}

templ displayProgressBar(start, end, now time.Time) {
	if displayProgressMeasurable(start, end) {
		<div
			class="display-progress"
			style={ displayProgressStyle(start, end, now) }
			data-progress-start={ start.Format("2006-01-02T15:04:05Z07:00") }
			data-progress-end={ end.Format("2006-01-02T15:04:05Z07:00") }
			role="progressbar"
			aria-label="Elapsed"
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuenow={ displayProgressPercent(start, end, now) }
		></div>
	}
}

templ displaySessionRegion(
	snapshot Snapshot,
	session Session,
	rotationPage bool,
	collapsed bool,
	slot string,
) {
	<article data-rotation-page?={ rotationPage } hidden?={ collapsed } data-slot={ slot } data-lifecycle={ session.Lifecycle } data-session-id={ displaySessionID(session) }>
		if session.Unavailable {
			<p>{ session.AvailabilityMessage }</p>
		} else {
			if slot == "now" || slot == "next" {
				<p class="display-kicker">{ displaySessionKicker(session) }</p>
			}
			<h3>{ session.Title }</h3>
			if displayLifecycleBadge(session) {
				<span class="display-badge" data-lifecycle={ session.Lifecycle }>{ session.Lifecycle }</span>
			}
			<p>Status: { session.Lifecycle }</p>
			<dl class="display-times">
				<dt>{ string(session.PresentedStartLabel) }:</dt>
				<dd><time datetime={ session.PresentedStart.Format("2006-01-02T15:04:05Z07:00") }>{ session.DisplayPresentedStart }</time></dd>
				<dt>{ string(session.PresentedEndLabel) }:</dt>
				<dd><time datetime={ session.PresentedEnd.Format("2006-01-02T15:04:05Z07:00") }>{ session.DisplayPresentedEnd }</time></dd>
			</dl>
			if session.Speaker != "" {
				<p>{ session.Speaker }</p>
			}
			if session.PublicDetails != "" {
				<p>{ session.PublicDetails }</p>
			}
			if slot == "now" && session.Lifecycle == "Live" {
				@displayProgressBar(session.PresentedStart, session.PresentedEnd, snapshot.ServerTime)
			}
		}
	</article>
}

templ displayClient() {
	<p id="display-connection" role="status" aria-live="polite" data-connection="connecting">Connecting…</p>
	<script src={ ClientJavaScriptPath() } defer></script>
}

templ skipLink() {
	<a class="skip-link" href="#main-content">Skip to main content</a>
}

templ standaloneSkipLinkStyle() {
	<style>
		.skip-link {
			background: Canvas;
			color: CanvasText;
			inset-block-start: 0.5rem;
			inset-inline-start: 0.5rem;
			padding: 0.55rem 0.9rem;
			position: fixed;
			transform: translateY(-200%);
			z-index: 10;
		}
		.skip-link:focus {
			transform: none;
		}
	</style>
}
