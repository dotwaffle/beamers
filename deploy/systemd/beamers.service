[Unit]
Description=Beamers venue operations
Documentation=https://github.com/dotwaffle/beamers
After=network.target
ConditionPathExists=/var/lib/beamers/data/beamers.db
RequiresMountsFor=/var/lib/beamers /etc/beamers

[Service]
Type=simple
User=beamers
Group=beamers
UMask=0077
ExecStart=/usr/local/bin/beamers serve --data-dir=/var/lib/beamers/data --attachments-dir=/var/lib/beamers/attachments --listen=0.0.0.0:8443 --tls-cert=/etc/beamers/tls.crt --tls-key=/etc/beamers/tls.key --shutdown-timeout=10s
KillSignal=SIGTERM
TimeoutStopSec=10s
Restart=on-failure
RestartSec=2s
StateDirectory=beamers
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
